<view class="page events-page">
  <view class="safe-top"></view>
  <view class="topbar">
    <view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s13-imgFrame.svg"/></view>
    <view class="top-title"><view class="top-title-main">我的事件</view><view class="top-title-sub">{{events.length}} 条记录</view></view>
  </view>
  <view class="mode-tabs"><view class="mode-tab {{tab==='pending'?'active':''}}" data-tab="pending" bindtap="setTab"><text>待复查</text><text class="tab-count">{{pendingEvents.length}}</text></view><view class="mode-tab {{tab==='all'?'active':''}}" data-tab="all" bindtap="setTab"><text>全部记录</text><text class="tab-count">{{allEvents.length}}</text></view></view>
  <view class="search-field"><image class="figma-icon sm" src="/assets/figma/all/s13-imgFrame1.svg"/><input class="search-input" value="{{query}}" bindinput="onSearch" placeholder="搜索时间、类型或地点"/><text class="filter-entry" bindtap="chooseFilter">{{filterLabel}}</text></view>
  <view class="section-title">{{listTitle}}</view>
  <block wx:if="{{visibleEvents.length}}"><view wx:for="{{visibleEvents}}" wx:key="id" class="card event-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="circle circle-amber event-icon"><image class="event-symbol" src="{{item.icon}}"/></view><view class="grow event-main"><view class="event-title">{{item.type}}</view><view class="tiny">{{item.eventMeta}}</view></view><view class="level-pill {{item.statusClass}}">{{item.statusText}}</view></view><block wx:if="{{tab==='pending'}}"><view class="event-symptoms">{{item.detailText}}</view><view class="between event-foot"><view class="review-pill">{{item.footerText}}</view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view></block></view></block>
  <view class="empty-card" wx:else><view class="empty-title">{{emptyTitle}}</view><view class="tiny">{{emptyDetail}}</view></view>
  <view class="sync-card {{syncState==='error'?'sync-card-error':''}}" bindtap="syncAll"><image wx:if="{{syncState==='success'}}" class="sync-icon" src="/assets/figma/all/s13-img4.svg"/><image wx:elif="{{syncState==='error'}}" class="sync-icon" src="/assets/sync-error.svg"/><image wx:else class="sync-icon" src="/assets/sync-pending.svg"/><view class="grow sync-copy"><view class="{{syncState==='error'?'sync-error-text':''}}">{{syncText}}</view><view class="tiny sync-detail">{{syncDetail}}</view></view><text class="tiny sync-action">{{syncing?'同步中':syncState==='error'?'重试同步':'手动同步'}}</text></view>
  <button class="primary-btn create-button" bindtap="create">＋ 新建安全判断</button>
</view>
