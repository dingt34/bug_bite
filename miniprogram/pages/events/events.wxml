<view class="page"><view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s13-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">我的事件</view><view class="top-title-sub">{{events.length}} 条记录</view></view><view class="figma-menu"><image src="/assets/figma/all/s13-imgEllipse1.svg"/><image src="/assets/figma/all/s13-imgEllipse1.svg"/><image src="/assets/figma/all/s13-imgEllipse1.svg"/></view></view>
<view class="mode-tabs"><view wx:for="{{tabs}}" wx:key="*this" class="mode-tab {{tab===item?'active':''}}" data-tab="{{item}}" bindtap="setTab">{{item}} {{index===0?'1':events.length}}</view></view><view class="field" style="margin-top:32rpx"><image class="figma-icon sm" src="/assets/figma/all/s13-imgFrame1.svg"/><text class="muted">搜索时间、类型或地点</text><text class="muted" style="margin-left:auto">筛选</text></view>
<view class="section-title">需要复查</view><view wx:for="{{events}}" wx:key="id" wx:if="{{item.status==='待复查'}}" class="card event-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="circle circle-amber event-icon"><image class="figma-icon md" src="/assets/figma/all/s13-img3.svg"/></view><view class="grow" style="margin-left:22rpx"><view class="h3">{{item.type}}</view><view class="tiny">{{item.createdAt}} · {{item.body}} · {{item.place}}</view></view><view class="chip danger-active">{{item.level}}</view></view><view class="muted" style="margin-top:26rpx">{{item.symptomsText}} · {{item.trend}}</view><view class="between" style="margin-top:20rpx"><view class="mini-btn">{{item.reviewAt}} 进行复查</view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view></view>
<view class="section-title">历史记录</view><view wx:for="{{events}}" wx:key="id" wx:if="{{item.status!=='待复查'}}" class="field" data-id="{{item.id}}" bindtap="open"><view class="circle circle-red" style="width:72rpx;height:72rpx"><image class="figma-icon md" src="{{index%2?'/assets/figma/all/s13-img1.svg':'/assets/figma/all/s13-img2.svg'}}"/></view><view class="grow" style="margin-left:22rpx"><view>{{item.type}}</view><view class="tiny">{{item.createdAt}} · {{item.body}} · {{item.trend}}</view></view><view class="chip">{{item.level}}</view></view>
<view class="notice" style="margin-top:38rpx;color:#2f7d5b">✓　所有记录已同步 <text class="muted" style="margin-left:auto">手动同步</text></view><button class="primary-btn" style="margin-top:38rpx" bindtap="create">＋ 新建安全判断</button></view>
