.events-page{padding-bottom:52rpx}.mode-tabs{display:grid;grid-template-columns:1fr 1fr;background:#f0f1f3;border-radius:44rpx;margin-top:20rpx;padding:6rpx}.mode-tab{height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:38rpx;color:#7f8582;font-size:var(--font-body);font-weight:600}.mode-tab.active{background:#fff;color:#2f875f;box-shadow:0 8rpx 22rpx rgba(20,23,31,.05)}.search-field{height:96rpx;margin-top:38rpx;padding:0 30rpx;background:#fff;border:1rpx solid #e6e7ec;border-radius:36rpx;display:flex;align-items:center;box-shadow:0 14rpx 40rpx rgba(20,23,31,.07)}.search-input{flex:1;height:100%;margin-left:20rpx;font-size:var(--font-caption);color:#1e2021}.filter-entry{padding:20rpx 0 20rpx 20rpx;color:#8c8f96;font-size:var(--font-caption)}.event-card{padding:36rpx 28rpx;margin-bottom:24rpx}.event-icon{width:88rpx;height:88rpx}.event-symbol{width:52rpx;height:52rpx}.event-main{margin-left:28rpx}.event-title{font-size:var(--font-section-title);line-height:1.3;font-weight:700}.event-title.small{font-size:var(--font-card-title);font-weight:600}.event-symptoms{margin-top:28rpx;color:#8c8f96;font-size:var(--font-caption)}.event-foot{margin-top:22rpx}.review-pill{padding:12rpx 28rpx;background:#f1f2f5;border-radius:28rpx;color:#8c8f96;font-size:var(--font-caption)}.level-pill{padding:12rpx 22rpx;border-radius:28rpx;font-size:var(--font-caption);white-space:nowrap}.level-observe{background:#f2d6aa;color:#8c6b35}.level-consult{background:#fbe6e2;color:#c46255}.level-emergency{background:#f9d7d3;color:#df4138}.history-card{min-height:158rpx;margin-bottom:24rpx;padding:28rpx;background:#fff;border:1rpx solid #e6e7ec;border-radius:44rpx;display:flex;align-items:center;box-shadow:0 14rpx 38rpx rgba(20,23,31,.06)}.history-icon{width:88rpx;height:88rpx;background:#fbe6e2}.sync-card{min-height:124rpx;margin-top:38rpx;padding:24rpx 28rpx;background:#fff;border:1rpx solid #e6e7ec;border-radius:40rpx;display:flex;align-items:center;gap:24rpx;box-shadow:0 12rpx 32rpx rgba(20,23,31,.05)}.sync-icon{width:64rpx;height:64rpx}.create-button{margin-top:38rpx}.empty-card,.empty-history{padding:34rpx;background:#fff;border-radius:36rpx;color:#8c8f96;text-align:center}.empty-title{margin-bottom:8rpx;color:#1e2021;font-weight:600}

.mode-tab{gap:12rpx}.tab-count{width:42rpx;height:42rpx;border:2rpx solid #8c8f96;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#8c8f96;font-size:var(--font-caption);font-weight:700;line-height:1}.mode-tab.active .tab-count{border-color:#2f875f;background:#e8f5ee;color:#2f875f}.review-urgent{background:#fff0ee;color:#df4138;border:2rpx solid #ea655d;font-weight:700}.level-consult{background:#ffd84d;color:#111}

.sync-card-error{border-color:#f2c2bd;background:#fffafa}.sync-error-text{color:#d93f37;font-weight:600}.sync-copy{min-width:0}.sync-detail{margin-top:6rpx;line-height:1.5}.sync-action{flex:none;color:#65716b}

.review-waiting{background:#e8f5ee;color:#2f875f;border:2rpx solid #75aa91}.review-soon{background:#fff4ce;color:#705400;border:2rpx solid #e8c859}.review-overdue{background:#fff0ee;color:#df4138;border:2rpx solid #ea655d;font-weight:700}

/* 事件状态统一为固定尺寸胶囊，避免待复查与尽快咨询错位。 */
.event-main{margin-right:16rpx}
.level-pill{width:168rpx;height:58rpx;padding:0 16rpx;border:2rpx solid transparent;border-radius:29rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:none;font-size:var(--font-caption);line-height:1;text-align:center;white-space:nowrap}
.level-consult{background:#ffd84d;color:#111;border-color:#e1b900;font-weight:700}

/* 空状态与筛选栏保留呼吸感，避免内容紧贴搜索框。 */
.empty-card{margin-top:48rpx}
