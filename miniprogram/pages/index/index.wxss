.page {
  padding-bottom: 160rpx;
  background: #F5F6F7;
}

/* 顶部横幅 */
.hero {
  position: relative;
  background: linear-gradient(150deg, #1F5C42 0%, #2E7D5B 42%, #3F9D76 74%, #55B58E 100%);
  color: #fff;
  padding: 64rpx 40rpx 76rpx;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}
.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
}
.glow-1 {
  width: 260rpx;
  height: 260rpx;
  top: -90rpx;
  right: -60rpx;
}
.glow-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: 30rpx;
  right: 150rpx;
  background: rgba(255, 255, 255, 0.07);
}
.glow-3 {
  width: 90rpx;
  height: 90rpx;
  top: 150rpx;
  left: -30rpx;
  background: rgba(255, 255, 255, 0.06);
}
.hero-bug {
  position: absolute;
  right: -16rpx;
  bottom: -40rpx;
  font-size: 240rpx;
  line-height: 1;
  opacity: 0.14;
  transform: rotate(-18deg);
}
.hero-title {
  position: relative;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.hero-sub {
  position: relative;
  font-size: 27rpx;
  opacity: 0.92;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}
.hero-scope {
  position: relative;
  display: inline-block;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.20);
  padding: 8rpx 24rpx;
  border-radius: 26rpx;
  margin-top: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

/* 非诊断提示 */
.notice {
  position: relative;
  display: flex;
  align-items: flex-start;
  background: #FFF8E1;
  color: #7A5C00;
  font-size: 24rpx;
  padding: 22rpx 30rpx;
  margin: -36rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  border-left: 6rpx solid #F5B400;
}
.notice-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}
.notice-text {
  flex: 1;
  line-height: 1.5;
}

/* 功能区标题 */
.funcs-head {
  display: flex;
  align-items: baseline;
  margin: 40rpx 28rpx 20rpx;
}
.funcs-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2B3330;
}
.funcs-sub {
  font-size: 24rpx;
  color: #A0A8A5;
  margin-left: 16rpx;
}

/* 功能卡片 */
.func-entry {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}
.func-entry-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.func-icon {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 58rpx;
  border-radius: 28rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #F0F6F3;
}
.ai-entry {
  border: 1rpx solid #D8E9E1;
  background: linear-gradient(135deg, #FFFFFF, #F4FAF7);
}
.ai-icon {
  background: linear-gradient(135deg, #E3F3EB, #FFF4D8);
}
.func-body {
  flex: 1;
}
.func-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B3330;
}
.func-desc {
  font-size: 24rpx;
  color: #8A9299;
  margin-top: 8rpx;
  line-height: 1.4;
}
.func-tags {
  display: flex;
  margin-top: 14rpx;
}
.func-tag {
  font-size: 20rpx;
  color: #2E7D5B;
  background: #E8F3EE;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}
.func-arrow {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: #2E7D5B;
  background: #EAF3EF;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7C0C7;
  padding: 30rpx 60rpx;
}
