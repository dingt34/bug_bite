.species-hero{height:480rpx;border-radius:48rpx;background:#eef2e8;position:relative;padding:32rpx;overflow:hidden}
.species-hero-bg{position:absolute;inset:0;width:100%;height:100%}
/* 照片上加渐变，保证名称读得清 */
.hero-shade{position:absolute;left:0;right:0;bottom:0;height:240rpx;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.64) 100%)}
.species-hero .chip{position:relative;z-index:2;display:inline-flex;background:rgba(255,255,255,.92)}
.species-name{position:absolute;left:32rpx;bottom:50rpx;z-index:2}
.hero-text{color:#fff}
.photo-credit{position:absolute;right:28rpx;bottom:16rpx;z-index:2;color:rgba(255,255,255,.7);font-size:var(--font-micro)}
.detail-actions{display:grid;grid-template-columns:1fr 1.6fr;gap:20rpx;margin-top:46rpx}

.prose{line-height:1.72;color:#4e574f;font-size:var(--font-body)}
.species-identity{margin-top:24rpx;padding:30rpx 32rpx;border-radius:36rpx;background:#fff;box-shadow:0 12rpx 32rpx rgba(31,42,37,.06)}.identity-type{display:inline-flex;margin-bottom:14rpx;padding:7rpx 14rpx;border-radius:20rpx;background:#e5f0e9;color:#2f7d5b;font-size:var(--font-caption);font-weight:600}.species-latin{margin-top:6rpx;color:#6f7b74;font-size:var(--font-caption);font-style:italic}.identity-summary{margin-top:18rpx;color:#57645d;font-size:var(--font-body);line-height:1.7}.species-gallery{height:520rpx;margin-top:24rpx;border-radius:40rpx;background:#e8eeea;overflow:hidden}.gallery-slide{position:relative;width:100%;height:100%}.gallery-image{width:100%;height:100%}.gallery-caption{position:absolute;left:0;right:0;bottom:0;padding:58rpx 26rpx 24rpx;background:linear-gradient(180deg,transparent,rgba(15,25,20,.76));color:#fff;font-size:var(--font-caption);line-height:1.45}.gallery-credit{margin-top:6rpx;color:rgba(255,255,255,.68);font-size:var(--font-micro)}.media-pending{margin-top:14rpx;padding:18rpx 22rpx;border-radius:22rpx;background:#fff5e4;color:#8b651f;font-size:var(--font-caption);line-height:1.6}.science-card{border-radius:32rpx}.science-label{color:#24372d;font-size:var(--font-body);font-weight:700}.science-label-spaced{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid #edf0ee}.evidence-row,.action-row,.source-row{display:flex;align-items:flex-start;margin-top:15rpx;color:#4e5b54;font-size:var(--font-body);line-height:1.55}.evidence-dot{width:12rpx;height:12rpx;flex:none;margin:13rpx 16rpx 0 0;border-radius:50%;background:#4b9673}.action-row:first-child,.source-row:first-child{margin-top:0}.action-index,.source-mark{display:flex;flex:none;align-items:center;justify-content:center;width:40rpx;height:40rpx;margin-right:16rpx;border-radius:50%;background:#e2eee6;color:#2f7d5b;font-size:var(--font-caption);font-weight:700}.source-row{font-size:var(--font-caption)}.source-card{border-radius:32rpx}

/* 关键特征：不论描述长短，三行结构完全一致 */
.feature-row{display:flex;align-items:flex-start;background:#fff;border-radius:34rpx;padding:26rpx 28rpx;box-shadow:0 10rpx 30rpx rgba(31,42,37,.06)}
.feature-no{width:52rpx;height:52rpx;flex:none;font-size:var(--font-body);font-weight:700}
.feature-body{flex:1;min-width:0;margin-left:22rpx}
.feature-title{font-size:var(--font-card-title);font-weight:700;line-height:1.4}
.feature-desc{margin-top:8rpx;color:#8c8f96;font-size:var(--font-body);line-height:1.6}
/* доод зайг багасгах */
.page{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}

/* 返回按钮：白底圆形 + 柔和阴影，与参考图一致 */
.back{box-shadow:0 6rpx 20rpx rgba(31,42,37,.10)}
