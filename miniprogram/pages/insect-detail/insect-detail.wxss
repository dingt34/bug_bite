.page { padding-bottom: 160rpx; }
.hero {
  padding: 38rpx 32rpx 56rpx;
  color: #FFFFFF;
}
.hero-copy { width: 100%; }
.hero-name { font-size: 46rpx; font-weight: 700; }
.hero-scientific { margin-top: 4rpx; font-family: Georgia, 'Times New Roman', serif; font-size: 25rpx; font-style: italic; opacity: 0.9; }
.hero-tags { display: flex; margin-top: 16rpx; }
.hero-tags text { margin-right: 12rpx; padding: 6rpx 16rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 20rpx; background: rgba(255,255,255,.14); font-size: 20rpx; }
.hero-alias { margin-top: 8rpx; font-size: 20rpx; opacity: 0.82; }
.gallery-card { position: relative; margin: -34rpx 24rpx 0; overflow: hidden; border-radius: 26rpx; background: #FFFFFF; box-shadow: 0 10rpx 30rpx rgba(28, 57, 43, 0.14); }
.gallery { height: 430rpx; background: #E8EEEB; }
.gallery-slide { position: relative; width: 100%; height: 100%; }
.gallery-image { width: 100%; height: 100%; display: block; }
.zoom-hint { position: absolute; top: 18rpx; right: 18rpx; padding: 7rpx 14rpx; border-radius: 18rpx; background: rgba(20, 34, 27, .68); color: #FFFFFF; font-size: 18rpx; }
.gallery-meta { display: flex; align-items: flex-start; min-height: 82rpx; padding: 18rpx 22rpx; box-sizing: border-box; }
.gallery-index { flex-shrink: 0; margin-right: 16rpx; padding: 5rpx 12rpx; border-radius: 16rpx; background: var(--primary-light); color: var(--primary); font-size: 19rpx; }
.gallery-caption { flex: 1; color: #53615A; font-size: 22rpx; line-height: 1.45; }
.boundary-note {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  color: #7A5C00;
  font-size: 22rpx;
  line-height: 1.5;
}
.summary { color: #3C4842; font-size: 27rpx; line-height: 1.65; }
.key-list { display: flex; flex-wrap: wrap; margin: 16rpx 0 4rpx; }
.key-chip { margin: 0 10rpx 10rpx 0; padding: 8rpx 16rpx; border-radius: 18rpx; background: #EEF6F2; color: #3F765D; font-size: 20rpx; }
.fact-row { display: flex; padding: 20rpx 0; border-bottom: 1rpx solid #EEF1EF; }
.fact-row:last-child { border-bottom: none; }
.fact-label { width: 130rpx; flex-shrink: 0; color: var(--primary); font-size: 23rpx; font-weight: 600; }
.fact-value { flex: 1; color: #5D6863; font-size: 24rpx; line-height: 1.55; }
.detail-block { padding: 18rpx 20rpx; border-radius: 16rpx; background: #F5F8F6; }
.clue-block { margin-top: 14rpx; background: #EFF6F2; }
.detail-label { color: #56645D; font-size: 23rpx; font-weight: 600; }
.detail-text { margin-top: 6rpx; color: #68746E; font-size: 23rpx; line-height: 1.55; }
.caution { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #FFF8E1; color: #7A5C00; font-size: 22rpx; line-height: 1.5; }
.action-item { display: flex; align-items: flex-start; margin-bottom: 18rpx; }
.action-num { width: 42rpx; height: 42rpx; flex-shrink: 0; border-radius: 50%; background: var(--primary); color: #FFFFFF; font-size: 22rpx; line-height: 42rpx; text-align: center; }
.action-text { flex: 1; margin-left: 16rpx; color: #4F5B55; font-size: 24rpx; line-height: 1.55; }
.danger-card { border: 2rpx solid #F0CECA; }
.danger-title { color: var(--danger); }
.danger-item { margin-top: 12rpx; color: #6E5552; font-size: 23rpx; line-height: 1.5; }
.danger-item text { margin-right: 12rpx; color: var(--danger); }
.danger-button { margin-top: 22rpx; border-radius: 38rpx; background: var(--danger); color: #FFFFFF; font-size: 25rpx; }
.danger-button::after { border: none; }
.confused-row { display: flex; flex-wrap: wrap; }
.confused-chip { margin: 0 12rpx 10rpx 0; padding: 8rpx 18rpx; border-radius: 22rpx; background: var(--primary-light); color: var(--primary); font-size: 22rpx; }
.source-item { display: flex; align-items: center; padding: 17rpx 0; border-bottom: 1rpx solid #EDF1EF; }
.source-title { flex: 1; color: #4F5B55; font-size: 22rpx; }
.source-copy { margin-left: 16rpx; color: var(--primary); font-size: 21rpx; }
.source-note { margin-top: 14rpx; color: #929C97; font-size: 20rpx; line-height: 1.45; }
.photo-credit { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #EDF1EF; }
.credit-thumb { width: 82rpx; height: 64rpx; flex-shrink: 0; border-radius: 12rpx; background: #EEF2F0; }
.credit-copy { flex: 1; min-width: 0; margin-left: 14rpx; }
.credit-caption { overflow: hidden; color: #4F5B55; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.credit-meta { margin-top: 4rpx; overflow: hidden; color: #929C97; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; gap: 18rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #E4E8E6; background: rgba(255, 255, 255, 0.97); }
.action-button { flex: 1; margin: 0; font-size: 26rpx; line-height: 1.45; }
