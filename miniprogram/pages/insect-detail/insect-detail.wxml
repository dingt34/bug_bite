<view class="page">
  <view class="safe-top"></view>

  <view class="topbar">
    <view class="back" bindtap="back">
      <image class="figma-back" src="/assets/figma/all/s19-imgFrame.svg"/>
    </view>
    <view class="top-title-main top-title">虫种详情</view>
    <view class="top-action" bindtap="openCompare">查看对比</view>
  </view>

  <view class="species-hero">
    <image class="species-hero-bg" src="{{photo}}" mode="aspectFill"/>
    <view class="hero-shade"></view>
    <view class="chip">疑似候选</view>
    <view class="species-name">
      <view class="h2 hero-text">{{name}}</view>
      <view class="tiny hero-text">{{latin}} · {{typeLabel}}参考</view>
    </view>
    <view class="photo-credit">图片：{{photoCredit}}</view>
  </view>

  <view class="notice" style="margin-top:28rpx;text-align:center;justify-content:center">外形和环境信息仅供对照，不构成虫种确诊</view>

  <view class="section-title">关键特征</view>
  <view class="stack gap-12">
    <view wx:for="{{features}}" wx:key="n" class="field">
      <view class="circle circle-green" style="width:56rpx;height:56rpx">{{item.n}}</view>
      <view class="grow" style="margin-left:22rpx">{{item.t}}</view>
      <text class="muted">{{item.d}}</text>
    </view>
  </view>

  <view class="section-title">常见环境</view>
  <view class="chip-row">
    <view wx:for="{{environments}}" wx:key="name" class="chip {{item.active ? 'active' : ''}}">{{item.name}}</view>
  </view>

  <view class="detail-actions">
    <button class="secondary-btn" bindtap="compare">{{inCompare ? '移出对比' : '加入对比'}}</button>
    <button class="primary-btn" bindtap="danger">发生接触，安全判断</button>
  </view>

  <view class="safe-note" style="margin-top:24rpx">{{detailNote}}</view>
</view>
