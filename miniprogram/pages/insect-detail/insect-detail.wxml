<view class="page" wx:if="{{item}}">
  <view class="hero" style="background: {{item.accent}};">
    <view class="hero-copy">
      <view class="hero-name">{{item.name}}</view>
      <view class="hero-scientific">{{item.scientificName}}</view>
      <view class="hero-tags"><text>{{item.commonCategory}}</text><text>{{item.groupName}}</text></view>
      <view class="hero-alias">别名：{{item.aliasText}}</view>
    </view>
  </view>

  <view class="gallery-card">
    <swiper class="gallery" current="{{activeImageIndex}}" indicator-dots="true" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#FFFFFF" bindchange="onGalleryChange">
      <swiper-item wx:for="{{item.images}}" wx:key="src" wx:for-item="photo">
        <view class="gallery-slide" bindtap="previewImage" data-index="{{index}}">
          <image class="gallery-image" src="{{photo.src}}" mode="aspectFill" aria-label="{{photo.alt}}" />
          <view class="zoom-hint">点击查看原图</view>
        </view>
      </swiper-item>
    </swiper>
    <view class="gallery-meta">
      <view class="gallery-index">{{activeImageIndex + 1}} / {{item.images.length}}</view>
      <view class="gallery-caption">{{activePhoto.caption}}</view>
    </view>
  </view>

  <view class="boundary-note">照片展示的是该物种的典型个体；性别、龄期和拍摄角度会改变外观，不能只根据皮损或一张照片下结论。</view>

  <view class="card">
    <view class="card-title">快速认识</view>
    <view class="summary">{{item.summary}}</view>
    <view class="key-list">
      <view class="key-chip" wx:for="{{item.identificationKeys}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="fact-row"><view class="fact-label">外形线索</view><view class="fact-value">{{item.appearance}}</view></view>
    <view class="fact-row"><view class="fact-label">分布概况</view><view class="fact-value">{{item.distribution}}</view></view>
    <view class="fact-row"><view class="fact-label">常见环境</view><view class="fact-value">{{item.habitat}}</view></view>
    <view class="fact-row"><view class="fact-label">接触方式</view><view class="fact-value">{{item.contactPattern}}</view></view>
  </view>

  <view class="card">
    <view class="card-title">常见表现与对比线索</view>
    <view class="detail-block"><view class="detail-label">可能出现</view><view class="detail-text">{{item.commonReaction}}</view></view>
    <view class="detail-block clue-block"><view class="detail-label">对比时关注</view><view class="detail-text">{{item.compareClues}}</view></view>
    <view class="caution">判断边界：{{item.caution}}</view>
  </view>

  <view class="card">
    <view class="card-title">接触后的基础行动</view>
    <view class="action-item" wx:for="{{item.firstActions}}" wx:key="*this"><view class="action-num">{{index + 1}}</view><view class="action-text">{{item}}</view></view>
  </view>

  <view class="card danger-card">
    <view class="card-title danger-title">出现以下情况立即求助</view>
    <view class="danger-item" wx:for="{{item.urgentSignals}}" wx:key="*this"><text>•</text>{{item}}</view>
    <button class="danger-button" bindtap="goContact">进入危险信号筛查</button>
  </view>

  <view class="card" wx:if="{{item.confusedItems.length}}">
    <view class="card-title">容易混淆</view>
    <view class="confused-row">
      <view class="confused-chip" wx:for="{{item.confusedItems}}" wx:key="id">{{item.name}}</view>
    </view>
  </view>

  <view class="card sources-card">
    <view class="card-title">资料来源</view>
    <view class="source-item" wx:for="{{item.sources}}" wx:key="url" bindtap="copySource" data-url="{{item.url}}">
      <view class="source-title">{{item.title}}</view><view class="source-copy">复制链接</view>
    </view>
    <view class="source-note">条目为面向公众的摘要表述；点击可复制原始资料链接。</view>
  </view>

  <view class="card sources-card">
    <view class="card-title">图片来源与许可</view>
    <view class="photo-credit" wx:for="{{item.images}}" wx:key="src" bindtap="copyImageSource" data-url="{{item.sourceUrl}}">
      <image class="credit-thumb" src="{{item.src}}" mode="aspectFill" />
      <view class="credit-copy">
        <view class="credit-caption">图 {{index + 1}} · {{item.caption}}</view>
        <view class="credit-meta">{{item.credit}} · {{item.license}}</view>
      </view>
      <view class="source-copy">复制来源</view>
    </view>
    <view class="source-note">图片已压缩用于小程序展示，许可与作者信息保留不变。</view>
  </view>

  <view class="bottom-actions">
    <button class="btn-ghost action-button" bindtap="toggleCompare">{{selected ? '移出对比' : '加入对比'}}</button>
    <button class="btn-primary action-button" bindtap="goCompare">{{selectedCount >= 2 ? '查看对比' : '继续选择'}}</button>
  </view>
</view>
