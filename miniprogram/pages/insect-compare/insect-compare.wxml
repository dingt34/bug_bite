<view class="page">
  <view class="head">
    <view class="head-title">物种特征对比</view>
    <view class="head-sub">优先比较虫体、环境和接触方式，不用皮损排列直接推断虫种</view>
  </view>

  <view class="error-card" wx:if="{{errorMessage}}">
    <view>{{errorMessage}}</view>
    <button class="btn-primary error-button" bindtap="backToGuide">返回选择</button>
  </view>

  <block wx:if="{{comparison}}">
    <view class="disclaimer">{{comparison.disclaimer}}</view>
    <scroll-view class="compare-scroll" scroll-x enhanced show-scrollbar="{{true}}">
      <view class="compare-table columns-{{comparison.items.length}}">
        <view class="table-row table-head">
          <view class="label-cell head-label">对比项目</view>
          <view class="value-cell insect-head" wx:for="{{comparison.items}}" wx:key="id">
            <image class="head-image" src="{{item.coverImage}}" mode="aspectFill" aria-label="{{item.name}}图片" />
            <view class="head-name">{{item.name}}</view>
            <view class="head-scientific">{{item.scientificName}}</view>
            <view class="head-group">{{item.commonCategory}}</view>
          </view>
        </view>
        <view class="table-row" wx:for="{{comparison.rows}}" wx:key="key" wx:for-item="row">
          <view class="label-cell">{{row.label}}</view>
          <view class="value-cell" wx:for="{{row.values}}" wx:key="*this" wx:for-item="value">{{value}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="compare-tip">对比结果仍存在重叠和不确定性。若已经发生接触，请按症状和危险信号决定下一步，而不是等待虫种确认。</view>
    <view class="actions">
      <button class="btn-ghost action-button" bindtap="backToGuide">调整选择</button>
      <button class="btn-primary action-button" bindtap="goContact">去安全判断</button>
    </view>
  </block>
</view>
