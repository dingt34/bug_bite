.publish-small{width:56rpx;height:56rpx;border-radius:50%;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;margin-left:16rpx}.textarea-wrap{height:310rpx;position:relative;background:#fff;border-radius:42rpx;overflow:hidden}.post-textarea{position:relative;z-index:1;box-sizing:border-box;width:100%;height:310rpx;background:transparent;padding:30rpx;color:#8c8f96;font-size:24rpx;line-height:2.05}.content-hint{position:absolute;z-index:0;top:30rpx;left:30rpx;right:30rpx;color:#8c8f96;font-size:24rpx;line-height:2.05}.content-hint text{display:block}.photo-add{width:206rpx;height:140rpx;border-radius:30rpx;background:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column}.photo-plus{color:#1e2021;font-size:46rpx;line-height:1;margin-bottom:10rpx}

/* 发布页的标签选项按设计稿使用浅灰常规字，不继承全局的黑色粗体。 */
.field-value{color:#8c8f96;font-size:24rpx;font-weight:400}
.event-selected{color:#8c8f96;font-size:22rpx}
.disabled{opacity:.55}.image-row{flex-wrap:wrap}.image-preview{position:relative;width:206rpx;height:140rpx;border-radius:30rpx;overflow:hidden;background:#fff}.image-preview image{width:100%;height:100%}.image-preview text{position:absolute;right:10rpx;top:8rpx;width:36rpx;height:36rpx;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:30rpx;line-height:32rpx;text-align:center}.associated{margin-top:20rpx}
.publish-safety-tip{display:flex;align-items:center;min-height:72rpx;margin-top:8rpx;padding:12rpx 20rpx;border-radius:20rpx;background:#fff4cc;color:#795d16;font-size:21rpx;line-height:1.45}.publish-safety-icon{flex:none;margin-right:12rpx;color:#d68b00;font-size:28rpx;line-height:1}
.page{padding-bottom:220rpx}.publish-bottom-action{position:fixed;z-index:20;left:36rpx;right:36rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));padding-top:16rpx;background:linear-gradient(to bottom,rgba(247,247,251,0),#f7f7fb 24rpx)}.publish-bottom-action .primary-btn{height:96rpx;border-radius:48rpx;box-shadow:0 12rpx 28rpx rgba(31,42,37,.18)}
.publish-picker-mask{position:fixed;z-index:40;inset:0;display:flex;align-items:flex-end;background:rgba(25,31,28,.32)}.publish-picker{width:100%;padding:20rpx 36rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:42rpx 42rpx 0 0;background:#f7f7fb;box-shadow:0 -10rpx 36rpx rgba(31,42,37,.16)}.picker-grabber{width:72rpx;height:8rpx;margin:0 auto 22rpx;border-radius:4rpx;background:#c8cbc8}.picker-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.picker-title{font-size:34rpx;font-weight:700}.picker-cancel{padding:12rpx;color:#8c8f96;font-size:24rpx}.picker-options{max-height:560rpx;overflow:auto}.picker-option{display:flex;align-items:center;justify-content:space-between;min-height:92rpx;padding:0 28rpx;margin-top:12rpx;border-radius:26rpx;background:#fff;color:#1e2021;font-size:27rpx}.picker-check{color:#2f875f;font-size:30rpx;font-weight:700}
.quick-title{margin-top:30rpx}.quick-associated{margin-top:16rpx}.associated{display:none}
.event-image-import{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;padding:22rpx 28rpx;border-radius:26rpx;background:#fff;color:#2f875f;font-size:24rpx}.event-image-import-disabled{color:#a4a7ad}
