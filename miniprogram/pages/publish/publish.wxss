.publish-small{width:56rpx;height:56rpx;border-radius:50%;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;margin-left:16rpx}.textarea-wrap{height:310rpx;position:relative;background:#fff;border-radius:42rpx;overflow:hidden}.post-textarea{position:relative;z-index:1;box-sizing:border-box;width:100%;height:310rpx;background:transparent;padding:30rpx;color:#8c8f96;font-size:24rpx;line-height:2.05}.content-hint{position:absolute;z-index:0;top:30rpx;left:30rpx;right:30rpx;color:#8c8f96;font-size:24rpx;line-height:2.05}.content-hint text{display:block}.photo-add{width:206rpx;height:140rpx;border-radius:30rpx;background:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column}.photo-plus{color:#1e2021;font-size:46rpx;line-height:1;margin-bottom:10rpx}

/* 发布页的标签选项按设计稿使用浅灰常规字，不继承全局的黑色粗体。 */
