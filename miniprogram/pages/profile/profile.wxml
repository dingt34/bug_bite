<view class="page with-tab"><view class="safe-top"></view><view class="between" style="height:96rpx"><view class="top-title-main">我的</view><view class="figma-menu"><image src="/assets/figma/all/s12-imgEllipse.svg"/><image src="/assets/figma/all/s12-imgEllipse.svg"/><image src="/assets/figma/all/s12-imgEllipse.svg"/></view></view>
<view class="card card-pad row"><image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill"/><view wx:else class="circle circle-green avatar">林</view><view class="grow" style="margin-left:26rpx"><view class="h2">{{user.nickname}}</view><view class="tiny">{{user.region}}</view><view class="mini-btn" bindtap="edit">编辑个人档案</view></view><view class="profile-ring">80%</view></view>
<view class="section-title">待处理</view><view class="status-grid"><view class="card card-pad" bindtap="events"><view class="tiny">待复查</view><view class="h3">{{event.type}}</view><view class="tiny">{{event.reviewAt}}</view></view><view class="card card-pad" bindtap="plans"><view class="tiny">近期行程</view><view class="h3">丽水徒步</view><view class="tiny">还有 5 天</view></view></view>
<view class="section-title">记录与计划</view><view class="stack gap-8"><view class="field" bindtap="events"><view class="circle circle-green small-icon"><image class="figma-icon sm" src="/assets/figma/all/s12-img2.svg"/></view><view class="grow" style="margin-left:22rpx"><view>我的事件</view><view class="tiny">{{event.id?'3 条记录 · 1 条待复查':'暂无记录'}}</view></view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view><view class="field" bindtap="plans"><view class="circle circle-green small-icon"><image class="figma-icon sm" src="/assets/figma/all/s12-img12.svg"/></view><view class="grow" style="margin-left:22rpx"><view>我的行程</view><view class="tiny">3 个计划 · 2 份离线卡</view></view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view><view class="field"><view class="circle circle-green small-icon"><image class="figma-icon sm" src="/assets/figma/all/s12-img3.svg"/></view><view class="grow" style="margin-left:22rpx"><view>提醒设置</view><view class="tiny">订阅消息与复查提醒</view></view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view></view>
<view class="section-title">账户与数据</view><view class="field" bindtap="privacy"><view class="circle" style="width:64rpx;height:64rpx;background:#ecefea"><image class="figma-icon sm" src="/assets/figma/all/s12-img1.svg"/></view><view class="grow" style="margin-left:22rpx"><view>隐私与数据</view><view class="tiny">本机、云端、社群与 AI 数据</view></view><image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg"/></view></view>
