.page {
  padding-bottom: 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2E7D5B, #3F9D76);
  color: #fff;
  padding: 40rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  text-align: center;
  line-height: 100rpx;
  font-size: 44rpx;
  margin-right: 24rpx;
  overflow: hidden;
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.user-name {
  font-size: 34rpx;
  font-weight: 600;
}
.user-sub {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}
.user-arrow {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}
.identity-action {
  padding: 18rpx 40rpx;
  background: #FFFFFF;
  color: #6E777E;
  font-size: 24rpx;
  text-align: right;
}
.cloud-sync-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border: 2rpx solid #CFE3D9;
  border-radius: 20rpx;
  background: var(--primary-light);
}
.cloud-sync-title {
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
}
.cloud-sync-sub {
  max-width: 410rpx;
  margin-top: 5rpx;
  color: #63726B;
  font-size: 21rpx;
}
.sync-button {
  margin: 0 0 0 16rpx;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 23rpx;
  line-height: 1.5;
}
.sync-button::after {
  border: none;
}

.section {
  margin: 24rpx 24rpx 0;
}
.section-title {
  font-size: 28rpx;
  color: #6B7379;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-head .section-title {
  margin-bottom: 0;
}
.section-more {
  color: var(--primary);
  font-size: 23rpx;
}
.overview-card {
  display: flex;
  padding: 26rpx 12rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.overview-item {
  flex: 1;
  text-align: center;
}
.overview-item + .overview-item {
  border-left: 1rpx solid #ECEEF0;
}
.overview-num {
  color: #2B2F36;
  font-size: 34rpx;
  font-weight: 700;
}
.overview-label {
  color: #8A9299;
  font-size: 22rpx;
}

.plan-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.plan-name {
  font-size: 32rpx;
  font-weight: 600;
}
.plan-meta {
  font-size: 24rpx;
  color: #8A9299;
  margin-top: 8rpx;
}
.plan-tags {
  margin-top: 16rpx;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2E7D5B;
  background: #E8F3EE;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.event-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.event-info {
  flex: 1;
}
.event-type {
  font-size: 30rpx;
  font-weight: 600;
}
.event-time {
  font-size: 24rpx;
  color: #8A9299;
  margin-top: 6rpx;
}
.event-level {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.risk-emergency {
  color: #E53935;
  background: #FDECEA;
}
.risk-consult {
  color: #F57C00;
  background: #FDF0E0;
}
.risk-observe {
  color: #2E7D5B;
  background: #E8F3EE;
}

.empty-tip {
  font-size: 24rpx;
  color: #B7C0C7;
  text-align: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 20rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.menu-title {
  color: #2B2F36;
  font-size: 28rpx;
  font-weight: 600;
}
.menu-sub {
  margin-top: 4rpx;
  color: #8A9299;
  font-size: 22rpx;
}
.menu-arrow {
  color: #AAB2B8;
  font-size: 28rpx;
}

.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7C0C7;
  padding: 40rpx;
}
