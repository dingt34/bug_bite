.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background: #F4F7F5;
  box-sizing: border-box;
}

.profile-hero {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #256C50, #3F9D76);
  color: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(37, 108, 80, 0.2);
}
.hero-main {
  display: flex;
  align-items: center;
}
.avatar {
  width: 92rpx;
  height: 92rpx;
  margin-right: 22rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  font-size: 40rpx;
  line-height: 92rpx;
  text-align: center;
}
.avatar-image {
  width: 100%;
  height: 100%;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-name {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.user-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  line-height: 1.5;
}
.user-arrow {
  padding-left: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 34rpx;
}
.identity-badge {
  margin-left: 16rpx;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  font-size: 20rpx;
}
.hero-login-hint {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}
.identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}
.identity-state {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.88);
  font-size: 21rpx;
}
.state-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #BDECCF;
}
.identity-action {
  padding: 8rpx 0 8rpx 24rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 21rpx;
}
.hero-sync {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.13);
}
.sync-copy {
  flex: 1;
  min-width: 0;
}
.sync-title {
  font-size: 24rpx;
  font-weight: 600;
}
.sync-sub {
  max-width: 430rpx;
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 19rpx;
  line-height: 1.45;
}
.sync-button {
  margin: 0 0 0 16rpx;
  padding: 11rpx 19rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #2E7D5B;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}
.sync-button::after {
  border: none;
}

.section {
  margin-top: 30rpx;
}
.section-title {
  margin-bottom: 14rpx;
  padding-left: 4rpx;
  color: #5F6C65;
  font-size: 27rpx;
  font-weight: 600;
}
.overview-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid #E6ECE9;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(32, 66, 51, 0.05);
}
.overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.community-head {
  margin-top: 24rpx;
}
.overview-title {
  color: #35413B;
  font-size: 26rpx;
  font-weight: 600;
}
.overview-sub {
  margin-top: 3rpx;
  color: #929C97;
  font-size: 19rpx;
}
.overview-total {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
}
.overview-grid {
  display: grid;
  margin-top: 20rpx;
}
.safety-grid {
  grid-template-columns: repeat(2, 1fr);
}
.community-grid {
  grid-template-columns: repeat(3, 1fr);
}
.overview-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  text-align: center;
}
.overview-item + .overview-item {
  border-left: 1rpx solid #E9EEEB;
}
.community-item {
  display: block;
  min-height: auto;
}
.overview-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 54rpx;
}
.safety-icon {
  background: #EAF4EF;
}
.event-icon {
  background: #FFF3E3;
}
.overview-num {
  color: #27322D;
  font-size: 32rpx;
  font-weight: 700;
}
.overview-label {
  margin-top: 2rpx;
  color: #7E8983;
  font-size: 21rpx;
}
.overview-divider {
  height: 1rpx;
  margin-top: 24rpx;
  background: #EDF1EF;
}

.record-label {
  margin: 4rpx 4rpx 12rpx;
  color: #89938E;
  font-size: 21rpx;
}
.event-label {
  margin-top: 22rpx;
}
.plan-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #E6ECE9;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(32, 66, 51, 0.04);
}
.record-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #EAF4EF;
  font-size: 32rpx;
  line-height: 68rpx;
  text-align: center;
}
.plan-content {
  flex: 1;
  min-width: 0;
}
.plan-name {
  overflow: hidden;
  color: #2B3530;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plan-meta {
  margin-top: 5rpx;
  color: #87918C;
  font-size: 21rpx;
}
.plan-tags {
  margin-top: 10rpx;
}
.tag {
  display: inline-block;
  margin: 0 8rpx 4rpx 0;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  background: #E8F3EE;
  color: #2E7D5B;
  font-size: 18rpx;
}
.record-arrow {
  margin-left: 12rpx;
  color: #A5AEA9;
  font-size: 28rpx;
}
.event-record-icon {
  background: #FFF1EA;
}
.event-status {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
}
.risk-emergency {
  background: #FDECEA;
  color: #E53935;
}
.risk-consult {
  background: #FDF0E0;
  color: #F57C00;
}
.risk-observe {
  background: #E8F3EE;
  color: #2E7D5B;
}
.empty-tip {
  padding: 28rpx;
  border: 1rpx dashed #D9E2DE;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #9CA6A1;
  font-size: 22rpx;
  text-align: center;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #E6ECE9;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(32, 66, 51, 0.04);
}
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #EEF5F1;
  font-size: 30rpx;
  line-height: 64rpx;
  text-align: center;
}
.menu-content {
  flex: 1;
  min-width: 0;
}
.menu-title {
  color: #2F3934;
  font-size: 27rpx;
  font-weight: 600;
}
.menu-sub {
  margin-top: 5rpx;
  color: #89938E;
  font-size: 20rpx;
  line-height: 1.45;
}
.menu-arrow {
  margin-left: 16rpx;
  color: #A7B0AB;
  font-size: 28rpx;
}
.footer-note {
  padding: 38rpx 20rpx 12rpx;
  color: #ABB3AF;
  font-size: 20rpx;
  text-align: center;
}
