/* pages/profile/profile.wxss */

/* ===== 原有样式保留 ===== */
.avatar {
  width: 108rpx;
  height: 108rpx;
  font-size: 40rpx;
}

.profile-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 10rpx solid #2f875f;
  border-left-color: #d5e4d8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #8c8f96;
  flex-shrink: 0;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.small-icon {
  width: 64rpx;
  height: 64rpx;
}

/* ===== 新增样式 ===== */

/* 状态标签（紧急/待处理） */
.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #ffebee;
  color: #c62828;
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 同步状态指示点 */
.sync-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.sync-dot.green {
  background: #4caf50;
}

.sync-dot.orange {
  background: #ff9800;
  animation: pulse 1s infinite;
}

.sync-dot.red {
  background: #f44336;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 切换开关（用于社群统计） */
.switch-toggle {
  width: 96rpx;
  height: 52rpx;
  background: #d5d8de;
  border-radius: 26rpx;
  padding: 4rpx;
  flex-shrink: 0;
  transition: background 0.3s;
}

.switch-toggle .switch-thumb {
  width: 44rpx;
  height: 44rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  transition: transform 0.3s;
}

.switch-toggle .switch-thumb.on {
  transform: translateX(44rpx);
  background: #2f875f;
}

/* 字段列表通用 */
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
}