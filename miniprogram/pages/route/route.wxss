.route-page { min-height:100vh;background:#d6e6d7;position:relative;overflow:hidden; }
.route-map { position:relative;height:52vh;min-height:760rpx;background:#dceadb;overflow:hidden; }
.map-hill { position:absolute;border-radius:50%;background:#c1dac4; }
.h1a{width:700rpx;height:360rpx;left:-180rpx;top:120rpx}.h1b{width:620rpx;height:480rpx;right:-220rpx;top:300rpx}
.map-path{position:absolute;left:230rpx;top:-100rpx;width:28rpx;height:1000rpx;background:#fff;transform:rotate(38deg);border:6rpx solid #4d866e;border-top:0;border-bottom:0;border-radius:50%}
.map-pin{position:absolute;color:#f49b38;font-size:38rpx}.pin-end{right:130rpx;top:90rpx;color:#e64c43;font-size:70rpx}.pin-a{left:225rpx;top:450rpx}.pin-b{left:400rpx;top:320rpx}
.route-back{position:absolute;left:36rpx;top:40rpx}.route-menu{position:absolute;right:36rpx;top:40rpx}.route-sheet{position:absolute;left:0;right:0;bottom:0;min-height:49vh;background:#f7f7fb;border-radius:48rpx 48rpx 0 0;padding:24rpx 36rpx 40rpx}.grabber{width:80rpx;height:8rpx;border-radius:4rpx;background:#c8cbc8;margin:0 auto 30rpx}.route-points{padding:24rpx;margin-top:24rpx;line-height:60rpx}.mode-row{display:grid;grid-template-columns:repeat(4,1fr);background:#eceef1;border-radius:38rpx;margin:24rpx 0}.mode{height:76rpx;display:flex;align-items:center;justify-content:center;color:#8c8f96}.mode.active{background:#fff;border-radius:38rpx;color:#1e2021}.metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:24rpx}.metrics>view{border-right:1rpx solid #eceef0}.metrics>view:last-child{border:0}.metrics .h2,.metrics .h3{font-size:30rpx}
