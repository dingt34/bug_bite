<view class="page with-tab community-page"><view class="safe-top"></view><view class="between" style="height:96rpx"><view><view class="top-title-main">经历社群</view><view class="top-title-sub">真实经历仅供参考，不替代安全判断</view></view></view>
<view class="field"><image class="figma-icon sm" src="/assets/figma/all/s21-imgEllipse.svg"/><input class="grow" placeholder="搜索地区、场景或处理方式"/><text class="muted">筛选</text></view><view class="chip-row" style="margin-top:26rpx"><view wx:for="{{filters}}" wx:key="*this" class="chip {{filter===item?'active':''}}" data-v="{{item}}" bindtap="filter">{{item}}</view></view>
<view class="stack gap-12" style="margin-top:36rpx"><view wx:for="{{posts}}" wx:key="id" class="card post-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="circle {{index?'circle-amber':'circle-green'}}" style="width:72rpx;height:72rpx">{{item.initial}}</view><view class="grow" style="margin-left:20rpx"><view class="h3">{{item.author}}</view><view class="tiny">{{item.region}} · {{item.type}} · {{item.stage}}</view></view><view class="chip active">{{index?'待复查':'经验分享'}}</view></view><view class="h3" style="margin-top:26rpx">{{item.title}}</view><view class="muted post-text">{{item.text}}</view><view wx:if="{{item.route}}" class="route-snippet">路线：{{item.route}} <text>查看</text></view><view class="post-meta"><text>♡ {{item.likes}}</text><text>评论 {{item.comments}}</text><text>收藏 {{item.favorites}}</text><text>分享</text></view></view></view>
<view class="safe-note community-note">社区内容是个人经验，不应作为诊断或治疗依据</view><view class="publish-fab" bindtap="publish"><image class="publish-circle" src="/assets/figma/all/s21-imgEllipse2.svg"/><text class="plus">＋</text></view></view>
