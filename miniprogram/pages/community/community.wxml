<view class="page with-tab community-page"><view class="safe-top"></view><view class="between" style="height:96rpx"><view><view class="top-title-main">经历社群</view><view class="top-title-sub">真实经历仅供参考，不替代安全判断</view></view></view>
<view class="field"><image class="search-icon" src="/assets/community/search.svg" mode="aspectFit"/><input class="grow" value="{{keyword}}" bindinput="search" placeholder="搜索地区、场景或处理方式"/><text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">清除</text><view class="filter-trigger {{hasFilter?'filter-trigger-on':''}}" bindtap="openFilters"><image src="/assets/community/filter.svg" mode="aspectFit"/><text>筛选</text></view></view>
<view wx:if="{{showFilter}}" class="filter-mask" catchtap="closeFilters"><view class="filter-modal" catchtap="noop"><view class="filter-modal-head"><view><view class="filter-modal-title">筛选经历</view><view class="filter-modal-subtitle">按发生地区、实际接触情况和记录进度查看</view></view><text class="filter-close" bindtap="closeFilters">×</text></view><view class="modal-filter-section"><view class="modal-filter-label">发生地区</view><view class="chip-row modal-chips"><view wx:for="{{regionFilters}}" wx:key="*this" class="chip {{draftRegionFilter===item?'active':''}}" data-v="{{item}}" bindtap="filterRegion">{{item}}</view></view></view><view class="modal-filter-section"><view class="modal-filter-label">接触类型</view><view class="chip-row modal-chips"><view wx:for="{{typeFilters}}" wx:key="*this" class="chip {{draftTypeFilter===item?'active':''}}" data-v="{{item}}" bindtap="filterType">{{item}}</view></view></view><view class="modal-filter-section"><view class="modal-filter-label">记录进度</view><view class="chip-row modal-chips"><view wx:for="{{stageFilters}}" wx:key="*this" class="chip {{draftStageFilter===item?'active':''}}" data-v="{{item}}" bindtap="filterStage">{{item}}</view></view></view><view class="modal-route-filter {{draftRouteOnly?'route-filter-on':''}}" bindtap="toggleRoute"><text class="route-filter-check">{{draftRouteOnly?'✓':''}}</text><text>仅看含路线的经历</text></view><view class="filter-modal-actions"><view class="filter-reset" bindtap="clearDraftFilters">重置</view><view class="filter-confirm" bindtap="confirmFilters">查看结果</view></view></view></view>
<view wx:if="{{loading && !posts.length}}" class="community-loading muted">正在加载经历…</view><view wx:elif="{{posts.length}}" class="stack gap-12" style="margin-top:36rpx"><view wx:for="{{posts}}" wx:key="id" class="card post-card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="circle {{item.stage === '观察中' ? 'circle-amber' : 'circle-green'}}" style="width:72rpx;height:72rpx">{{item.initial}}</view><view class="grow" style="margin-left:20rpx"><view class="h3 post-author">{{item.author}}</view><view class="tiny post-place">{{item.region}} · {{item.type}} · {{item.stage}}</view></view><view class="chip active post-stage">{{item.stage}}</view></view><view class="h3 post-title">{{item.title}}</view><view class="muted post-text">{{item.text}}</view><view wx:if="{{item.route}}" class="route-snippet"><view>路线：{{item.route}}</view><text>查看</text></view><view class="post-actions"><view class="post-action {{item.liked ? 'action-on' : ''}}" data-id="{{item.id}}" catchtap="toggleLike"><image class="action-icon" src="{{item.liked ? '/assets/community/like-filled.svg' : '/assets/community/like.svg'}}" mode="aspectFit"/><text>{{item.likes}}</text></view><view class="post-action" data-id="{{item.id}}" catchtap="open"><image class="action-icon" src="/assets/community/comment.svg" mode="aspectFit"/><text>{{item.comments}}</text></view><view class="post-action {{item.favorited ? 'action-on' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite"><image class="action-icon" src="{{item.favorited ? '/assets/community/star-filled.svg' : '/assets/community/star.svg'}}" mode="aspectFit"/><text>{{item.favorites}}</text></view><view class="post-action" data-title="{{item.title}}" catchtap="share"><image class="action-icon" src="/assets/community/share.svg" mode="aspectFit"/><text>分享</text></view></view></view></view>
<view wx:else class="card empty-card"><view class="empty-title">暂时没有匹配的经历</view><view class="muted">换个关键词或筛选条件看看，也可以分享你的户外经历。</view><view class="empty-actions"><view wx:if="{{keyword || typeFilter !== '全部' || stageFilter !== '全部' || routeOnly}}" class="empty-link" bindtap="resetFilters">清除筛选</view><view class="empty-link empty-publish" bindtap="publish">去发布</view></view></view><view wx:if="{{loadFailed}}" class="load-tip muted">暂未连接到社群服务，发布内容后会优先显示在此处。</view>
<view class="safe-note community-note">社区内容是个人经验，不应作为诊断或治疗依据</view><view class="publish-fab" bindtap="publish"><image class="publish-circle" src="/assets/figma/all/s21-imgEllipse2.svg"/><text class="plus">＋</text><text class="publish-label">发布</text></view></view>
