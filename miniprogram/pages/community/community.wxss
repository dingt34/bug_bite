.page {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.disclaimer {
  font-size: 24rpx;
  color: #7A5C00;
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid #E2E8E5;
  border-radius: 18rpx;
  background: #FFFFFF;
}
.search-icon {
  margin-right: 12rpx;
  color: #8A9690;
  font-size: 32rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
}
.search-clear {
  padding: 12rpx 0 12rpx 18rpx;
  color: var(--primary);
  font-size: 23rpx;
}
.filters {
  display: flex;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #E9ECEE;
}
.filter {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 14rpx;
  color: #717A81;
  font-size: 22rpx;
  text-align: center;
}
.filter-on {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.topic-scroll {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}
.topic-row {
  display: inline-flex;
  padding-right: 20rpx;
}
.topic-chip {
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  border: 2rpx solid #DCE5E0;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #69756F;
  font-size: 23rpx;
}
.topic-on {
  border-color: var(--primary);
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.feed-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 2rpx 18rpx;
}
.result-count {
  color: #8A9690;
  font-size: 21rpx;
}
.sorts {
  display: flex;
  padding: 5rpx;
  border-radius: 20rpx;
  background: #E9ECEE;
}
.sort {
  padding: 7rpx 16rpx;
  border-radius: 16rpx;
  color: #7A8480;
  font-size: 21rpx;
}
.sort-on {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
}

.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.post-head {
  display: flex;
  align-items: center;
}
.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  line-height: 72rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}
.post-name {
  font-size: 30rpx;
  font-weight: 600;
}
.post-time {
  font-size: 22rpx;
  color: #B7C0C7;
}
.post-text {
  font-size: 28rpx;
  color: #2B2F36;
  margin-top: 20rpx;
  line-height: 1.6;
}
.post-image {
  width: 100%;
  height: 320rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #F0F2F4;
}
.post-tags {
  margin-top: 16rpx;
}
.post-actions {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F2F4;
}
.action {
  display: flex;
  align-items: center;
  margin-right: 56rpx;
}
.action-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}
.action-num {
  font-size: 26rpx;
  color: #8A9299;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #B7C0C7;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  font-size: 28rpx;
  margin-top: 20rpx;
}
.comment-icon {
  font-size: 30rpx;
}
.empty-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.cloud-state {
  padding: 110rpx 36rpx;
  color: #7C8983;
  font-size: 25rpx;
  text-align: center;
}
.state-spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 22rpx;
  border: 5rpx solid #DCE9E3;
  border-top-color: var(--primary);
  border-radius: 50%;
}
.state-error {
  padding-top: 72rpx;
}
.state-icon {
  font-size: 62rpx;
}
.state-title {
  margin-top: 14rpx;
  color: #48554F;
  font-size: 28rpx;
  font-weight: 600;
}
.state-sub {
  margin-top: 10rpx;
  color: #929D98;
  font-size: 22rpx;
  line-height: 1.5;
}
.retry-button {
  width: 220rpx;
  margin-top: 28rpx;
  border-radius: 34rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
}
.retry-button::after {
  border: none;
}
.load-more {
  padding: 24rpx 0 44rpx;
  color: #A0AAA5;
  font-size: 21rpx;
  text-align: center;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 132rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 40rpx;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 91, 0.4);
}
