.community-page{padding-bottom:190rpx}.search-icon{width:40rpx;margin-right:12rpx;color:#1e2021;font-size:34rpx;line-height:1;text-align:center}.post-card{padding:28rpx}.featured-post{padding:22rpx 28rpx 26rpx}.featured-post .chip.active{background:#e2eee6;border:0;color:#8c8f96}.review-post{padding-top:24rpx}.review-chip{visibility:hidden}.post-author{font-size:32rpx;line-height:1.25}.post-place{margin-top:4rpx;line-height:1.45}.post-title{margin-top:26rpx;font-size:34rpx;line-height:1.35}.post-text{margin-top:18rpx;color:#8c8f96;font-size:26rpx;line-height:1.9}.route-snippet{position:relative;margin-top:22rpx;border:1rpx solid #e1e5e2;border-radius:30rpx;padding:18rpx 92rpx 18rpx 24rpx;color:#8c8f96;font-size:24rpx;line-height:1.55}.route-habitat{margin-top:4rpx}.route-snippet text{position:absolute;right:26rpx;top:50%;transform:translateY(-50%)}.post-meta{display:flex;justify-content:space-between;margin-top:24rpx;color:#8c8f96;font-size:22rpx}.review-meta{justify-content:flex-start;gap:82rpx}.review-status{padding:10rpx 32rpx;border-radius:30rpx;background:#f0f1f3;color:#e47b16}.community-note{margin:40rpx 0 10rpx;padding:22rpx;background:#f0f1f3;border-radius:40rpx}.publish-fab{position:fixed;z-index:50;right:52rpx;bottom:142rpx;width:112rpx;height:112rpx;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 12rpx 32rpx rgba(47,135,95,.25)}.publish-circle{position:absolute;inset:0;width:100%;height:100%}.plus{position:relative;z-index:1;margin-top:-8rpx;font-size:52rpx;line-height:.85;font-weight:300}.publish-label{position:relative;z-index:1;margin-top:4rpx;color:#1e2021;font-size:18rpx;line-height:1}
