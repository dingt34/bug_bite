.page {
  padding: 20rpx 24rpx;
  padding-bottom: 180rpx;
}

.community-hero {
  margin-bottom: 20rpx;
  padding: 34rpx 30rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #1F6B50 0%, #2E7D5B 62%, #4D9275 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(31, 107, 80, 0.2);
}
.hero-eyebrow {
  margin-bottom: 8rpx;
  color: #CDE8DC;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}
.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.55;
}
.hero-publish {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-top: 26rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #1F6B50;
  box-shadow: 0 8rpx 20rpx rgba(14, 61, 43, 0.18);
}
.publish-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #E5F3EC;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-align: center;
}
.publish-copy { flex: 1; }
.publish-title { font-size: 28rpx; font-weight: 700; }
.publish-sub { margin-top: 2rpx; color: #71847B; font-size: 20rpx; }
.publish-arrow { font-size: 42rpx; line-height: 1; }
.hero-notice {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  text-align: center;
}
.discover-panel {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #E7ECE9;
  border-radius: 22rpx;
  background: #FFFFFF;
}
.search-box {
  display: flex;
  align-items: center;
  min-height: 70rpx;
  margin-bottom: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid #E1E8E4;
  border-radius: 16rpx;
  background: #F7F9F8;
}
.search-icon {
  margin-right: 12rpx;
  color: #8A9690;
  font-size: 32rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
}
.search-clear {
  padding: 12rpx 0 12rpx 18rpx;
  color: var(--primary);
  font-size: 23rpx;
}
.topic-scroll {
  width: 100%;
  white-space: nowrap;
}
.region-scroll { margin-bottom: 14rpx; }
.topic-row {
  display: inline-flex;
  padding-right: 20rpx;
}
.topic-chip {
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid #DCE5E0;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #69756F;
  font-size: 21rpx;
}
.topic-on {
  border-color: var(--primary);
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.feed-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 18rpx;
}
.feed-title {
  color: #27362F;
  font-size: 31rpx;
  font-weight: 700;
}
.result-count {
  margin-top: 3rpx;
  color: #8A9690;
  font-size: 20rpx;
}
.sorts {
  display: flex;
  padding: 5rpx;
  border-radius: 20rpx;
  background: #E9ECEE;
}
.sort {
  padding: 7rpx 16rpx;
  border-radius: 16rpx;
  color: #7A8480;
  font-size: 21rpx;
}
.sort-on {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
}

.post-card {
  background: #fff;
  border: 1rpx solid #E8EDEA;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(35, 65, 52, 0.055);
}
.post-head {
  display: flex;
  align-items: center;
}
.post-avatar {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  line-height: 68rpx;
  font-size: 29rpx;
  margin-right: 16rpx;
}
.post-avatar-image {
  display: block;
  background: #EEF3F0;
}
.post-name {
  font-size: 30rpx;
  font-weight: 600;
}
.post-time {
  font-size: 22rpx;
  color: #B7C0C7;
}
.post-text {
  margin-top: 22rpx;
  color: #25312B;
  font-size: 29rpx;
  line-height: 1.7;
}
.route-share-card { margin-top: 20rpx; padding: 20rpx; border: 1rpx solid #CFE4D9; border-radius: 16rpx; background: linear-gradient(135deg, #F3FAF6, #FFFFFF); }
.route-share-badge { color: #2E7D5B; font-size: 21rpx; font-weight: 600; }
.route-share-path { margin-top: 10rpx; color: #26342D; font-size: 25rpx; font-weight: 600; line-height: 1.65; }
.route-arrow { margin: 0 8rpx; color: #74A38D; }
.route-share-meta { margin-top: 8rpx; color: #75827C; font-size: 21rpx; }
.post-image {
  width: 100%;
  height: 320rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #F0F2F4;
}
.post-tags {
  margin-top: 16rpx;
}
.post-actions {
  display: flex;
  margin-top: 22rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F2F4;
}
.action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin: 0 4rpx;
  border-radius: 14rpx;
  color: #7A8580;
}
.action-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  color: inherit;
  line-height: 1;
  text-align: center;
}
.action-glyph {
  font-size: 28rpx;
  line-height: 29rpx;
}
.comment-bubble {
  position: relative;
  box-sizing: border-box;
  width: 27rpx;
  height: 21rpx;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
}
.comment-bubble::after {
  content: '';
  position: absolute;
  left: 5rpx;
  bottom: -6rpx;
  width: 7rpx;
  height: 7rpx;
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  background: #FFFFFF;
  transform: skewY(-35deg);
}
.action-label {
  margin-right: 6rpx;
  font-size: 22rpx;
}
.action-num {
  font-size: 22rpx;
  color: inherit;
}
.action-on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.action-collected {
  background: #FFF7E6;
  color: #A87416;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #B7C0C7;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  font-size: 28rpx;
  margin-top: 20rpx;
}
.empty-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.cloud-state {
  padding: 110rpx 36rpx;
  color: #7C8983;
  font-size: 25rpx;
  text-align: center;
}
.state-spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 22rpx;
  border: 5rpx solid #DCE9E3;
  border-top-color: var(--primary);
  border-radius: 50%;
}
.state-error {
  padding-top: 72rpx;
}
.state-icon {
  font-size: 62rpx;
}
.state-title {
  margin-top: 14rpx;
  color: #48554F;
  font-size: 28rpx;
  font-weight: 600;
}
.state-sub {
  margin-top: 10rpx;
  color: #929D98;
  font-size: 22rpx;
  line-height: 1.5;
}
.retry-button {
  width: 220rpx;
  margin-top: 28rpx;
  border-radius: 34rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
}
.retry-button::after {
  border: none;
}
.load-more {
  padding: 24rpx 0 44rpx;
  color: #A0AAA5;
  font-size: 21rpx;
  text-align: center;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 132rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 30rpx;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 91, 0.4);
}
