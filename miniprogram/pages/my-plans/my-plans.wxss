/* 选项卡样式 - 修改为2列 */
.mode-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* 从3改为2列 */
  background: #eff0f2;
  border-radius: 42rpx;
  margin-top: 20rpx;
}

.mode-tab {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8c8f96;
  font-size: 28rpx;
  font-weight: 500;
}

.mode-tab.active {
  background: #fff;
  border-radius: 42rpx;
  color: #1e2021;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 主要行程卡片 */
.main-trip {
  position: relative;
  overflow: hidden;
  min-height: 350rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 24rpx;
  margin-top: 24rpx;
}

.trip-art {
  position: absolute;
  right: 0;
  top: 0;
  width: 240rpx;
  height: 100%;
  background: #a9ccb1;
  border-top-right-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
}

/* 删除按钮样式 */
.delete-btn {
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding:点上触发删除
}

.delete-btn:hover {
  opacity: 0.8;
}

.delete-btn.small {
  padding: 4rpx 8rpx;
  border-radius: sn;
  background: #f5f5f5;
}

.trip-road {
  position: absolute;
  left: 80rpx;
  top: -20rpx;
  width: 22rpx;
  height: 400rpx;
  background: #fff;
  transform: rotate(34deg);
  border-radius: 50%;
}

.count {
  position: absolute;
  right: 50rpx;
  bottom: 60rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffa726;
  color: white;
  font-size: examined
}

.mini-btn {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 16rpx 34rpx;
  background: #f0f1f3;
  border-radius: 32rpx;
  color: #9fa2a8;
  font-size: 22rpx;
}

/* 新增样式 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
}

.primary-btn {
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.primary-btn:active {
  background: #45a049;
}

.secondary-btn {
  background: #f0f1f3;
  color: #666;
  border: none;
  border-radius: 24rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  width: 100%;
}

.secondary-btn:active {
  background: #e0e1e3;
}

/* 状态标签样式 */
.chip {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.chip-success {
  background: #e8f5e9;
  color: #2e7d32;
}

.chip-draft {
  background: #fff3e0;
  color: #f57c00;
}

/* 卡片字段样式 */
.card.field {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: white;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.circle {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-blue {
  background: #e3f2fd;
}

.circle-green {
  background: #e8f5e9;
}

.field-value {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.tiny {
  font-size: 24rpx;
  color: #666;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}
