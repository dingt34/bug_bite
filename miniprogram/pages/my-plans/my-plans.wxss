.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);padding:8rpx;background:#e9eceb;border-radius:44rpx;margin-top:20rpx}.mode-tab{height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:38rpx;color:#6f7471;font-size:28rpx;font-weight:600}.mode-tab.active{background:#fff;color:#174b38;box-shadow:0 6rpx 18rpx rgba(31,42,37,.08)}
.plan-card{padding:30rpx 32rpx;border:1rpx solid #edf0ee}.plan-heading{min-height:46rpx}.status-pill,.draft-label{display:inline-flex;align-items:center;min-height:46rpx;padding:0 20rpx;border-radius:23rpx;background:#e2eee6;color:#2f7d5b;font-size:24rpx;font-weight:700}.status-pill.history{background:#eff0f2;color:#74797d}.sync-status{color:#929792;font-size:23rpx}.plan-title{margin-top:24rpx;padding-right:10rpx}.plan-meta{margin-top:12rpx;color:#666d69;font-size:27rpx}.plan-footer{margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid #ecefed}.progress-label{color:#6f7672;font-size:24rpx}.open-link{color:#267551;font-size:26rpx;font-weight:700}
.empty-card{padding:56rpx 38rpx;text-align:center;border:2rpx dashed #dfe4e1;box-shadow:none}.empty-title{font-size:30rpx;font-weight:700;color:#474d49}.empty-copy{margin-top:14rpx;color:#8c928e;font-size:25rpx;line-height:1.65}.draft-card{padding:34rpx}.draft-label{background:#fae7bc;color:#8a6117}.draft-link{margin-top:30rpx}.create-btn{margin-top:44rpx}
.offline-card{display:flex;align-items:center;gap:22rpx;margin-top:24rpx;padding:26rpx 28rpx}.offline-icon{width:76rpx;height:76rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;background:#dceee4;color:#286f50;font-size:22rpx;font-weight:700}.offline-title{margin-bottom:7rpx;font-size:28rpx;font-weight:700;color:#303633}
