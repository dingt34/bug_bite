.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);background:#eff0f2;border-radius:42rpx;margin-top:20rpx}.mode-tab{height:84rpx;display:flex;align-items:center;justify-content:center;color:#8c8f96}.mode-tab.active{background:#fff;border-radius:42rpx;color:#1e2021}.main-trip{position:relative;overflow:hidden;min-height:350rpx;padding:32rpx}.trip-art{position:absolute;right:0;top:0;width:240rpx;height:100%;background:#a9ccb1}.trip-road{position:absolute;left:80rpx;top:-20rpx;width:22rpx;height:400rpx;background:#fff;transform:rotate(34deg);border-radius:50%}.count{position:absolute;right:50rpx;bottom:60rpx;width:60rpx;height:60rpx}.mini-btn{display:inline-flex;margin-top:22rpx;padding:16rpx 34rpx;background:#f0f1f3;border-radius:32rpx;color:#9fa2a8;font-size:22rpx}
