/* pages/my-plans/my-plans.wxss */

/* ===== 原有样式保留 ===== */
.mode-tabs { display:grid; grid-template-columns:repeat(3,1fr); background:#eff0f2; border-radius:42rpx; margin-top:20rpx; }
.mode-tab { height:84rpx; display:flex; align-items:center; justify-content:center; color:#8c8f96; font-size:28rpx; }
.mode-tab.active { background:#fff; border-radius:42rpx; color:#1e2021; }
.main-trip { position:relative; overflow:hidden; min-height:350rpx; padding:32rpx; }
.trip-art { position:absolute; right:0; top:0; width:240rpx; height:100%; background:#a9ccb1; }
.trip-road { position:absolute; left:80rpx; top:-20rpx; width:22rpx; height:400rpx; background:#fff; transform:rotate(34deg); border-radius:50%; }
.count { position:absolute; right:50rpx; bottom:60rpx; width:60rpx; height:60rpx; display:flex; align-items:center; justify-content:center; color:#fff; font-size:28rpx; font-weight:600; }
.mini-btn { display:inline-flex; margin-top:22rpx; padding:16rpx 34rpx; background:#f0f1f3; border-radius:32rpx; color:#9fa2a8; font-size:22rpx; }

/* ===== 新增样式 ===== */

/* 倒计时 */
.trip-countdown {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

/* 环境标签 */
.trip-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.trip-tag {
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #fff;
}

/* 进度条 */
.progress-wrapper {
  margin-top: 20rpx;
}
.progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}
.progress-bar {
  height: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 路线摘要 */
.route-summary {
  color: #999;
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 状态标签变体 */
.chip-active { background: #e8f5e9; color: #2e7d32; }
.chip-done { background: #e3f2fd; color: #1565c0; }
.chip-draft { background: #f5f5f5; color: #999; }

/* 删除按钮 */
.delete-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
  border-radius: 50%;
  margin-left: 12rpx;
}
.delete-btn:active {
  background: #ffebee;
  color: #e53935;
}

/* 离线安全卡 */
.safety-card-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}
.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}
.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 48rpx;
}
.primary-btn {
  width: 400rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #25292a, #171a1b);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 删除弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  color: #1e2021;
}
.modal-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin: 24rpx 0 40rpx;
  line-height: 1.6;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}
.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}
.modal-btn.confirm {
  background: #e53935;
  color: #fff;
}