<view class="page"><view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s11-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">我的行程</view><view class="top-title-sub">{{plans.length}} 个计划</view></view></view>
<view class="mode-tabs"><view wx:for="{{tabs}}" wx:key="*this" class="mode-tab {{tab===item?'active':''}}" data-tab="{{item}}" bindtap="setTab">{{item}}</view></view>
<view class="section-title">即将出发</view><view class="card main-trip" bindtap="open"><view class="tiny">还有 5 天</view><view class="h2" style="margin-top:60rpx">丽水古堰画乡</view><view class="muted">8月18–20日 · 徒步露营</view><view class="mini-btn">查看行前清单</view><view class="trip-art"><view class="trip-road"></view><view class="circle circle-amber count">3</view></view></view>
<view class="section-title">其他计划</view><view class="stack gap-12"><view wx:for="{{otherPlans}}" wx:key="id" class="field" bindtap="open"><view class="circle circle-green" style="width:72rpx;height:72rpx"><image class="figma-icon md" src="{{index===0?'/assets/figma/all/s11-img1.svg':'/assets/figma/all/s11-imgRidingFill1.svg'}}"/></view><view class="grow" style="margin-left:22rpx"><view class="field-value">{{item.title}}</view><view class="tiny">{{item.date}} · {{item.type}}</view></view><view class="chip">{{item.status}}</view></view></view>
<button class="secondary-btn" style="margin-top:52rpx" bindtap="create">＋ 新建行前计划</button><view class="card between" style="padding:24rpx 30rpx;margin-top:24rpx"><view><view>离线安全卡</view><view class="tiny">最近更新：今天 09:20</view></view><text class="muted">2 份可用</text></view></view>
