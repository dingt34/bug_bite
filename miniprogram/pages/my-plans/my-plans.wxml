<view class="page">
  <view class="safe-top"></view>
  <view class="topbar">
    <view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s11-imgFrame.svg"/></view>
    <view class="top-title">
      <view class="top-title-main">我的行程</view>
      <view class="top-title-sub">{{planCount}} 个已保存计划</view>
    </view>
  </view>

  <view class="mode-tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="mode-tab {{tab===item?'active':''}}" data-tab="{{item}}" bindtap="setTab">{{item}}</view>
  </view>

  <block wx:if="{{tab!=='草稿'}}">
    <view class="section-title">{{tab==='近期'?'即将出发':'历史行程'}}<text class="aside">{{visiblePlans.length}} 个</text></view>
    <view wx:if="{{visiblePlans.length}}" class="stack gap-12">
      <view wx:for="{{visiblePlans}}" wx:key="id" class="card plan-card" data-id="{{item.id}}" bindtap="open">
        <view class="between plan-heading">
          <view class="status-pill {{item.isHistory?'history':''}}">{{item.countdown}}</view>
          <view class="sync-status">{{item.syncStatus||'已存本机'}}</view>
        </view>
        <view class="h2 plan-title">{{item.displayTitle}}</view>
        <view class="plan-meta">{{item.displayDate}} · {{item.displayActivity}}</view>
        <view class="between plan-footer">
          <view class="progress-label">{{item.progressText}}</view>
          <view class="open-link">查看清单 ></view>
        </view>
      </view>
    </view>
    <view wx:else class="card empty-card">
      <view class="empty-title">{{tab==='近期'?'还没有近期计划':'还没有历史行程'}}</view>
      <view class="empty-copy">{{tab==='近期'?'创建计划后，清单会保存在这里。':'出行日期过去后，计划会自动归入这里。'}}</view>
    </view>
  </block>

  <block wx:else>
    <view class="section-title">未完成的计划</view>
    <view wx:if="{{draft}}" class="card draft-card" bindtap="openDraft">
      <view class="draft-label">本机草稿</view>
      <view class="h2 plan-title">{{draft.displayTitle}}</view>
      <view class="plan-meta">{{draft.displayDate}} · {{draft.displayActivity}}</view>
      <view class="open-link draft-link">继续填写 ></view>
    </view>
    <view wx:else class="card empty-card">
      <view class="empty-title">没有未完成的草稿</view>
      <view class="empty-copy">填写中的行前计划会自动保存在本机。</view>
    </view>
  </block>

  <button class="secondary-btn create-btn" bindtap="create">＋ 新建行前计划</button>

  <view wx:if="{{offlineCard}}" class="card offline-card" bindtap="openOffline">
    <view class="offline-icon">离线</view>
    <view class="grow">
      <view class="offline-title">{{offlineCard.displayTitle}}</view>
      <view class="tiny">{{offlineCard.cachedText}}</view>
    </view>
    <view class="open-link">打开 ></view>
  </view>
</view>
