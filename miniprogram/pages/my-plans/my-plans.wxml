<!-- pages/my-plans/my-plans.wxml -->
<view class="page">
  <view class="safe-top"></view>

  <!-- ===== 顶部导航 ===== -->
  <view class="topbar">
    <view class="back" bindtap="back">
      <image class="figma-back" src="/assets/figma/all/s11-imgFrame.svg" />
    </view>
    <view class="top-title">
      <view class="top-title-main">我的行程</view>
      <view class="top-title-sub">{{plans.length}} 个计划</view>
    </view>
    <view class="figma-menu">
      <image src="/assets/figma/all/s11-imgEllipse1.svg" />
      <image src="/assets/figma/all/s11-imgEllipse1.svg" />
      <image src="/assets/figma/all/s11-imgEllipse1.svg" />
    </view>
  </view>

  <!-- ===== Tab切换：近期 / 历史 / 草稿 ===== -->
  <view class="mode-tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="mode-tab {{tab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="setTab">
      {{item}}
    </view>
  </view>

  <!-- ===== 计划列表 ===== -->
  <!-- 空状态 -->
  <view wx:if="{{filteredPlans.length === 0}}" class="empty-state">
    <image class="empty-icon" src="/assets/figma/all/s11-empty.svg" mode="aspectFit" />
    <view class="empty-title">暂无行前计划</view>
    <view class="empty-desc">创建一个计划，安全出行更安心</view>
    <button class="primary-btn" bindtap="create">＋ 新建行前计划</button>
  </view>

  <!-- 有计划 -->
  <view wx:else>
    <!-- ===== 即将出发 ===== -->
    <view wx:if="{{upcomingPlan}}" class="section-title">即将出发</view>
    <view wx:if="{{upcomingPlan}}" class="card main-trip" bindtap="openPlan" data-id="{{upcomingPlan.id}}">
      <view class="trip-countdown">{{upcomingPlan.daysLeft || '即将出发'}}</view>
      <view class="h2" style="margin-top:60rpx">{{upcomingPlan.title}}</view>
      <view class="muted">{{upcomingPlan.date}} · {{upcomingPlan.type || '出行'}}</view>
      <view class="trip-tags">
        <view class="trip-tag" wx:for="{{upcomingPlan.tags}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="progress-wrapper">
        <view class="progress-label">
          <text>行前清单</text>
          <text>{{upcomingPlan.completeRate || 0}}%</text>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{upcomingPlan.completeRate || 0}};"></view>
        </view>
      </view>
      <view class="mini-btn" catchtap="openPlan" data-id="{{upcomingPlan.id}}">查看行前清单</view>
      <view class="trip-art">
        <view class="trip-road"></view>
        <view class="circle circle-amber count">{{upcomingPlan.itemsCount || 0}}</view>
      </view>
    </view>

    <!-- ===== 其他计划列表 ===== -->
    <view class="section-title">{{upcomingPlan ? '其他计划' : '全部计划'}}</view>
    <view class="stack gap-12">
      <view wx:for="{{filteredPlans}}" wx:key="id" class="field" bindtap="openPlan" data-id="{{item.id}}">
        <view class="circle circle-green" style="width:72rpx;height:72rpx">
          <image class="figma-icon md" src="{{index === 0 ? '/assets/figma/all/s11-img1.svg' : '/assets/figma/all/s11-imgRidingFill1.svg'}}" />
        </view>
        <view class="grow" style="margin-left:22rpx">
          <view class="field-value">{{item.title}}</view>
          <view class="tiny">{{item.date}} · {{item.type || '出行'}}</view>
          <view class="tiny route-summary" wx:if="{{item.route}}">{{item.route}}</view>
        </view>
        <view class="chip {{item.status === '已完成' ? 'chip-done' : item.status === '草稿' ? 'chip-draft' : 'chip-active'}}">
          {{item.status || '待出发'}}
        </view>
        <view class="delete-btn" catchtap="confirmDelete" data-id="{{item.id}}">✕</view>
      </view>
    </view>

    <!-- ===== 新建按钮 ===== -->
    <button class="secondary-btn" style="margin-top:52rpx" bindtap="create">＋ 新建行前计划</button>

    <!-- ===== 离线安全卡 ===== -->
    <view class="card between" style="padding:24rpx 30rpx;margin-top:24rpx" bindtap="openSafetyCard">
      <view>
        <view>离线安全卡</view>
        <view class="tiny">最近更新：{{safetyCardUpdate || '暂无'}}</view>
      </view>
      <view class="safety-card-right">
        <text class="muted">{{safetyCardCount}} 份可用</text>
        <image class="figma-icon sm" src="/assets/figma/all/s02-imgFrame2.svg" />
      </view>
    </view>
  </view>
</view>

<!-- ===== 删除确认弹窗 ===== -->
<view wx:if="{{showDeleteModal}}" class="modal-mask" bindtap="closeDeleteModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-title">确认删除</view>
    <view class="modal-desc">确定要删除「{{deleteTarget.title}}」吗？<br/>删除后不可恢复。</view>
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="closeDeleteModal">取消</view>
      <view class="modal-btn confirm" bindtap="doDelete">确认删除</view>
    </view>
  </view>
</view>