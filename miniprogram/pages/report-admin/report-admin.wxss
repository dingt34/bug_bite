.empty{margin-top:120rpx;text-align:center;color:#8c8f96;font-size:26rpx}.report-card{padding:28rpx;border-radius:32rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,42,37,.06)}.report-head{display:flex;justify-content:space-between}.report-type{color:#1e2021;font-size:28rpx;font-weight:600}.report-status{color:#ea4038;font-size:22rpx}.report-content{margin-top:20rpx;color:#4b5054;font-size:26rpx;line-height:1.6}.report-reason{display:flex;align-items:center;justify-content:center;min-height:64rpx;margin-top:16rpx;padding:16rpx 20rpx;border-radius:20rpx;background:#fff2ef;color:#a34b45;font-size:23rpx;text-align:center}.report-card .tiny{margin-top:14rpx}
.review-actions{display:flex;gap:16rpx;margin-top:20rpx}.review-actions button{flex:1;height:70rpx;padding:0;border-radius:35rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;line-height:1;text-align:center}.review-delete{background:#fde8e4;color:#ea4038}.review-reject{background:#e2eee6;color:#2f7d5b}
.dev-notice{margin:44rpx 0 20rpx;text-align:center;color:#a4a7ad;font-size:22rpx}
