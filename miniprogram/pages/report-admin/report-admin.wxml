<view class="page"><view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back">‹</view><view class="top-title"><view class="top-title-main">举报审核</view><view class="top-title-sub">查看被举报的帖子、评论及具体理由</view></view></view><view wx:if="{{loading}}" class="empty">正在加载举报记录…</view><view wx:elif="{{error}}" class="empty">{{error}}</view><view wx:elif="{{!reports.length}}" class="empty">暂无举报记录</view><view wx:else class="stack gap-12"><view wx:for="{{reports}}" wx:key="_id" class="report-card"><view class="report-head"><text class="report-type">{{item.targetType === 'comment' ? '评论' : '帖子'}}</text><text class="report-status">{{item.status === 'pending' ? '待处理' : item.status}}</text></view><view class="report-content">{{item.target.text || item.target.title || '目标内容已删除'}}</view><view class="report-reason">举报理由：{{item.reason}}</view><view class="tiny">举报时间：{{item.createdAt || '刚刚'}}</view><view wx:if="{{item.status === 'pending'}}" class="review-actions"><button class="review-delete" data-id="{{item._id}}" data-decision="delete" bindtap="review">删除内容并通知</button><button class="review-reject" data-id="{{item._id}}" data-decision="reject" bindtap="review">驳回举报并通知</button></view></view></view><view class="dev-notice">该功能还在研发中，敬请期待</view></view>
