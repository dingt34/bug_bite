.ai-notes-page{padding-bottom:56rpx}.back{width:88rpx;font-size:var(--font-caption);font-weight:600}.note-notice{margin-top:18rpx;padding:22rpx 24rpx}.notice-title{color:#2f7d5b;font-size:var(--font-body);font-weight:700}.notice-sub{margin-top:6rpx;color:#758079;font-size:var(--font-caption);line-height:1.55}.note-list{margin-top:28rpx}.note-card{margin-bottom:18rpx;padding:26rpx 28rpx}.note-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.note-time{color:#8c9690;font-size:var(--font-caption)}.note-delete{padding:8rpx 0 8rpx 18rpx;color:#d65b53;font-size:var(--font-caption)}.note-label{color:#2f7d5b;font-size:var(--font-caption);font-weight:700}.note-question{margin-top:8rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#eef7f1;color:#344b3f;font-size:var(--font-caption);line-height:1.6;white-space:pre-wrap}.answer-label{margin-top:22rpx}.note-answer{display:block;margin-top:8rpx;color:#344b3f;font-size:var(--font-body);line-height:1.75;word-break:break-word}.note-answer h1,.note-answer h2,.note-answer h3{margin:16rpx 0 10rpx;color:#26342d;font-weight:700;line-height:1.4}.note-answer h1{font-size:var(--font-card-title)}.note-answer h2{font-size:var(--font-card-title)}.note-answer h3{font-size:var(--font-body)}.note-answer p{margin:8rpx 0}.note-answer ul,.note-answer ol{margin:10rpx 0;padding-left:36rpx}.note-answer li{margin:6rpx 0}.note-answer blockquote{margin:12rpx 0;padding:12rpx 18rpx;border-left:6rpx solid #69a891;border-radius:0 14rpx 14rpx 0;background:#eef8f4;color:#456156}.note-answer code{padding:3rpx 9rpx;border-radius:8rpx;background:#edf1ef;color:#2f7d5b;font-family:monospace}.note-answer pre{margin:14rpx 0;padding:18rpx;overflow:auto;border-radius:16rpx;background:#26342d;color:#eef8f4;white-space:pre-wrap}.note-answer pre code{padding:0;background:transparent;color:inherit}.note-answer strong{color:#26342d;font-weight:700}.note-link{margin-top:16rpx;color:#2f7d5b;font-size:var(--font-caption)}.empty-card{margin-top:40rpx;padding:48rpx 32rpx;border-radius:32rpx;background:#fff;text-align:center}.empty-title{margin-bottom:12rpx;color:#344b3f;font-size:var(--font-card-title);font-weight:700}.empty-card .primary-btn{margin-top:30rpx}
