.review-page{padding-bottom:64rpx}.draft-action{min-height:68rpx;padding:0 8rpx;display:flex;align-items:center;color:#2f7d5b;font-size:var(--font-body);font-weight:600}.review-hero{margin-top:20rpx;padding:32rpx;background:linear-gradient(145deg,#eef7f2,#fff);border:1rpx solid #e2ebe6}.review-count{color:#2f7d5b;font-size:var(--font-caption);font-weight:700}.elapsed-pill{padding:9rpx 16rpx;border-radius:20rpx;background:#fff;color:#66736c;font-size:var(--font-caption)}.hero-title{margin-top:20rpx;color:#21352b;font-size:var(--font-section-title);font-weight:700;line-height:1.3}.hero-meta{margin-top:8rpx;color:#5d6b64;font-size:var(--font-body)}.hero-tip{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid #dfe9e3;color:#68756e;font-size:var(--font-caption);line-height:1.6}
.danger-notice{min-height:112rpx;margin-top:24rpx;padding:22rpx 24rpx;background:#fff7f6;border:2rpx solid #efc5c1;border-radius:32rpx;display:flex;align-items:center;gap:20rpx;color:#b8352e}.danger-title{font-size:var(--font-body);font-weight:700;line-height:1.45}.danger-copy{margin-top:5rpx;color:#b6534d;font-size:var(--font-caption)}.danger-arrow{flex:none;color:#c73730;font-size:var(--font-caption);font-weight:700}.form-progress{position:relative;margin:42rpx 0 18rpx;padding-left:26rpx}.progress-line{position:absolute;left:0;top:4rpx;bottom:4rpx;width:7rpx;border-radius:4rpx;background:#2f875f}.progress-copy{color:#526159;font-size:var(--font-body);font-weight:600}
.question-card{margin-top:22rpx;padding:30rpx}.required-card{border:2rpx solid #c8ded2}.question-head{display:flex;align-items:center;gap:18rpx}.step-number{width:54rpx;height:54rpx;border-radius:18rpx;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:var(--font-body);font-weight:800}.optional-step{background:#e5f0e9;color:#2f7556}.question-title{color:#24342c;font-size:var(--font-card-title);font-weight:700}.question-sub{margin-top:5rpx;color:#78837d;font-size:var(--font-caption);line-height:1.45}.required-badge,.optional-badge{flex:none;min-width:72rpx;padding:8rpx 14rpx;border-radius:18rpx;text-align:center;font-size:var(--font-caption);font-weight:700}.required-badge{background:#fff0dd;color:#965c10}.optional-badge{background:#f0f2f1;color:#717a75}.field-question{margin-top:30rpx;color:#35463d;font-size:var(--font-body);font-weight:700}.field-divider{height:1rpx;margin:30rpx 0 0;background:#e8edea}.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx;margin-top:18rpx}.choice{min-height:88rpx;padding:12rpx;border:2rpx solid #dfe7e2;border-radius:26rpx;background:#fafcfb;display:flex;align-items:center;justify-content:center;color:#59665f;font-size:var(--font-body);font-weight:600;text-align:center}.choice.selected{background:#eef6f2;border-color:#69a88a;color:#276e50}.choice-good.selected{background:#e5f5eb;border-color:#50a274;color:#227149}.choice-alert.selected{background:#fff0ee;border-color:#e7675f;color:#c63a32}.choice-neutral.selected{background:#fff7dc;border-color:#dcbf54;color:#6f5707}.range-choice{min-height:80rpx}
.previous-note{margin-top:24rpx;padding:18rpx 20rpx;border-radius:22rpx;background:#f2f5f3;color:#5d6963;font-size:var(--font-caption);line-height:1.55}.previous-label{margin-bottom:5rpx;color:#829089;font-size:var(--font-caption)}.option-row{margin-top:22rpx}.symptom-chip,.systemic-chip,.measure-chip{min-height:72rpx;padding:10rpx 24rpx;border:2rpx solid #dce6e0;color:#59665f;background:#fff;font-size:var(--font-body)}.symptom-chip.selected{background:#fff4df;color:#865912;border-color:#ddb86e}.systemic-chip.selected{background:#fff0ee;color:#c23d35;border-color:#e57871}.measure-chip.selected{background:#e5f3eb;color:#26704f;border-color:#6eab8c}.custom-symptom-card{margin-top:20rpx;padding:20rpx 22rpx 14rpx;border:2rpx solid #ddb86e;border-radius:22rpx;background:#fffaf0}.custom-symptom-input{width:100%;min-height:108rpx;color:#28352f;font-size:var(--font-body);line-height:1.6}.custom-symptom-count{display:block;margin-top:8rpx;color:#958b75;font-size:var(--font-caption);text-align:right}
.photo-card{margin-top:22rpx;padding:30rpx}.photo-head{padding-bottom:24rpx;border-bottom:1rpx solid #e8edea}.photo-content{min-height:112rpx;padding-top:24rpx;display:flex;align-items:center;gap:22rpx}.photo-placeholder,.review-photo{width:126rpx;height:96rpx;border-radius:24rpx;background:#e8efeb;display:flex;align-items:center;justify-content:center}.photo-copy{min-width:0}.photo-title{color:#30483b;font-size:var(--font-body);font-weight:700}.photo-action{color:#2f7d5b;font-size:var(--font-caption);font-weight:700}.photo-remove{height:64rpx;margin:10rpx 0 0 auto;padding:0 18rpx;color:#c34740;font-size:var(--font-caption);display:flex;align-items:center}.submit-area{margin-top:38rpx;padding-bottom:env(safe-area-inset-bottom)}.save-button{height:104rpx;font-size:var(--font-card-title)}.result-note{margin-top:18rpx;color:#69766f;font-size:var(--font-caption)}
@media (max-width:360px){.question-card,.photo-card{padding:26rpx 22rpx}.question-head{align-items:flex-start}.question-sub{padding-right:4rpx}.danger-arrow{display:none}.hero-title{font-size:var(--font-section-title)}}
