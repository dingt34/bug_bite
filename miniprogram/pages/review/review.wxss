.choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.choice{height:96rpx;border-radius:30rpx;background:#fff;display:flex;align-items:center;justify-content:center;color:#8c8f96}.photo-placeholder,.review-photo{width:104rpx;height:104rpx;border-radius:28rpx;background:#dfece1;display:flex;align-items:center;justify-content:center}.lesion{width:28rpx;height:28rpx;border-radius:50%;background:#e9a698;border:8rpx solid #f0c9bd}
