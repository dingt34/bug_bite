<view class="page with-tab ai-page">
  <view class="safe-top"></view>
  <view class="ai-top topbar-plain"><view class="topbar-copy"><view class="top-title-main">AI 助手</view><view class="ai-sub"><text class="status-dot"></text>安全建议 · 不替代安全判断</view></view><view class="ai-mode">文字咨询</view></view>
  <view class="danger-entry" bindtap="danger"><view class="danger-alert-icon"><image class="danger-alert-bg" src="/assets/figma/all/s16-imgEllipse1.svg"/><text class="danger-alert-mark">!</text></view><view class="grow"><view class="danger-title">症状正在加重，或已被咬、蜇？</view><view class="tiny danger-text">先判断危险信号，再决定下一步</view></view><view class="safety-link">安全判断</view></view>
  <view class="prompt-head"><view class="prompt-title">可以这样问</view><view class="prompt-hint">点选即可填入</view></view>
  <scroll-view class="suggestions" scroll-x show-scrollbar="{{false}}"><view class="suggestions-row"><view wx:for="{{suggestions}}" wx:key="*this" class="suggestion {{index===1?'highlight':''}}" data-text="{{item}}" bindtap="chooseSuggestion">{{item}}</view></view></scroll-view>
  <scroll-view class="chat" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}">
    <view wx:if="{{!messages.length}}" class="chat-empty"><view class="empty-avatar">AI</view><view class="empty-title">从你的情况开始说起</view><view class="empty-copy">描述接触方式、出现时间和症状变化；也可以发送一条行程或事件摘要，让建议更贴近当前情况。</view><view class="empty-note">如有呼吸困难、意识异常或口唇舌喉肿胀，请先进行安全判断。</view></view>
    <view wx:for="{{messages}}" wx:key="id" class="bubble {{item.role}}">
      <view wx:if="{{item.role==='ai'}}" class="circle circle-green ai-avatar">AI</view>
      <view class="bubble-text {{item.attachments.length?'has-records':''}}">
        <view wx:if="{{item.attachments.length}}" class="message-records">
          <view wx:for="{{item.attachments}}" wx:for-item="record" wx:key="key" class="message-record-card">
            <view class="message-record-icon {{record.type}}"><image wx:if="{{record.type==='event'}}" class="message-record-image" src="{{record.icon}}" mode="aspectFit"/><text wx:else>行</text></view>
            <view class="message-record-copy"><view class="message-record-title">{{record.title}}</view><view class="message-record-subtitle">{{record.subtitle}}</view><view wx:if="{{record.detail}}" class="message-record-detail">{{record.detail}}</view><view wx:if="{{record.type==='event'}}" class="message-review-row"><text class="message-review-badge {{record.reviewState}}">{{record.reviewStatus}}</text><text class="message-review-next">{{record.reviewHint}}</text></view><view wx:if="{{record.timeline.length}}" class="message-timeline"><view wx:for="{{record.timeline}}" wx:for-item="entry" wx:key="id" class="message-timeline-item"><view class="message-timeline-dot"></view><view class="message-timeline-copy"><view class="message-timeline-head"><text>{{entry.title}}</text><text>{{entry.time}}</text></view><view class="message-timeline-summary">{{entry.summary}}</view></view></view></view></view>
          </view>
        </view>
        <view wx:elif="{{item.attachmentLabel}}" class="message-attachment">{{item.attachmentLabel}}</view>
        <rich-text wx:if="{{item.role==='ai'}}" class="markdown-content" nodes="{{item.markdownHtml}}" selectable></rich-text>
        <view wx:else class="message-plain">{{item.text}}</view>
        <view wx:if="{{item.role==='ai'}}" class="ai-disclaimer">AI 生成 · 请结合危险信号判断</view>
        <view wx:if="{{item.retryable}}" class="retry-answer" bindtap="retryLast">重新尝试</view>
        <view wx:if="{{item.role==='ai' && !item.retryable && index===messages.length-1}}" class="note-actions"><view class="save-note {{item.saved?'saved':''}}" bindtap="saveLastAnswer">{{item.saved?'已保存':'保存为本机笔记'}}</view><view wx:if="{{item.saved}}" class="view-note" bindtap="openAiNotes">查看笔记</view></view>
      </view>
      <view wx:if="{{item.role==='user'}}" class="user-avatar">我</view>
    </view>
    <view id="chat-bottom-{{scrollToken}}" class="chat-bottom"></view>
  </scroll-view>
  <view class="ai-controls"><view class="record-picker" bindtap="openRecordPicker"><view class="record-picker-icon"><image class="figma-icon sm" src="/assets/figma/all/s16-imgEllipse4.svg"/></view><view class="record-copy"><text class="record-title">发送行程或事件摘要</text><text class="record-state">{{selectedLabel}}</text></view><text wx:if="{{selectedRecordIds.length}}" class="record-clear" catchtap="clearRecords">清除</text><text wx:else class="record-open">选择</text></view><view class="composer"><input class="composer-input" value="{{input}}" bindinput="input" maxlength="500" placeholder="描述你的情况或提出问题" confirm-type="send" bindconfirm="send"/><view class="send {{sending?'sending':''}} {{input || selectedRecordIds.length?'ready':'disabled'}}" bindtap="send"><text class="send-label">{{sending?'发送中':'发送'}}</text></view></view></view>

  <view class="picker-mask" wx:if="{{recordPickerVisible}}" catchtap="closeRecordPicker"></view>
  <view class="picker-sheet" wx:if="{{recordPickerVisible}}"><view class="picker-head"><view><view class="picker-title">选择发送的记录</view><view class="tiny">最多 3 条；只发送文字摘要，不发送历史图片</view></view><text class="picker-close" bindtap="closeRecordPicker">关闭</text></view><scroll-view class="record-list" scroll-y><view wx:for="{{selectableRecords}}" wx:key="key" class="record-option {{item.selected?'selected':''}}" data-key="{{item.key}}" bindtap="toggleRecord"><view class="record-kind">{{item.type==='plan'?'行程':'事件'}}</view><view class="grow"><view class="option-title">{{item.title}}</view><view class="tiny">{{item.subtitle}}</view></view><view class="check">{{item.selected?'✓':''}}</view></view><view class="empty-records" wx:if="{{!selectableRecords.length}}">暂无可选择的行程或事件记录</view></scroll-view><button class="primary-btn picker-confirm" bindtap="confirmRecords">确认选择 {{selectedRecordIds.length}} 条</button></view>
</view>
