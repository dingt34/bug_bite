.ai-page{height:100vh;overflow:hidden;padding-bottom:280rpx}.suggestions view{display:inline-flex;margin:0 12rpx 14rpx 0;padding:16rpx 24rpx;border-radius:32rpx;background:#f0f1f3;color:#9da0a6;font-size:22rpx}.chat{height:calc(100vh - 620rpx);margin-top:20rpx}.bubble{display:flex;margin:24rpx 0}.bubble.user{justify-content:flex-end}.bubble-text{max-width:76%;padding:28rpx 32rpx;border-radius:44rpx;background:#fff;line-height:1.8;color:#777c82;box-shadow:0 10rpx 28rpx rgba(31,42,37,.05)}.bubble.user .bubble-text{background:#fff}.ai-avatar{width:68rpx;height:68rpx;margin-right:20rpx;font-size:18rpx}.record-picker{position:fixed;z-index:30;left:36rpx;right:36rpx;bottom:266rpx;height:74rpx;border-radius:37rpx;background:#f0f1f3;padding:0 24rpx;display:flex;align-items:center;color:#8c8f96;font-size:22rpx}.record-picker text{margin-left:auto}.composer{position:fixed;z-index:31;left:36rpx;right:36rpx;bottom:176rpx;display:flex;gap:16rpx}.composer-input{height:76rpx;flex:1;border-radius:38rpx;background:#f0f1f3;padding:0 28rpx}.send{width:76rpx;height:76rpx;border-radius:50%;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:40rpx}
