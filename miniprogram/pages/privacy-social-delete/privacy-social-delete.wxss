.back{width:88rpx;font-size:var(--font-caption);font-weight:600}.safe-tip{margin-top:26rpx;padding:22rpx 26rpx;border-radius:28rpx;background:#fff2ef;color:#9b6d69;font-size:var(--font-caption);line-height:1.6}.social-card{min-height:132rpx;padding:24rpx 26rpx;border-radius:32rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,42,37,.05);display:flex;align-items:center}.avatar{width:64rpx;height:64rpx;border-radius:50%;background:#dceee4;color:#2f7d5b;display:flex;align-items:center;justify-content:center;font-size:var(--font-card-title)}.copy{margin-left:20rpx;min-width:0}.content-title{font-size:var(--font-body);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.route-state{margin-top:10rpx;color:#2f7d5b;font-size:var(--font-caption)}.delete-link{padding:16rpx 0 16rpx 20rpx;color:#ea4038;font-size:var(--font-caption)}.delete-link-disabled{color:#a4a7ad}.empty-card{padding:32rpx;border-radius:30rpx;background:#fff;color:#a4a7ad;text-align:center;font-size:var(--font-caption)}
