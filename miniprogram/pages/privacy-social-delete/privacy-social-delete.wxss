.safe-tip{margin-top:26rpx;padding:22rpx 26rpx;border-radius:28rpx;background:#fff2ef;color:#9b6d69;font-size:22rpx;line-height:1.6}.social-card{min-height:132rpx;padding:24rpx 26rpx;border-radius:32rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(31,42,37,.05);display:flex;align-items:center}.avatar{width:64rpx;height:64rpx;border-radius:50%;background:#dceee4;color:#2f7d5b;display:flex;align-items:center;justify-content:center;font-size:28rpx}.copy{margin-left:20rpx;min-width:0}.content-title{font-size:26rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.route-state{margin-top:10rpx;color:#2f7d5b;font-size:20rpx}.delete-link{padding:16rpx 0 16rpx 20rpx;color:#ea4038;font-size:22rpx}.empty-card{padding:32rpx;border-radius:30rpx;background:#fff;color:#a4a7ad;text-align:center;font-size:22rpx}
