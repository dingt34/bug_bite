<view class="page result-page">
  <view class="safe-top"></view>
  <view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s10-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">行前清单</view><view class="top-title-sub">{{plan.destinationName || plan.destination}} · {{plan.date || plan.month}} · {{plan.activityType || plan.activity}}</view></view><view wx:if="{{!isOffline}}" class="top-action" bindtap="edit">编辑</view></view>
  <view wx:if="{{isOffline}}" class="offline-banner">离线安全卡 · 内容来自最近一次主动保存</view>
  <view class="card result-banner"><view class="banner-label">场景化提示，不是风险预测</view><view class="h2 banner-title">{{riskTitle}}</view><view class="risk-summary">{{rule.riskSummary}}</view><view class="chip-row risk-tags"><view wx:for="{{rule.riskTags}}" wx:key="*this" class="chip active">{{item}}</view></view></view>
  <view class="vector-alert"><view class="vector-alert-head"><view class="vector-alert-title">虫媒提示</view><view class="vector-alert-tag">接触防护</view></view><view class="vector-alert-copy">高草、灌木、林缘和水边活动时，注意蜱、蚊、恙螨等节肢动物接触；尽量走开阔步道，穿长袖长裤并使用合规驱避剂。</view><view class="vector-alert-note">这是暴露防护提示，不代表目的地虫媒病风险预测。</view></view>
  <view class="completion"><view><view class="completion-title">清单进度</view><view class="completion-copy">已完成 {{doneCount}} / {{totalCount}}</view></view><view class="progress"><view class="progress-fill" style="width:{{completionPercent}}%"></view></view></view>
  <view wx:for="{{sections}}" wx:key="key" wx:for-item="section" wx:for-index="sectionIndex" class="check-section"><view class="section-title section-head"><view><view>{{section.title}}</view><view class="section-sub">{{section.subtitle}}</view></view><text class="aside">{{section.items.length}} 项</text></view><view wx:if="{{section.items.length}}" class="stack gap-12"><view wx:for="{{section.items}}" wx:key="id" wx:for-item="checkItem" wx:for-index="itemIndex" class="field checklist-item {{checkItem.done?'item-done':''}}" data-section="{{sectionIndex}}" data-index="{{itemIndex}}" bindtap="toggle"><view class="check-circle">{{checkItem.done?'✓':''}}</view><view class="grow item-text">{{checkItem.text}}</view><text class="item-state">{{checkItem.done?'已完成':'待完成'}}</text></view></view><view wx:else class="empty-group">暂无额外事项，按基础安全原则准备即可</view></view>
  <view wx:if="{{rule.knowledgeMatches.length}}" class="knowledge-section">
    <view class="section-title section-head"><view><view>知识库参考</view><view class="section-sub">按活动环境匹配，不代表当地一定存在或会遇到</view></view><text class="aside">{{rule.knowledgeMatches.length}} 类</text></view>
    <view class="card knowledge-card">
      <view wx:for="{{rule.knowledgeMatches}}" wx:key="objectId" class="knowledge-item">
        <view class="knowledge-name">{{item.name}}</view>
        <view class="knowledge-reason">{{item.reason}}</view>
        <view class="place-reference"><text class="place-label">可能相关地点</text><text>{{item.possiblePlaces}}</text></view>
        <view class="knowledge-version">知识包 {{item.packVersion}} · {{item.status==='DRAFT'?'草稿待审核':item.status}}</view>
      </view>
      <view class="knowledge-foot">知识库共 {{rule.knowledgeMeta.catalogSize}} 项 · 接口版本 {{rule.knowledgeMeta.interfaceVersion}}</view>
    </view>
  </view>
  <view class="card route-summary" wx:if="{{plan.route}}"><view class="route-title">已关联路线</view><view class="route-copy">{{plan.route.summary}} · {{plan.route.distance}} · {{plan.route.duration}}</view></view>
  <view class="result-actions"><view wx:if="{{!isOffline}}" class="autosave-note">清单进度已自动保存</view><button class="primary-btn" bindtap="saveOffline">{{offlineSaved?'更新离线安全卡':'保存离线安全卡'}}</button><view class="result-nav-actions"><button wx:if="{{!isOffline}}" class="text-action" bindtap="plans">查看我的行程</button><button class="text-action" bindtap="home">返回首页</button></view></view>
  <view class="safe-note">清单可离线查看；知识库仍为课程原型草稿。地点和季节只用于匹配准备提示，不代表疾病、虫种或虫媒风险概率。</view>
</view>
