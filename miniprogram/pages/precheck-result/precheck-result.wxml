<view class="page">
 <view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s10-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">行前清单</view><view class="top-title-sub">丽水 · 8月18日 · 徒步露营</view></view><view class="top-action">编辑</view></view>
 <view class="card result-banner"><view class="tiny">需要重点防范</view><view class="h2" style="margin-top:16rpx">草木茂密与近水环境</view><view class="chip-row" style="margin-top:22rpx"><view class="chip danger-active">虫媒提示 3</view><view class="chip active">天气适宜</view></view><view class="banner-map"></view></view>
 <view class="section-title"><text>准备清单</text><text class="aside">已完成 {{doneCount}} / 3</text></view>
 <view class="stack gap-12"><view wx:for="{{checklist}}" wx:key="title" class="field" data-index="{{index}}" bindtap="toggle"><view class="circle circle-green" style="width:62rpx;height:62rpx"><image class="figma-icon md" src="{{item.figmaIcon}}"/></view><view class="grow" style="margin-left:22rpx"><view class="field-value">{{item.title}}</view><view class="tiny">{{item.detail}}</view></view><text class="{{done[index]?'green-text':'muted'}}">{{done[index]?'已准备':'待准备'}}</text></view></view>
 <view class="card card-pad row" style="margin-top:44rpx"><view class="circle circle-green" style="width:72rpx;height:72rpx"><image class="figma-icon md" src="/assets/figma/all/s10-img12.svg"/></view><view class="grow" style="margin-left:22rpx"><view>已添加 ORS 徒步路线</view><view class="tiny">12.6 km · 3小时40分 · 爬升420m</view></view><text class="muted">查看</text></view>
 <view class="card card-pad row" style="margin-top:26rpx"><view class="circle circle-green" style="width:72rpx;height:72rpx"><image class="figma-icon md" src="/assets/figma/all/s10-imgFrame2.svg"/></view><view class="grow" style="margin-left:22rpx"><view>离线安全卡</view><view class="tiny">路线概要、清单与紧急处理可离线查看</view></view><text class="green-text">已生成</text></view>
 <button class="primary-btn" style="margin-top:58rpx" bindtap="save">保存行程</button><button class="secondary-btn disabled-btn" style="margin-top:18rpx" bindtap="plans">分享路线与准备清单</button><view class="safe-note" style="margin-top:24rpx">返程后将提醒检查是否有新接触</view>
</view>
