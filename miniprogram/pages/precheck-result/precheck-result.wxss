.page {
  padding-bottom: 40rpx;
}

.summary {
  background: linear-gradient(135deg, #2E7D5B, #3F9D76);
  color: #fff;
  padding: 40rpx;
}
.summary-line {
  font-size: 34rpx;
  font-weight: 600;
}
.summary-tags {
  margin-top: 16rpx;
}
.tag-w {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.risk-summary {
  font-size: 28rpx;
  color: #3A414A;
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.check-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.check-text {
  flex: 1;
  font-size: 28rpx;
}

.plain-item {
  font-size: 28rpx;
  margin-bottom: 12rpx;
  color: #3A414A;
}

.offline-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx dashed #C8D8D0;
}
.offline-left {
  flex: 1;
}
.offline-title {
  font-size: 30rpx;
  font-weight: 600;
}
.offline-sub {
  font-size: 22rpx;
  color: #8A9299;
  margin-top: 6rpx;
}
.offline-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
}

.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7C0C7;
  padding: 20rpx;
}
