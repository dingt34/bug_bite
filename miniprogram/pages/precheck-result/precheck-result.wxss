.result-page{padding-bottom:72rpx}.result-banner{position:relative;overflow:hidden;margin-top:22rpx;padding:32rpx;background:linear-gradient(145deg,#eef8f1,#fff)}.banner-label{color:#2f7d5b;font-size:var(--font-caption);font-weight:700}.banner-title{margin-top:14rpx;padding-right:40rpx}.risk-summary{margin-top:18rpx;color:#566b5e;font-size:var(--font-body);line-height:1.7}.risk-tags{margin-top:22rpx}.offline-banner{margin-top:18rpx;padding:16rpx 20rpx;border-radius:18rpx;background:#fff3d9;color:#80611f;font-size:var(--font-caption)}.vector-alert{margin-top:22rpx;padding:24rpx 26rpx;border:1rpx solid #d7e8dc;border-radius:26rpx;background:#f5faf7}.vector-alert-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.vector-alert-title{color:#1f513b;font-size:var(--font-body);font-weight:700}.vector-alert-tag{flex:none;padding:6rpx 14rpx;border-radius:18rpx;background:#e2f1e7;color:#2f7d5b;font-size:var(--font-micro);font-weight:600}.vector-alert-copy{margin-top:14rpx;color:#52645a;font-size:var(--font-caption);line-height:1.7}.vector-alert-note{margin-top:10rpx;color:#78857e;font-size:var(--font-micro);line-height:1.55}.completion{margin-top:28rpx;padding:24rpx 26rpx;border-radius:26rpx;background:#fff;display:flex;align-items:center;gap:28rpx}.completion>view:first-child{flex:none}.completion-title{font-size:var(--font-body);font-weight:700}.completion-copy{margin-top:4rpx;color:#758079;font-size:var(--font-caption)}.completion .progress{flex:1}.section-head{margin-top:34rpx;margin-bottom:16rpx}.section-sub{margin-top:5rpx;color:#8c9690;font-size:var(--font-caption);font-weight:400}.checklist-item{height:auto;min-height:104rpx;padding:18rpx 22rpx}.check-circle{width:50rpx;height:50rpx;flex:none;border:2rpx solid #b8c8bf;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#2f7d5b;font-size:var(--font-body)}.item-done .check-circle{border-color:#2f875f;background:#dceee4}.item-text{margin:0 18rpx;color:#344b3f;font-size:var(--font-body);line-height:1.55}.item-done .item-text{color:#78847d}.item-state{color:#8c9690;font-size:var(--font-caption);white-space:nowrap}.item-done .item-state{color:#2f7d5b}.empty-group{padding:26rpx;border-radius:24rpx;background:#f1f3f2;color:#7c8781;font-size:var(--font-caption);text-align:center}.route-summary{margin-top:34rpx;padding:26rpx}.route-title{color:#2f7d5b;font-size:var(--font-body);font-weight:700}.route-copy{margin-top:8rpx;color:#65716b;font-size:var(--font-caption);line-height:1.6}.result-actions{margin-top:42rpx}.result-actions .secondary-btn{margin-top:16rpx}.text-action{height:72rpx;margin:10rpx auto 0;color:#2f7d5b;font-size:var(--font-caption)}.result-page .safe-note{margin-top:20rpx;color:#69736e}
.knowledge-card{padding:6rpx 28rpx}.knowledge-item{padding:24rpx 0;border-bottom:1rpx solid #e8ece9}.knowledge-item:last-child{border-bottom:0}.knowledge-name{color:#294b3a;font-size:var(--font-body);font-weight:700}.knowledge-reason{margin-top:10rpx;color:#5f6d65;font-size:var(--font-body);line-height:1.65}.knowledge-version{margin-top:10rpx;color:#939b96;font-size:var(--font-caption)}.knowledge-foot{margin:6rpx -28rpx 0;padding:20rpx 28rpx;border-radius:0 0 46rpx 46rpx;background:#f1f6f3;color:#65766c;font-size:var(--font-caption)}
.place-reference{margin-top:14rpx;padding:18rpx 20rpx;border-radius:20rpx;background:#f3f7f4;color:#46584e;font-size:var(--font-caption);line-height:1.65}.place-label{display:block;margin-bottom:4rpx;color:#2f7d5b;font-weight:700}
