.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 360rpx;
  background: #F3F6F4;
  box-sizing: border-box;
}
.safety-notice {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #F5B400;
  border-radius: 18rpx;
  background: #FFF8E1;
}
.notice-icon {
  margin-right: 14rpx;
  font-size: 30rpx;
}
.notice-copy {
  flex: 1;
}
.notice-title {
  color: #6E5300;
  font-size: 24rpx;
  font-weight: 600;
}
.notice-sub {
  margin-top: 4rpx;
  color: #8B721D;
  font-size: 20rpx;
  line-height: 1.45;
}
.notice-arrow {
  color: #9A7A14;
  font-size: 28rpx;
}
.ai-status {
  margin: 16rpx 4rpx 24rpx;
  color: #76827C;
  font-size: 20rpx;
}
.status-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 9rpx;
  border-radius: 50%;
}
.status-ready .status-dot {
  background: #31A36D;
}
.status-off .status-dot {
  background: #D65A5A;
}
.chat-scroll {
  height: calc(100vh - 440rpx);
}
.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}
.message-user {
  flex-direction: row-reverse;
}
.message-avatar {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #2E7D5B;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
}
.message-user .message-avatar {
  background: #DCEBE4;
  color: #2E7D5B;
}
.message-content {
  max-width: 78%;
  margin-left: 14rpx;
}
.message-user .message-content {
  margin: 0 14rpx 0 0;
}
.message-bubble {
  padding: 20rpx 22rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #FFFFFF;
  color: #34413B;
  font-size: 25rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  box-shadow: 0 3rpx 12rpx rgba(38, 75, 58, 0.05);
}
.message-user .message-bubble {
  border-radius: 22rpx 8rpx 22rpx 22rpx;
  background: #2E7D5B;
  color: #FFFFFF;
}
.bubble-error {
  border: 1rpx solid #F0CACA;
  background: #FFF5F5;
  color: #A43F3F;
}
.ai-label {
  margin-top: 7rpx;
  color: #A2AAA6;
  font-size: 18rpx;
}
.typing {
  display: flex;
  padding: 8rpx 2rpx;
}
.typing text {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #91A39A;
}
.message-images {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 10rpx;
}
.message-image-wrap {
  margin-left: 10rpx;
}
.message-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 14rpx;
}
.message-image-label {
  margin-top: 4rpx;
  color: #7F8A84;
  font-size: 18rpx;
  text-align: center;
}
.scroll-spacer {
  height: 30rpx;
}
.composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E1E8E4;
  background: #FFFFFF;
  box-shadow: 0 -8rpx 24rpx rgba(30, 65, 49, 0.06);
}
.quick-scroll {
  width: 100%;
  white-space: nowrap;
}
.quick-row {
  display: inline-flex;
}
.quick-chip,
.record-chip {
  margin-right: 10rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #DDE7E2;
  border-radius: 24rpx;
  background: #F6F9F7;
  color: #607068;
  font-size: 20rpx;
}
.record-chip {
  border-color: #BFDCCF;
  background: #EAF4EF;
  color: #2E7D5B;
  font-weight: 600;
}
.image-previews {
  display: flex;
  margin-top: 12rpx;
}
.preview-wrap {
  position: relative;
  margin-right: 14rpx;
}
.preview-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
}
.preview-label {
  color: #7F8A84;
  font-size: 17rpx;
  text-align: center;
}
.preview-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(40, 48, 44, 0.82);
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 31rpx;
  text-align: center;
}
.attachment-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}
.attach-button {
  margin-right: 12rpx;
  padding: 9rpx 15rpx;
  border-radius: 18rpx;
  background: #EEF4F1;
  color: #4F6259;
  font-size: 20rpx;
}
.attachment-tip {
  flex: 1;
  color: #A0A9A4;
  font-size: 17rpx;
  text-align: right;
}
.input-row {
  display: flex;
  align-items: flex-end;
  margin-top: 12rpx;
}
.chat-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 170rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid #DDE5E1;
  border-radius: 20rpx;
  background: #F7F9F8;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.send-button {
  width: 120rpx;
  margin: 0 0 0 12rpx;
  padding: 18rpx 10rpx;
  border-radius: 20rpx;
  background: #2E7D5B;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.5;
}
.send-button::after {
  border: none;
}
.record-selector-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(22, 34, 28, 0.42);
}
.record-selector {
  position: fixed;
  z-index: 21;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 78vh;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
}
.selector-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: #DCE4E0;
}
.selector-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
}
.selector-title {
  color: #27352E;
  font-size: 30rpx;
  font-weight: 600;
}
.selector-subtitle {
  margin-top: 7rpx;
  color: #7B8982;
  font-size: 20rpx;
}
.selector-close {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #F1F5F3;
  color: #718078;
  font-size: 38rpx;
  line-height: 49rpx;
  text-align: center;
}
.selector-list {
  max-height: 52vh;
}
.selector-section {
  margin-bottom: 22rpx;
}
.selector-section-title {
  margin-bottom: 10rpx;
  color: #718078;
  font-size: 21rpx;
  font-weight: 600;
}
.selector-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-bottom: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #E1E8E4;
  border-radius: 18rpx;
  background: #FAFCFB;
  box-sizing: border-box;
}
.selector-item-selected {
  border-color: #77B397;
  background: #EDF7F2;
}
.selector-check {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid #B8C6BF;
  border-radius: 10rpx;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}
.selector-item-selected .selector-check {
  border-color: #2E7D5B;
  background: #2E7D5B;
}
.selector-copy {
  min-width: 0;
  flex: 1;
}
.selector-record-title {
  overflow: hidden;
  color: #34413B;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.selector-record-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #84918B;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.selector-actions {
  display: flex;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF1EF;
}
.selector-cancel,
.selector-confirm {
  height: 78rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 78rpx;
}
.selector-cancel {
  width: 180rpx;
  margin-right: 14rpx;
  background: #F1F5F3;
  color: #637169;
}
.selector-confirm {
  flex: 1;
  background: #2E7D5B;
  color: #FFFFFF;
}
.selector-confirm[disabled] {
  background: #CBD8D1;
  color: #FFFFFF;
}
.selector-cancel::after,
.selector-confirm::after {
  border: none;
}
