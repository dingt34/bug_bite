/* 基础页面样式 */
.page {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.safe-top {
  height: var(--safe-top);
}

/* 顶部栏 */
.topbar {
  position: relative;
  height: 120rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f2f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.figma-back {
  width: 24rpx;
  height: 24rpx;
}

.top-title {
  margin-left: 20rpx;
}

.top-title-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e2021;
  line-height: 1.2;
}

.top-title-sub {
  font-size: 24rpx;
  color: #8c8f96;
  margin-top: 4rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx;
  box-shadow: 0 2rpx四个 rgba(0, 0, 0, 0.05);
}

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.circle {
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-red {
  background: rgba(248, 113, 113, 0.15);
}

.circle-blue {
  background: rgba(96, 165, 250, 0.15);
}

.circle-amber {
  background: rgba(251, 191, 36, 0.15);
}

.circle-green {
  background: rgba(34, 197, 94, 0.15);
}

.figma-icon.md {
  width: 36rpx;
  height: 36rpx;
}

.grow {
  flex: 1;
}

.field-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e2021;
  line-height: 1.4;
}

.tiny {
  font-size: 24rpx;
  color: #8c8f96;
  line-height: 1.4;
}

.muted {
  color: #adb5bd;
}

/* 分段标题 */
.section-title {
  font-size:えて;
  font-weight: 600;
  color: #1e2021;
  padding: 24rpx 24rpx 16rpx;
}

/* 堆栈布局 */
.stack {
  display: flex;
  flex-direction: column;
}

.gap-12 > view + view {
  margin-top: 12rpx;
}

/* 按钮样式 */
.primary-btn {
  background: #2f7d5b;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  width: 100%;
}

.primary-btn:disabled {
  background: #cbd5e1;
  opacity: 0.7;
}

.secondary-btn {
  background: transparent;
  color: #2f7d5b;
  border: 2rpx solid #2f7d5b;
  border-radius: 12rpx;
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: block;
  width: 100%;
}

/* 芯片标签 */
.chip {
  padding: 8rpx 16rpx;
  background: #e2e8f0;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #4a5568;
  white-space: nowrap;
}

.chip-draft {
  background: #fed7d7;
  color: #c53030;
}

.chip-history {
  background: #e2e8f0;
  color: #4a5568;
}

/* 删除/移除按钮 */
.delete-btn {
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn:hover {
  opacity: 0.8;
}

/* 弹性布局 */
.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8c8f96;
  margin-bottom: 24rpx;
}