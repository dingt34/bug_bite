<view class="page">
  <view class="safe-top"></view>
  <view class="topbar">
    <view class="back" bindtap="back">
      <image class="figma-back" src="/assets/figma/all/s11-imgFrame.svg"/>
    </view>
    <view class="top-title">
      <view class="top-title-main">离线安全卡</view>
      <view class="top-title-sub">{{availableCards}} 份可用</view>
    </view>
  </view>

  <!-- 绑定行程信息 -->
  <view wx:if="{{currentPlan}}" class="card field" style="margin-top:24rpx;">
    <view class="circle circle-blue" style="width:72rpx;height:72rpx">
      <image class="figma-icon md" src="/assets/figma/all/s11-img1.svg"/>
    </view>
    <view class="grow" style="margin-left:22rpx">
      <view class="field-value">绑定的行程：{{currentPlan.title}}</view>
      <view class="tiny">{{currentPlan.date}} · {{currentPlan.type}}</view>
      <view class="tiny" style="margin-top:4rpx">点击生成与该行程相关的安全卡</view>
    </view>
    <view class="chip" bindtap="unbindPlan" style="background:#f5f5f5;color:#666;">
      解除绑定
    </view>
  </view>

  <!-- 紧急联系人 -->
  <view class="section-title" style="margin-top:32rpx">紧急联系人</view>
  <view class="stack gap-12">
    <view wx:for="{{safetyCard.emergencyContacts}}" wx:key="index" class="card field">
      <view class="circle circle-red" style="width:72rpx;height:72rpx">
        <image class="figma-icon md" src="/assets/figma/all/s04-imgIconDangerBreathing.svg"/>
      </view>
      <view class="grow" style="margin-left:22rpx">
        <view class="field-value">{{item.name}}</view>
        <view class="tiny">{{item.phone}}</view>
      </view>
      <view class="delete-btn" bindtap="removeContact" data-index="{{index}}" style="margin-left:16rpx;">
        <text style="font-size:24rpx;color:#999;padding:8rpx 16rpx;">移除</text>
      </view>
    </view>
  </view>

  <button class="secondary-btn" style="margin-top:16rpx" bindtap="addEmergencyContact">
    ＋ 添加联系人
  </button>

  <!-- 急救指南 -->
  <view class="section-title" style="margin-top:32rpx">急救指南</view>
  <view class="stack gap-12">
    <view wx:for="{{safetyCard.firstAid}}" wx:key="title" class="card field">
      <view class="circle circle-amber" style="width:72rpx;height:72rpx">
        <image class="figma-icon md" src="/assets/figma/all/s04-imgIconDangerConsciousness.svg"/>
      </view>
      <view class="grow" style="margin-left:22rpx">
        <view class="field-value">{{item.title}}</view>
        <view class="tiny">{{item.content}}</view>
      </view>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="section-title" style="margin-top:32rpx">安全提示</view>
  <view class="stack gap-12">
    <view wx:for="{{safetyCard.safetyTips}}" wx:key="*this" class="field">
      <view class="circle circle-green" style="width:48rpx;height:48rpx">
        <text style="font-size:24rpx;">✓</text>
      </view>
      <view class="grow" style="margin-left:22rpx">
        <view class="tiny">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="card" style="margin-top:32rpx;padding:32rpx;text-align:center;">
    <view class="field-value" style="margin-bottom:16rpx">生成离线安全卡</view>
    <view class="tiny" style="margin-bottom:24rpx">
      生成后可在无网络环境下查看所有安全信息
    </view>
    
    <button 
      class="primary-btn" 
      bindtap="generateOfflineCard"
      loading="{{generating}}"
      disabled="{{generating || availableCards <= 0}}"
    >
      {{generating ? '正在生成...' : '生成安全卡'}}
    </button>
    
    <view wx:if="{{availableCards <= 0}}" class="tiny muted" style="margin-top:16rpx">
      可用份数已用完
    </view>
  </view>

  <!-- 查看历史 -->
  <view class="card between" style="margin-top:24rpx;padding:24rpx 30rpx" bindtap="viewGeneratedCard">
    <view>
      <view>查看最近生成的安全卡</view>
      <view class="tiny">最近更新：今天 09:20</view>
    </view>
    <text class="muted">→</text>
  </view>

  <!-- 使用说明 -->
  <view class="card" style="margin-top:24rpx;padding:24rpx;">
    <view class="section-title">使用说明</view>
    <view class="tiny" style="margin-top:12rpx;line-height:1.6">
      1. 离线安全卡可在无网络时查看<br/>
      2. 建议在出发前生成安全卡<br/>
      3. 可添加个人紧急联系人<br/>
      4. 安全卡内容会定期更新<br/>
      5. 每份安全卡可使用一次
    </view>
  </view>
</view>