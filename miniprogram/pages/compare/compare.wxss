/* 列数由 JS 通过 style 注入（headStyle / tableStyle），这里只留默认值 */
.compare-head{display:grid;grid-template-columns:repeat(3,1fr);gap:18rpx;margin:38rpx 0;text-align:center}
.compare-spec{background:#fff;border-radius:36rpx;padding:20rpx}
.spec-image{height:160rpx;border-radius:26rpx;background:#e4ece4;display:flex;align-items:center;justify-content:center;overflow:hidden}
.species-photo{width:100%;height:100%;display:block}
.compare-table{display:grid;grid-template-columns:104rpx repeat(3,1fr);gap:14rpx}
.compare-table>view{min-height:86rpx;border-radius:26rpx;background:#fff;display:flex;align-items:center;justify-content:center;text-align:center;padding:10rpx;color:#777c82;font-size:22rpx}
.compare-table .label{background:transparent;justify-content:flex-start;color:#8c8f96}
.detail-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:20rpx;margin-top:40rpx}
.action-off{opacity:.35}
.empty-state{margin-top:38rpx;text-align:center}
.empty-state .tiny{margin-top:10rpx}
