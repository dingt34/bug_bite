.home-page { padding:0 36rpx 180rpx; }
.home-hero { position:relative; height:572rpx; margin:0 -36rpx; padding:40rpx 36rpx; overflow:hidden; background:linear-gradient(155deg,#e9f2e9 0%,#c8ddcc 45%,#8eb49a 100%); }
.home-sun { position:absolute; right:-70rpx; top:-80rpx; width:380rpx; height:300rpx; border-radius:50%; background:#f5ebca; }
.route-line { position:absolute; right:60rpx; top:120rpx; width:280rpx; height:480rpx; border-right:10rpx solid #fff; border-radius:50%; transform:rotate(38deg); opacity:.9; }
.home-head,.hero-copy { position:relative; z-index:2; }
.hello-pill { padding:18rpx 28rpx; border-radius:40rpx; background:rgba(255,255,255,.62); color:#5f7167; }
.hero-copy { margin-top:82rpx; }
.hero-chip { padding:12rpx 32rpx; border-radius:32rpx; background:rgba(255,255,255,.78); color:#80858a; font-size:22rpx; }
.danger-card { position:relative; z-index:3; margin-top:-120rpx; padding:32rpx; }
.status-grid { display:grid; grid-template-columns:1fr 1fr; gap:24rpx; }
.status-card { min-height:184rpx; padding:28rpx; }
.trip-card { position:relative; overflow:hidden; min-height:250rpx; padding:32rpx; }
.trip-map { position:absolute; right:0; top:0; width:220rpx; height:100%; background:#a9ccb1; }
.map-road { position:absolute; left:60rpx; top:-20rpx; width:22rpx; height:300rpx; background:#fff; border-radius:50%; transform:rotate(36deg); }
.map-count { position:absolute; right:42rpx; bottom:64rpx; width:52rpx; height:52rpx; }
.mini-btn { display:inline-flex; margin-top:46rpx; padding:16rpx 42rpx; border-radius:34rpx; background:#f1f2f4; color:#a0a3a9; font-size:22rpx; }
.sync-pill { margin-top:36rpx; padding:22rpx 30rpx; border-radius:40rpx; background:#f1f3f2; color:#9da39f; font-size:22rpx; display:flex; justify-content:space-between; }
