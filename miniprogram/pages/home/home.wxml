<view class="page with-tab home-page">
  <view class="home-hero">
    <view class="home-sun"></view><view class="route-line"></view>
    <view class="between home-head"><view class="hello-pill">林　早上好，{{user.nickname}}</view><view class="figma-menu"><image src="/assets/figma/all/s03-imgEllipse1.svg"/><image src="/assets/figma/all/s03-imgEllipse1.svg"/><image src="/assets/figma/all/s03-imgEllipse1.svg"/></view></view>
    <view class="hero-copy"><view class="h1">进入自然，<text class="block-break"></text>也做好准备</view><view class="chip-row" style="margin-top:20rpx"><view class="hero-chip">浙江</view><view class="hero-chip">徒步</view><view class="hero-chip">8 月风险</view></view></view>
  </view>
  <view class="card danger-card">
    <view class="row"><view class="circle circle-red" style="width:92rpx;height:92rpx"><image class="figma-icon md" src="/assets/figma/all/s03-imgFrame1.svg" mode="aspectFit"/></view><view class="grow" style="margin-left:24rpx"><view class="h3 danger-text">已经被咬或蜇？</view><view class="danger-text">先排查危险信号，再给出立即行动</view></view></view>
    <button class="primary-btn" style="margin-top:24rpx" bindtap="danger">立即进行安全判断</button>
  </view>
  <view class="section-title">你的今日状态</view>
  <view class="status-grid">
    <view class="card status-card" bindtap="plans"><view class="tiny">最近行程</view><view class="h3" style="margin:12rpx 0">{{plan.title || '暂无行程'}}</view><view class="tiny">{{plan.date}}</view></view>
    <view class="card status-card" bindtap="event"><view class="tiny">待复查</view><view class="h3" style="margin:12rpx 0">{{event.type || '暂无事件'}}</view><view class="tiny">{{event.reviewAt}}</view></view>
  </view>
  <view class="section-title"><text>行前准备</text><text class="aside" bindtap="plans">查看全部</text></view>
  <view class="card trip-card" bindtap="precheck"><view class="h3">丽水 · 古堰画乡</view><view class="muted"><image class="figma-icon sm figma-inline" src="/assets/figma/all/s03-img12.svg"/>徒步 · 林地 · 近水</view><image class="trip-map" src="/assets/figma/all/s03-imgFrame2.svg" mode="aspectFit"/><view class="mini-btn">继续完善计划</view></view>
  <view class="sync-pill"><image class="figma-icon sm figma-inline" src="/assets/figma/all/s03-imgEllipse6.svg"/>离线安全卡已更新 <text>刚刚</text></view>
</view>
