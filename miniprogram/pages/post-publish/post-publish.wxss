.page {
  padding: 24rpx 24rpx 60rpx;
}

.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.editor {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.upload {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #C8D8D0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-placeholder {
  font-size: 48rpx;
  color: #B7C0C7;
}
.preview {
  width: 100%;
  height: 100%;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.submit-wrap {
  padding: 20rpx 0 0;
}
