.page {
  padding: 24rpx 24rpx 60rpx;
}

.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.editor {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.char-count {
  color: #A3ABB1;
  font-size: 22rpx;
  text-align: right;
}
.validation-banner {
  margin: 0 24rpx 20rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #F4B7B4;
  border-radius: 12rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
}
.required {
  color: var(--danger);
}

.upload {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #C8D8D0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-placeholder {
  font-size: 48rpx;
  color: #B7C0C7;
}
.preview {
  width: 100%;
  height: 100%;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.submit-wrap {
  padding: 20rpx 0 0;
}
