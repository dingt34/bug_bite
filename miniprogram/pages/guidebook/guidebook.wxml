<view class="page guidebook-page">
  <view class="safe-top"></view>

  <view class="topbar">
    <view class="back" bindtap="back">
      <image class="figma-back" src="/assets/figma/all/s18-icon-back.svg"/>
    </view>
    <view class="top-title">
      <view class="top-title-main">虫种图鉴</view>
      <view class="top-title-sub">外形与环境参考，不构成确诊</view>
    </view>
  </view>

  <view class="catalog-overview">
    <view class="catalog-overview-copy"><view class="catalog-eyebrow">户外辨识参考</view><view class="h2">从外形、接触方式和环境共同判断</view><view class="catalog-description">已收录 {{total}} 种常见对象。照片相似不代表同一种，请打开详情查看关键特征与判断边界。</view></view>
    <view class="catalog-count"><text class="catalog-count-number">{{filteredCount}}</text><text class="catalog-count-label">当前结果</text></view>
  </view>

  <view class="field">
    <image class="figma-icon sm" src="/assets/figma/all/s18-imgEllipse6.svg"/>
    <input class="grow" placeholder="搜索名称或关键特征" value="{{keyword}}" bindinput="onKeyword" confirm-type="search"/>
    <text wx:if="{{keyword}}" class="muted keyword-clear" bindtap="clearKeyword">清除</text>
    <text wx:else class="muted">{{total}} 种</text>
  </view>

  <view class="chip-row" style="margin-top:26rpx">
    <view wx:for="{{categories}}" wx:key="*this" class="chip {{category===item?'active':''}}" data-v="{{item}}" bindtap="setCategory">{{item}}</view>
  </view>

  <view class="notice guide-notice">
    <view class="circle circle-green" style="width:64rpx;height:64rpx">
      <image class="figma-icon md" src="/assets/figma/all/s18-imgBug2.svg"/>
    </view>
    <view>
      <view class="guide-notice-title">图鉴应该怎样使用？</view>
      <view class="tiny">先看整体外形，再核对活动环境；发生接触或不适时，以症状安全判断为准。</view>
    </view>
  </view>

  <view class="section-title">
    <text>常见对象</text>
    <text class="aside">选择 2–3 种进行对比</text>
  </view>

  <view wx:if="{{items.length}}" class="insect-grid">
    <view wx:for="{{items}}" wx:key="id" class="card insect-card" data-id="{{item.id}}" bindtap="detail">
      <view class="insect-image">
        <image class="species-photo" src="{{item.photo}}" mode="aspectFill" lazy-load/>
        <image wx:if="{{item.selected}}" class="figma-icon sm check" src="/assets/figma/all/s18-icon-check.svg"/>
      </view>
      <view class="insect-card-copy"><view class="insect-title-row"><view><view class="h3 insect-name">{{item.name}}</view><view class="insect-latin">{{item.latin}}</view></view><view class="type-badge">{{item.typeLabel}}</view></view><view class="insect-meta">{{item.meta}}</view><view class="insect-summary">{{item.summary}}</view><view class="insect-card-footer"><text class="detail-link">查看特征与环境</text><text class="select-button {{item.selected?'selected':''}}" data-id="{{item.id}}" catchtap="toggle">{{item.selected?'已选对比':'加入对比'}}</text></view></view>
    </view>
  </view>

  <view wx:else class="card card-pad empty-state">
    <view class="h3">没有匹配的虫种</view>
    <view class="tiny">换一个关键词，或把分类切回“全部”</view>
    <view class="empty-reset" bindtap="resetFilters">清除筛选</view>
  </view>

  <view class="guidebook-actions"><button class="secondary-btn {{compareDisabled ? 'disabled-btn' : ''}}" bindtap="compare">对比已选的 {{selected.length}} 种</button><button class="primary-btn" bindtap="danger">发生接触或不适？进行安全判断</button></view>
  <view class="safe-note guidebook-note">图鉴内容仅用于外形与环境对照，不构成虫种确诊或医疗建议。</view>
</view>
