.guidebook-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.catalog-overview{display:flex;align-items:center;gap:24rpx;margin-top:24rpx;padding:32rpx;border:1rpx solid rgba(36,74,56,.08);border-radius:36rpx;background:#fff;color:#1e2923;box-shadow:0 12rpx 32rpx rgba(31,66,49,.07)}.catalog-overview-copy{flex:1;min-width:0}.catalog-eyebrow{margin-bottom:10rpx;color:#2f7d5b;font-size:var(--font-caption);font-weight:600}.catalog-overview .h2{color:#1e2923;font-size:var(--font-section-title);line-height:1.35}.catalog-description{margin-top:14rpx;color:#68756f;font-size:var(--font-caption);line-height:1.65}.catalog-count{display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;width:116rpx;height:116rpx;border:1rpx solid #dbe9e1;border-radius:32rpx;background:#eef6f1}.catalog-count-number{color:#2f7d5b;font-size:var(--font-page-title);font-weight:800;line-height:1}.catalog-count-label{margin-top:8rpx;color:#718078;font-size:var(--font-micro)}.guidebook-page>.field{margin-top:26rpx}.guide-notice{align-items:flex-start;margin-top:28rpx}.guide-notice-title{font-size:var(--font-body);font-weight:700}.guide-notice .tiny{margin-top:6rpx;line-height:1.6}
.insect-grid{display:flex;flex-direction:column;gap:24rpx}
.insect-card{display:flex;padding:22rpx;position:relative;border-radius:36rpx}
.insect-image{width:190rpx;height:190rpx;flex:none;border-radius:28rpx;background:#f2f4f2;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
/* 实物照片铺满卡片图片区 */
.species-photo{width:100%;height:100%;display:block}
/* 已选：绿底白勾，照片上也看得清 */
.check{position:absolute;right:12rpx;top:12rpx;width:44rpx;height:44rpx;border-radius:50%;box-shadow:0 2rpx 10rpx rgba(0,0,0,.25)}
.species-svg{width:118rpx;height:118rpx;display:block}
.keyword-clear{font-size:var(--font-body);padding-left:12rpx}
.empty-state{margin-top:24rpx;text-align:center}
.empty-state .tiny{margin-top:10rpx}
.empty-reset{display:inline-flex;margin-top:22rpx;padding:14rpx 26rpx;border-radius:28rpx;background:#e2eee6;color:#2f7d5b;font-size:var(--font-caption);font-weight:600}.insect-card-copy{flex:1;min-width:0;margin-left:24rpx}.insect-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.insect-name{font-size:var(--font-card-title)}.insect-latin{margin-top:4rpx;overflow:hidden;color:#969e99;font-size:var(--font-micro);text-overflow:ellipsis;white-space:nowrap}.type-badge{flex:none;padding:7rpx 12rpx;border-radius:18rpx;background:#eef5f0;color:#39795d;font-size:var(--font-micro)}.insect-meta{margin-top:14rpx;color:#637069;font-size:var(--font-caption)}.insect-summary{display:-webkit-box;margin-top:9rpx;overflow:hidden;color:#89928d;font-size:var(--font-caption);line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.insect-card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:15rpx}.detail-link{color:#537064;font-size:var(--font-caption)}.select-button{padding:10rpx 18rpx;border-radius:22rpx;background:#f0f1f3;color:#6f7873;font-size:var(--font-caption);font-weight:600}.select-button.selected{background:#2f7d5b;color:#fff}.guidebook-actions{display:flex;flex-direction:column;gap:18rpx;margin-top:36rpx}.guidebook-note{margin-top:24rpx;padding:0 22rpx}

/* 返回按钮：白底圆形 + 柔和阴影，与参考图一致 */
.back{box-shadow:0 6rpx 20rpx rgba(31,42,37,.10)}
