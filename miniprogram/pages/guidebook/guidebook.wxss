.insect-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.insect-card{padding:24rpx;position:relative}.insect-image{height:180rpx;border-radius:30rpx;background:#f2f4f2;display:flex;align-items:center;justify-content:center;position:relative}.check{position:absolute;right:10rpx;top:10rpx;width:44rpx;height:44rpx}.select-hit{position:absolute;inset:0}.species-svg{width:118rpx;height:118rpx;display:block}
