.insect-grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}
.insect-card{padding:24rpx;position:relative}
.insect-image{height:180rpx;border-radius:30rpx;background:#f2f4f2;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
/* 实物照片铺满卡片图片区 */
.species-photo{width:100%;height:100%;display:block}
/* 照片上也要看得清，加一圈白底 */
.check{position:absolute;right:10rpx;top:10rpx;width:44rpx;height:44rpx;background:#fff;border-radius:50%;padding:4rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.2)}
/* 只有图片右上角这一小块用于勾选，卡片其余部分点开详情 */
.select-hit{position:absolute;right:0;top:0;width:88rpx;height:88rpx}
.species-svg{width:118rpx;height:118rpx;display:block}
.keyword-clear{font-size:24rpx;padding-left:12rpx}
.empty-state{margin-top:24rpx;text-align:center}
.empty-state .tiny{margin-top:10rpx}
