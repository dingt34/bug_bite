/* 个人档案页：对齐参考稿的轻盈、留白与卡片层次。 */
.page {
  padding: 24rpx 36rpx 52rpx;
  background: #f7f7fb;
}

.safe-top {
  min-height: 18rpx;
}

.topbar {
  height: 88rpx;
}

.top-title {
  margin-left: 24rpx;
}

.top-title-main {
  font-size: 46rpx;
  letter-spacing: -1rpx;
}

.back .figma-back {
  width: 32rpx;
  height: 32rpx;
}

.profile-menu {
  margin-left: auto;
  width: 106rpx;
  height: 56rpx;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(31, 42, 37, .04);
}

.profile-menu image {
  width: 12rpx;
  height: 12rpx;
}

.notice {
  gap: 20rpx;
  min-height: 112rpx;
  padding: 22rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 37, .06);
}

.notice .muted {
  font-size: 24rpx;
  line-height: 1.45;
}

.notice .tiny {
  margin-top: 4rpx;
  line-height: 1.4;
}

.section-title {
  margin: 44rpx 0 20rpx;
}

.basic-section-title {
  font-size: 40rpx;
}

.profile-main-field {
  width: calc(100% + 16rpx);
  margin-left: -8rpx;
}

.field {
  height: 112rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 37, .055);
}

.field-value {
  font-size: 30rpx;
}

.region-value {
  position: relative;
  top: -2rpx;
  left: 8rpx;
}

.region-list {
  height: 300rpx;
  margin: 12rpx 0 0;
  padding: 8rpx 12rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 37, .07);
}

.region-option {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #68756f;
  font-size: 26rpx;
  line-height: 68rpx;
}

.region-option-on {
  background: #e2eee6;
  color: #2f7d5b;
  font-weight: 600;
}

.card.card-pad {
  padding: 28rpx;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 37, .055);
}

.health-card {
  padding: 28rpx 28rpx 22rpx;
}

.health-summary {
  align-items: flex-start;
}

.health-summary .tiny {
  margin-top: 8rpx;
  line-height: 1.4;
}

.health-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.health-input {
  width: 230rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 34rpx;
  background: #f0f1f3;
  color: #8c8f96;
  font-size: 22rpx;
  text-align: center;
}

.health-skip {
  color: #a4a7ad;
  font-size: 22rpx;
}

.primary-btn {
  height: 104rpx;
  border-radius: 52rpx;
  box-shadow: 0 12rpx 26rpx rgba(31, 42, 37, .14);
}

.safe-note {
  color: #a4a7ad;
}
