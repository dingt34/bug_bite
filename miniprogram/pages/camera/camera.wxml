<view class="camera-page">
  <view class="camera-stage">
    <camera wx:if="{{!photo && !usePlaceholder}}" class="camera-native" device-position="back" flash="{{flash}}" binderror="error"></camera>
    <image wx:elif="{{photo}}" class="camera-native" src="{{photo}}" mode="aspectFill"/>
    <image wx:else class="camera-native" src="/assets/figma/all/s17-bg-nature.svg" mode="aspectFill"/>

    <view class="camera-overlay">
      <view class="camera-head"><view class="camera-home-button" bindtap="home">返回首页</view></view>
      <view class="focus-box">
        <image class="focus-frame" src="/assets/figma/all/s17-imgFrame1.svg" mode="aspectFill"/>
        <view wx:if="{{error}}" class="camera-error">{{error}}<text class="block-break"></text>请在设置中允许摄像头权限</view>
      </view>
      <view class="camera-copy">
        <view>将虫体或接触区域置于框内</view>
        <view class="tiny" style="color:#fff">请确保光线充足、画面清晰</view>
      </view>
      <view class="shutter-row">
        <view class="round-action" bindtap="guidebook"><image class="icon-svg" src="/assets/figma/all/s17-imgBug1.svg" mode="aspectFit"/><text>图鉴</text></view>
        <view class="shutter" bindtap="shutter"><image class="shutter-outer" src="/assets/figma/all/s17-imgEllipse1.svg"/><image class="shutter-inner" src="/assets/figma/all/s17-imgEllipse2.svg"/></view>
        <view class="round-action" bindtap="album"><image class="icon-svg" src="/assets/figma/all/s17-imgFrame2.svg" mode="aspectFit"/><text>相册</text></view>
      </view>
    </view>
  </view>

  <view class="camera-sheet">
    <view class="grabber"></view>
    <view class="h2">这张照片用于什么？</view>
    <view class="muted camera-sheet-subtitle">你来决定识别对象，系统不会自行猜测</view>
    <view class="camera-choice-list">
      <view class="card card-pad row camera-choice-card" bindtap="identify">
        <view class="circle circle-green camera-choice-icon"><image class="icon-svg" src="/assets/figma/s17-imgBug1.svg" mode="aspectFit"/></view>
        <view class="camera-choice-copy">
          <view class="h3 camera-choice-title">{{identifying?'正在识别…':'虫体识别'}}</view>
          <view class="tiny">{{identifying && recognitionStage ? recognitionStage : '本机 BioCLIP 比对，不上传图片'}}</view>
        </view>
        <image class="camera-choice-arrow" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/>
      </view>
      <view class="card card-pad row camera-choice-card" bindtap="record">
        <view class="circle circle-red camera-choice-icon"><image class="icon-svg" src="/assets/figma/s17-img3.svg" mode="aspectFit"/></view>
        <view class="camera-choice-copy">
          <view class="h3 camera-choice-title">皮损安全记录</view>
          <view class="tiny">记录接触与症状变化，不作诊断</view>
        </view>
        <image class="camera-choice-arrow" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/>
      </view>
    </view>

    <view wx:if="{{recognitionResultReady}}" class="card card-pad recognition-result-entry" bindtap="openRecognitionResult">
      <view class="recognition-result-copy">
        <view class="h3">最近一次分析</view>
        <view class="tiny recognition-result-summary">{{recognitionSummary}}</view>
      </view>
      <text class="recognition-result-link">查看结果</text>
    </view>

    <view class="camera-actions">
      <button class="retake-button" bindtap="retake">重新拍摄</button>
      <button class="danger-btn camera-danger-button" bindtap="danger">症状正在快速加重？进入安全判断</button>
    </view>
  </view>

  <view wx:if="{{recognitionModalVisible}}" class="recognition-modal-mask" catchtap="closeRecognitionResult">
    <view class="recognition-modal" catchtap="noop">
      <view class="recognition-modal-head">
        <view>
          <view class="recognition-modal-title">BioCLIP 2 本地演示</view>
          <view class="recognition-modal-subtitle">开发者工具本机运行 · 比对 45 种图鉴 · 图片不上传</view>
        </view>
        <view class="recognition-modal-close" bindtap="closeRecognitionResult" aria-label="关闭">×</view>
      </view>
      <scroll-view class="recognition-modal-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{candidates.length}}" class="recognition-intro">根据照片可见特征，整理出以下候选方向</view>
        <view wx:for="{{candidates}}" wx:key="objectId" class="recognition-candidate-card">
          <view class="recognition-candidate-head">
            <view class="recognition-rank">候选 {{item.rank}}</view>
            <view wx:if="{{item.scoreText}}" class="recognition-score">匹配 {{item.scoreText}}</view>
          </view>
          <image wx:if="{{item.photo}}" class="recognition-candidate-image" src="{{item.photo}}" mode="aspectFill"/>
          <view class="recognition-candidate-name">{{item.name}}</view>
          <view wx:if="{{item.scientificName}}" class="recognition-candidate-latin">{{item.scientificName}}</view>
          <view wx:if="{{item.summary}}" class="recognition-candidate-summary">{{item.summary}}</view>
          <view wx:if="{{item.scoreText}}" class="recognition-score-note">匹配分数仅用于候选排序</view>
        </view>

        <view wx:if="{{!candidates.length}}" class="recognition-empty">
          <view class="recognition-section-title">照片信息不足</view>
          <view class="recognition-section-copy">请补拍虫体整体、足部、翅和体节，或直接进入安全判断。</view>
        </view>

        <view wx:if="{{visibleFeatures.length}}" class="recognition-section">
          <view class="recognition-section-title">照片中可见的特征</view>
          <view class="recognition-feature-list">
            <view wx:for="{{visibleFeatures}}" wx:key="*this" class="recognition-feature">{{item}}</view>
          </view>
        </view>
        <view wx:if="{{uncertainty}}" class="recognition-section">
          <view class="recognition-section-title">不确定性</view>
          <view class="recognition-section-copy">{{uncertainty}}</view>
        </view>
        <view class="recognition-disclaimer">{{recognitionDisclaimer}}</view>
      </scroll-view>
      <view class="recognition-modal-actions">
        <button class="recognition-modal-secondary" bindtap="closeRecognitionResult">返回拍摄</button>
        <button class="recognition-modal-primary" bindtap="startSafetyRecord">继续安全判断</button>
      </view>
    </view>
  </view>
</view>
