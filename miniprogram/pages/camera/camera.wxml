<view class="camera-page"><view class="camera-stage"><camera wx:if="{{!photo}}" class="camera-native" device-position="back" flash="{{flash}}" binderror="error"></camera><image wx:else class="camera-native" src="{{photo}}" mode="aspectFill"/>
<view class="camera-overlay"><view class="between camera-head"><view class="h2" style="color:#fff">识别</view></view><view class="focus-box"><image class="focus-frame" src="/assets/figma/all/s17-imgFrame1.svg" mode="aspectFill"/><view wx:if="{{error}}" class="camera-error">{{error}}<text class="block-break"></text>请在设置中允许摄像头权限</view></view><view class="camera-copy"><view>将虫体或接触区域置于框内</view><view class="tiny" style="color:#fff">请确保光线充足、画面清晰</view></view><view class="shutter-row"><view class="round-action" bindtap="guidebook"><image class="icon-svg" src="/assets/figma/all/s17-imgBug1.svg" mode="aspectFit"/><text>图鉴</text></view><view class="shutter" bindtap="shutter"><image class="shutter-outer" src="/assets/figma/all/s17-imgEllipse1.svg"/><image class="shutter-inner" src="/assets/figma/all/s17-imgEllipse2.svg"/></view><view class="round-action" bindtap="album"><image class="icon-svg" src="/assets/figma/all/s17-imgFrame2.svg" mode="aspectFit"/><text>相册</text></view></view></view></view>
<view class="camera-sheet"><view class="grabber"></view><view class="h2">这张照片用于什么？</view><view class="muted">你来决定识别对象，系统不会自行猜测</view><view class="camera-choices"><view class="card card-pad row" bindtap="identify"><view class="circle circle-green" style="width:72rpx;height:72rpx"><image class="icon-svg" src="/assets/figma/s17-imgBug1.svg" mode="aspectFit"/></view><view style="margin-left:20rpx"><view class="h3">{{identifying?'正在识别…':'虫体识别'}}</view><view class="tiny">千问多模态 · 45 项知识库对比</view></view></view><view wx:if="{{candidates.length || visibleFeatures.length || uncertainty}}" class="card card-pad candidate-card"><view class="h3">候选结果</view><view class="tiny" wx:for="{{candidates}}" wx:key="objectId">{{index+1}}. {{item.name}}<text wx:if="{{item.scientificName}}"> · {{item.scientificName}}</text></view><view wx:if="{{visibleFeatures.length}}" class="tiny result-features">可见特征：{{visibleFeaturesText}}</view><view wx:if="{{uncertainty}}" class="tiny result-features">{{uncertainty}}</view><view class="safe-note">仅作为图鉴线索，不用于确诊或安全分级</view></view><view class="card card-pad row" bindtap="record"><view class="circle circle-red" style="width:72rpx;height:72rpx"><image class="icon-svg" src="/assets/figma/s17-img3.svg" mode="aspectFit"/></view><view style="margin-left:20rpx"><view class="h3">皮损安全记录</view><view class="tiny">不做疾病诊断</view></view></view></view><button class="danger-btn" bindtap="danger">症状正在快速加重？直接进入安全判断</button><view class="safe-note" style="margin-top:20rpx" bindtap="retake">重新拍摄</view></view></view>
