<view class="camera-page">
  <view class="camera-stage">
    <image wx:if="{{photo}}" class="camera-native" src="{{photo}}" mode="aspectFill"/>
    <!-- 模拟器 / 摄像头不可用时显示设计稿的自然主题插画 -->
    <image wx:elif="{{usePlaceholder}}" class="camera-native" src="/assets/figma/all/s17-bg-nature.svg" mode="aspectFill"/>
    <camera wx:else class="camera-native" device-position="back" flash="{{flash}}" binderror="error"></camera>

    <view class="camera-overlay">
      <view class="between camera-head">
        <view class="h2" style="color:#fff">识别</view>
      </view>

      <view class="focus-box">
        <!-- 虫体剪影单独放在取景框内，不随背景缩放跑位 -->
        <image wx:if="{{usePlaceholder && !photo}}" class="focus-bug" src="/assets/figma/all/s17-bug-silhouette.svg" mode="aspectFit"/>
        <image class="focus-frame" src="/assets/figma/all/s17-imgFrame1.svg" mode="aspectFill"/>
        <view wx:if="{{error}}" class="camera-error">{{error}}<text class="block-break"></text>请在设置中允许摄像头权限</view>
      </view>

      <view class="camera-copy">
        <view>将虫体或接触区域置于框内</view>
        <view class="tiny" style="color:#fff">请确保光线充足、画面清晰</view>
      </view>

      <view class="shutter-row">
        <view class="round-action" bindtap="guidebook">
          <image class="icon-svg large" src="/assets/figma/all/s17-icon-guidebook.svg" mode="aspectFit"/>
          <text>图鉴</text>
        </view>
        <view class="shutter" bindtap="shutter">
          <image class="shutter-outer" src="/assets/figma/all/s17-imgEllipse1.svg"/>
          <image class="shutter-inner" src="/assets/figma/all/s17-imgEllipse2.svg"/>
        </view>
        <view class="round-action" bindtap="album">
          <image class="icon-svg" src="/assets/figma/all/s17-imgFrame2.svg" mode="aspectFit"/>
          <text>相册</text>
        </view>
      </view>
    </view>
  </view>

  <view class="camera-sheet">
    <view class="grabber"></view>
    <view class="h2">这张照片用于什么？</view>
    <view class="muted">你来决定识别对象，系统不会自行猜测</view>

    <view class="camera-choices">
      <view class="card card-pad choice" bindtap="identify">
        <view class="circle circle-green choice-icon">
          <image class="icon-svg small" src="/assets/figma/all/s17-icon-bug.svg" mode="aspectFit"/>
        </view>
        <view class="choice-text">
          <view class="choice-title">{{identifying ? '正在识别…' : '虫体识别'}}</view>
          <view class="tiny">千问多模态 · 45 项知识库对比</view>
        </view>
      </view>

      <view class="card card-pad choice" bindtap="record">
        <view class="circle circle-red choice-icon">
          <image class="icon-svg small" src="/assets/figma/all/s17-img3.svg" mode="aspectFit"/>
        </view>
        <view class="choice-text">
          <view class="choice-title">皮损安全记录</view>
          <view class="tiny">不做疾病诊断</view>
        </view>
      </view>

      <view wx:if="{{candidates.length || visibleFeatures.length || uncertainty}}" class="card card-pad candidate-card">
        <view class="h3">候选结果</view>
        <view class="tiny candidate-row" wx:for="{{candidates}}" wx:key="objectId" data-id="{{item.objectId}}" bindtap="openCandidate">
          {{index + 1}}. {{item.name}}<text wx:if="{{item.scientificName}}"> · {{item.scientificName}}</text>
        </view>
        <view wx:if="{{visibleFeatures.length}}" class="tiny result-features">可见特征：{{visibleFeaturesText}}</view>
        <view wx:if="{{uncertainty}}" class="tiny result-features">{{uncertainty}}</view>
        <view class="safe-note">仅作为图鉴线索，不用于确诊或安全分级</view>
      </view>
    </view>

    <button class="danger-btn" bindtap="danger">症状正在快速加重？直接进入安全判断</button>
    <view class="safe-note" style="margin-top:20rpx" bindtap="retake">重新拍摄</view>
  </view>
</view>
