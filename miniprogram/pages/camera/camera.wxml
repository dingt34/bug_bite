<view class="camera-page"><view class="camera-stage"><camera wx:if="{{!photo && !usePlaceholder}}" class="camera-native" device-position="back" flash="{{flash}}" binderror="error"></camera><image wx:elif="{{photo}}" class="camera-native" src="{{photo}}" mode="aspectFill"/><image wx:else class="camera-native" src="/assets/figma/all/s17-bg-nature.svg" mode="aspectFill"/>
<view class="camera-overlay"><view class="camera-head"><view class="camera-home-button" bindtap="home">返回首页</view></view><view class="focus-box"><image class="focus-frame" src="/assets/figma/all/s17-imgFrame1.svg" mode="aspectFill"/><view wx:if="{{error}}" class="camera-error">{{error}}<text class="block-break"></text>请在设置中允许摄像头权限</view></view><view class="camera-copy"><view>将虫体或接触区域置于框内</view><view class="tiny" style="color:#fff">请确保光线充足、画面清晰</view></view><view class="shutter-row"><view class="round-action" bindtap="guidebook"><image class="icon-svg" src="/assets/figma/all/s17-imgBug1.svg" mode="aspectFit"/><text>图鉴</text></view><view class="shutter" bindtap="shutter"><image class="shutter-outer" src="/assets/figma/all/s17-imgEllipse1.svg"/><image class="shutter-inner" src="/assets/figma/all/s17-imgEllipse2.svg"/></view><view class="round-action" bindtap="album"><image class="icon-svg" src="/assets/figma/all/s17-imgFrame2.svg" mode="aspectFit"/><text>相册</text></view></view></view></view>
<view class="camera-sheet"><view class="grabber"></view><view class="h2">这张照片用于什么？</view><view class="muted camera-sheet-subtitle">你来决定识别对象，系统不会自行猜测</view><view class="camera-choice-list"><view class="card card-pad row camera-choice-card" bindtap="identify"><view class="circle circle-green camera-choice-icon"><image class="icon-svg" src="/assets/figma/s17-imgBug1.svg" mode="aspectFit"/></view><view class="camera-choice-copy"><view class="h3 camera-choice-title">{{identifying?'正在识别…':'虫体识别'}}</view><view class="tiny">对照知识库特征，返回候选对象</view></view><image class="camera-choice-arrow" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/></view><view class="card card-pad row camera-choice-card" bindtap="record"><view class="circle circle-red camera-choice-icon"><image class="icon-svg" src="/assets/figma/s17-img3.svg" mode="aspectFit"/></view><view class="camera-choice-copy"><view class="h3 camera-choice-title">皮损安全记录</view><view class="tiny">记录接触与症状变化，不作诊断</view></view><image class="camera-choice-arrow" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/></view></view><view wx:if="{{candidates.length || visibleFeatures.length || uncertainty}}" class="card card-pad candidate-card"><view class="h3">候选结果</view><view class="tiny candidate-item" wx:for="{{candidates}}" wx:key="objectId">{{index+1}}. {{item.name}}<text wx:if="{{item.scientificName}}"> · {{item.scientificName}}</text></view><view wx:if="{{visibleFeatures.length}}" class="tiny result-features">可见特征：{{visibleFeaturesText}}</view><view wx:if="{{uncertainty}}" class="tiny result-features">{{uncertainty}}</view><view class="safe-note candidate-note">仅作为图鉴线索，不用于确诊或安全分级</view></view><view class="camera-actions"><button class="retake-button" bindtap="retake">重新拍摄</button><button class="danger-btn camera-danger-button" bindtap="danger">症状正在快速加重？进入安全判断</button></view></view></view>
