.camera-page{min-height:100vh;background:#163f2d}.camera-stage{position:relative;height:62vh;min-height:940rpx;background:#163f2d;overflow:hidden}.camera-native{position:absolute;inset:0;width:100%;height:100%}.camera-overlay{position:absolute;inset:0;background:rgba(12,55,35,.28);padding:44rpx 36rpx}.camera-head{position:relative;z-index:3}.focus-box{position:absolute;left:176rpx;top:260rpx;width:400rpx;height:400rpx}.focus-frame{position:absolute;inset:0;width:100%;height:100%}.camera-error{position:absolute;left:0;right:0;top:150rpx;text-align:center;color:#fff}.camera-copy{position:absolute;left:0;right:0;bottom:210rpx;text-align:center;color:#fff;font-weight:700}.shutter-row{position:absolute;left:70rpx;right:70rpx;bottom:50rpx;display:flex;align-items:center;justify-content:space-between}.round-action{width:110rpx;height:110rpx;border-radius:50%;background:#fff;color:#2f7d5b;display:flex;align-items:center;justify-content:center;flex-direction:column}.round-action text{position:absolute;margin-top:150rpx;color:#b9c8c1;font-size:20rpx}.shutter{width:154rpx;height:154rpx;position:relative;display:flex;align-items:center;justify-content:center}.shutter-outer{position:absolute;inset:0;width:100%;height:100%}.shutter-inner{position:absolute;width:120rpx;height:120rpx}.camera-sheet{position:relative;margin-top:-2rpx;min-height:38vh;background:#f7f7fb;border-radius:46rpx 46rpx 0 0;padding:22rpx 36rpx 180rpx}.grabber{width:80rpx;height:8rpx;border-radius:4rpx;background:#c8cbc8;margin:0 auto 30rpx}.camera-choices{display:grid;grid-template-columns:1fr 1fr;gap:24rpx;margin:34rpx 0}.camera-choices .card{padding:24rpx}
.candidate-card{grid-column:1/3}.result-features{margin-top:14rpx;line-height:1.6}
