.camera-page{min-height:100vh;background:#163f2d}.camera-stage{position:relative;height:62vh;min-height:940rpx;background:#163f2d;overflow:hidden}.camera-native{position:absolute;inset:0;width:100%;height:100%}.camera-overlay{position:absolute;inset:0;background:rgba(12,55,35,.28);padding:44rpx 36rpx}.camera-head{position:relative;z-index:3;padding-top:calc(env(safe-area-inset-top) + 24rpx)}.focus-box{position:absolute;left:176rpx;top:260rpx;width:400rpx;height:400rpx}.focus-frame{position:absolute;inset:0;width:100%;height:100%}.camera-error{position:absolute;left:0;right:0;top:150rpx;text-align:center;color:#fff}.camera-copy{position:absolute;left:0;right:0;bottom:210rpx;text-align:center;color:#fff;font-weight:700}.shutter-row{position:absolute;left:70rpx;right:70rpx;bottom:50rpx;display:flex;align-items:center;justify-content:space-between}.round-action{width:110rpx;height:110rpx;border-radius:50%;background:#fff;color:#2f7d5b;display:flex;align-items:center;justify-content:center;flex-direction:column}.round-action text{position:absolute;margin-top:150rpx;color:#b9c8c1;font-size:var(--font-caption)}.shutter{width:154rpx;height:154rpx;position:relative;display:flex;align-items:center;justify-content:center}.shutter-outer{position:absolute;inset:0;width:100%;height:100%}.shutter-inner{position:absolute;width:120rpx;height:120rpx}.camera-sheet{position:relative;margin-top:-2rpx;min-height:38vh;background:#f7f7fb;border-radius:46rpx 46rpx 0 0;padding:22rpx 36rpx 180rpx}.grabber{width:80rpx;height:8rpx;border-radius:4rpx;background:#c8cbc8;margin:0 auto 30rpx}.camera-sheet-subtitle{margin-top:8rpx;line-height:1.55}.camera-choice-list{display:block;width:100%;margin:30rpx 0}.camera-choice-list>.camera-choice-card{display:flex;width:100%;margin:0 0 20rpx;padding:26rpx}.camera-choice-list>.camera-choice-card:last-of-type{margin-bottom:0}
.candidate-card{width:100%}.candidate-item{margin-top:12rpx;line-height:1.55}.candidate-note{margin-top:18rpx}.result-features{margin-top:14rpx;line-height:1.6}
.camera-choice-card{min-height:124rpx}.camera-choice-icon{width:72rpx;height:72rpx;flex:none}.camera-choice-copy{flex:1;min-width:0;margin-left:20rpx}.camera-choice-title{font-size:var(--font-card-title);letter-spacing:-1rpx;line-height:1.3}.camera-choice-copy .tiny{margin-top:6rpx;line-height:1.5}.camera-choice-arrow{width:28rpx;height:28rpx;flex:none;margin-left:16rpx;opacity:.55}
.camera-home-button{display:inline-flex;align-items:center;height:64rpx;padding:0 24rpx;border:2rpx solid rgba(255,255,255,.82);border-radius:32rpx;background:rgba(14,52,35,.58);color:#fff;font-size:var(--font-body);line-height:1;}
.camera-actions{display:flex;flex-direction:column;gap:18rpx;width:100%;margin-top:8rpx}.retake-button,.camera-danger-button{position:relative;display:flex;width:100%;min-height:92rpx;margin:0;padding:18rpx 28rpx;align-items:center;justify-content:center;border-radius:46rpx;font-size:var(--font-card-title);font-weight:700;line-height:1.35}.retake-button{border:0;background:#1e2021;color:#fff}.camera-danger-button{height:auto;background:#ea4038;color:#fff}

/* 两个拍照用途入口保持左右并列，窄屏下也不会被内容撑破 */
.camera-choice-list{display:flex;gap:16rpx}
.camera-choice-list>.camera-choice-card{position:relative;display:flex;flex:1;flex-direction:column;align-items:flex-start;width:auto;min-width:0;margin:0;padding:22rpx 18rpx}
.camera-choice-card{min-height:250rpx}
.camera-choice-icon{flex:none}
.camera-choice-copy{width:100%;flex:1;min-width:0;margin:16rpx 0 0}
.camera-choice-title{padding-right:26rpx}
.camera-choice-arrow{position:absolute;top:28rpx;right:18rpx;margin-left:0}

/* 卡片内部保持图标在左、文字在右 */
.camera-choice-list>.camera-choice-card{flex-direction:row;align-items:center;min-height:170rpx}
.camera-choice-copy{width:auto;flex:1;margin:0 0 0 14rpx}
.camera-choice-title{padding-right:0}
.camera-choice-arrow{top:50%;transform:translateY(-50%)}

.recognition-result-entry{display:flex;align-items:center;gap:20rpx;margin:0 0 20rpx;border:2rpx solid #dce9e2;background:#fff}.recognition-result-copy{flex:1;min-width:0}.recognition-result-summary{margin-top:8rpx;line-height:1.55}.recognition-result-link{flex:none;color:#2f7d5b;font-size:var(--font-caption);font-weight:700}
.recognition-modal-mask{position:fixed;z-index:1000;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:24rpx;background:rgba(18,29,23,.58)}
.recognition-modal{display:flex;flex-direction:column;width:100%;height:86vh;max-height:1180rpx;overflow:hidden;padding:30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:36rpx;background:#f5f7f6;box-shadow:0 -18rpx 60rpx rgba(17,45,31,.2)}
.recognition-modal-head{display:flex;flex:none;align-items:flex-start;justify-content:space-between;gap:24rpx;padding:0 2rpx 24rpx;border-bottom:2rpx solid #e3e9e6}.recognition-modal-head>view:first-child{flex:1;min-width:0}.recognition-modal-title{color:#1e2c25;font-size:var(--font-section-title);font-weight:800;line-height:1.3}.recognition-modal-subtitle{margin-top:8rpx;color:#7b8881;font-size:var(--font-caption);line-height:1.45}.recognition-modal-close{display:flex;flex:none;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:50%;background:#e8efeb;color:#52645a;font-size:var(--font-section-title);line-height:1}
.recognition-modal-scroll{flex:1;min-height:0;margin:20rpx 0}.recognition-intro{margin-bottom:18rpx;color:#68776f;font-size:var(--font-caption);line-height:1.55}.recognition-candidate-card{margin-bottom:20rpx;padding:20rpx;border:2rpx solid #e1e8e4;border-radius:28rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(32,52,42,.05)}.recognition-candidate-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.recognition-rank,.recognition-score{display:inline-flex;align-items:center;min-height:44rpx;padding:0 14rpx;border-radius:22rpx;font-size:var(--font-micro);font-weight:700}.recognition-rank{background:#e3f1e9;color:#276c4f}.recognition-score{background:#fff2d7;color:#87621e}.recognition-candidate-image{display:block;width:100%;height:280rpx;border-radius:20rpx;background:#e7ece9}.recognition-candidate-name{margin-top:18rpx;color:#1e2c25;font-size:var(--font-card-title);font-weight:800;line-height:1.35}.recognition-candidate-latin{margin-top:4rpx;overflow:hidden;color:#6f7d75;font-size:var(--font-caption);font-style:italic;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}.recognition-candidate-summary{margin-top:12rpx;color:#44554c;font-size:var(--font-body);line-height:1.65}.recognition-score-note{margin-top:12rpx;color:#9a8970;font-size:var(--font-micro);line-height:1.4}.recognition-section,.recognition-empty{margin-top:20rpx;padding:22rpx;border-radius:24rpx;background:#fff}.recognition-section-title{color:#26372e;font-size:var(--font-card-title);font-weight:800;line-height:1.4}.recognition-section-copy{margin-top:10rpx;color:#58675f;font-size:var(--font-body);line-height:1.65}.recognition-feature-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.recognition-feature{max-width:100%;padding:10rpx 16rpx;border-radius:20rpx;background:#eaf4ee;color:#37674f;font-size:var(--font-caption);line-height:1.45}.recognition-disclaimer{margin:20rpx 0 8rpx;padding:20rpx;border-left:6rpx solid #69a891;border-radius:0 20rpx 20rpx 0;background:#e7f2ec;color:#486157;font-size:var(--font-caption);line-height:1.6}
.recognition-modal-actions{display:flex;gap:16rpx;padding-top:20rpx;border-top:2rpx solid #e3e9e6}.recognition-modal-secondary,.recognition-modal-primary{display:flex;align-items:center;justify-content:center;min-height:88rpx;margin:0;border-radius:44rpx;font-size:var(--font-body);font-weight:700;line-height:1.3}.recognition-modal-secondary{flex:0 0 34%;border:2rpx solid #cbd9d1;background:#fff;color:#37614b}.recognition-modal-primary{flex:1;border:0;background:#1e2021;color:#fff}
