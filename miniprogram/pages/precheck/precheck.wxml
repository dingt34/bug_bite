<view class="page precheck-page">
  <view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s08-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">行前准备</view><view class="top-title-sub">建立一份新的户外计划</view></view><view class="top-action" bindtap="save">保存草稿</view></view>
  <view class="card precheck-hero"><view class="hero-copy"><view class="h3">{{destination || '下一次出发，从准备开始'}}</view><view class="muted">{{activity || '填写目的地、日期和活动'}} · 浙江地区参考</view></view><view class="route-art"></view></view>
  <view class="section-title"><text>基本信息</text><text class="aside">三项必填</text></view>
  <view class="stack gap-12">
    <view class="card destination-card"><view class="field"><text class="field-label">目的地</text><input class="field-value" value="{{destination}}" bindinput="inputDestination" maxlength="80" placeholder="输入城市或地点" /></view><button class="text-button map-button" bindtap="chooseDestination">也可从地图选择</button></view>
    <picker mode="date" start="{{minDate}}" value="{{dateValue || minDate}}" bindchange="chooseDate"><view class="field"><text class="field-label">出发日期</text><text class="field-value">{{date || '请选择日期'}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view></picker>
    <view class="field" bindtap="chooseActivity"><text class="field-label">活动类型</text><text class="field-value">{{activity || '请选择活动'}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view>
  </view>
  <view class="section-title"><text>补充环境</text><text class="aside">选填，可跳过</text></view>
  <view class="card card-pad"><view class="row" bindtap="editEnvironment"><image class="figma-icon md" src="/assets/figma/all/s08-imgIconGeneratedIllustrated.svg"/><view class="grow environment-copy"><view>生境、过夜与同行情况</view><view class="tiny">{{environmentText}}</view></view><text class="green-text">{{expanded?'收起':'展开'}}</text></view>
    <view wx:if="{{expanded}}" class="chip-row environment-options"><view wx:for="{{environmentOptions}}" wx:key="value" class="chip {{item.selected?'active':''}}" data-value="{{item.value}}" bindtap="toggleEnvironment">{{item.value}}</view></view>
  </view>
  <view class="card card-pad route-card"><view class="row" bindtap="route"><image class="figma-icon lg" src="/assets/figma/all/s08-img1.svg"/><view class="grow environment-copy"><view class="h3">路线预览（选填）</view><view class="tiny">{{route?route.summary:'不规划路线也可生成行前清单'}}</view></view><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view><view class="tiny route-warning">当前路线模块为演示预览，示例距离不会作为实际行程保存。</view><button wx:if="{{route}}" class="text-button" bindtap="removeRoute">移除路线预览</button></view>
  <view class="form-footer"><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="generate">生成行前清单</button><view class="safe-note">{{saveStatus}}<text class="block-break"></text>地区化内容以浙江为范围；清单不代表目的地风险预测。</view></view>
</view>
