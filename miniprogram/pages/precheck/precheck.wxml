<wxs src="./precheck.wxs" module="g" />
<view class="page">
  <view class="card route-card">
    <view class="card-title">路线规划 <text class="optional">选填</text></view>
    <view class="route-help">可直接填写具体地点，例如“浙江大学玉泉校区”到“西湖”；下方“目的地”仍可补充途经城市。</view>
    <view class="route-pickers">
      <view class="route-picker-wrap">
        <view class="route-label">起点</view>
        <input class="route-input" value="{{form.routeStart}}" placeholder="如：浙江大学玉泉校区" maxlength="40" bindinput="onRouteStartInput" />
      </view>
      <view class="route-arrow">→</view>
      <view class="route-picker-wrap">
        <view class="route-label">终点</view>
        <input class="route-input" value="{{form.routeEnd}}" placeholder="如：西湖" maxlength="40" bindinput="onRouteEndInput" />
      </view>
    </view>
    <button class="route-plan-button" loading="{{routeLoading}}" disabled="{{!form.routeStart || !form.routeEnd || routeLoading}}" bindtap="planRoute">{{routeLoading ? '正在规划…' : '在地图上规划路线'}}</button>
    <view class="route-message" wx:if="{{routeMessage}}">{{routeMessage}}</view>
    <map wx:if="{{routeOptions.length}}" class="route-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="{{mapScale}}" markers="{{routeMarkers}}" polyline="{{routePolylines}}" show-location="{{false}}"></map>
    <view class="route-options" wx:if="{{routeOptions.length}}">
      <view class="route-option {{selectedRouteIndex === index ? 'selected' : ''}}" wx:for="{{routeOptions}}" wx:key="id" bindtap="selectRoute" data-index="{{index}}">
        <view><text class="route-option-name">{{item.name}}</text><text class="route-option-detail">约 {{item.distanceText}} · {{item.durationText}}</text></view>
        <view class="route-option-state">{{selectedRouteIndex === index ? '当前查看' : '查看'}}</view>
      </view>
    </view>
    <view class="route-summary" wx:if="{{routePreview.summary}}">{{routePreview.summary}}</view>
    <view class="route-insects" wx:if="{{routePreview.insects.length}}">
      <view class="route-insects-title">沿途可能遇到</view>
      <view class="insect-item" wx:for="{{routePreview.insects}}" wx:key="name">
        <view class="insect-name">{{item.name}}</view>
        <view class="insect-reason">{{item.reason}}</view>
      </view>
      <view class="route-note">提示基于路线两端、季节和已选生境生成；实际情况以现场环境为准。</view>
    </view>
  </view>

  <!-- 必填：目的地（多选） -->
  <view class="card">
    <view class="card-title">目的地（可多选） <text class="required">*</text></view>
    <view class="chips">
      <text class="tag {{g.has(form.regionCodes, item) ? 'active' : ''}}" wx:for="{{regions}}" wx:key="*this" bindtap="onRegionTap" data-v="{{item}}">{{item}}</text>
    </view>
    <view class="selection-help">{{form.regionCodes.length ? '已选择 ' + form.regionCodes.length + ' 个地点' : '请选择本次行程会经过的浙江省内城市'}}</view>
  </view>

  <!-- 必填：月份 -->
  <view class="card">
    <view class="card-title">出行月份 <text class="required">*</text></view>
    <picker mode="selector" range="{{months}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker {{form.month ? '' : 'placeholder'}}">
        {{form.month || '选择月份'}}
      </view>
    </picker>
  </view>

  <!-- 必填：活动类型 -->
  <view class="card">
    <view class="card-title">活动类型 <text class="required">*</text></view>
    <view class="chips">
      <text class="tag {{form.activityType === item ? 'active' : ''}}" wx:for="{{activities}}" wx:key="*this" bindtap="onActivityTap" data-v="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 选填：生境 -->
  <view class="card">
    <view class="card-title">可能经过的生境 <text class="optional">选填</text></view>
    <view class="chips">
      <text class="tag {{g.has(form.habitatTags, item) ? 'active' : ''}}" wx:for="{{habitats}}" wx:key="*this" bindtap="onHabitatTap" data-v="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 选填：住宿方式 -->
  <view class="card">
    <view class="card-title">住宿方式 <text class="optional">选填</text></view>
    <view class="chips">
      <text class="tag {{form.overnight === item ? 'active' : ''}}" wx:for="{{overnights}}" wx:key="*this" bindtap="onOvernightTap" data-v="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 选填：同行人群 -->
  <view class="card">
    <view class="card-title">同行人群 <text class="optional">选填</text></view>
    <view class="chips">
      <text class="tag {{g.has(form.companionTags, item) ? 'active' : ''}}" wx:for="{{companions}}" wx:key="*this" bindtap="onCompanionTap" data-v="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 选填：已准备物品 -->
  <view class="card">
    <view class="card-title">已准备的物品 <text class="optional">选填</text></view>
    <view class="chips">
      <text class="tag {{g.has(form.gearTags, item) ? 'active' : ''}}" wx:for="{{gears}}" wx:key="*this" bindtap="onGearTap" data-v="{{item}}">{{item}}</text>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-wrap">
    <button class="btn-primary" disabled="{{!form.regionCodes.length || !form.month || !form.activityType}}" bindtap="submit">生成行前建议</button>
  </view>
  <view class="tip" style="margin: 0 24rpx 40rpx;">带 <text class="required">*</text> 为必填项。提交后生成当地风险提示与准备清单。</view>
</view>
