<view class="page">
  <view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s08-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">行前准备</view><view class="top-title-sub">建立一份新的户外计划</view></view><view class="top-action" bindtap="save">保存草稿</view></view>
  <view class="card precheck-hero"><view class="h3">丽水徒步露营</view><view class="muted">浙江范围内可生成地区化提示</view><view class="route-art"></view></view>
  <view class="section-title"><text>基本信息</text><text class="aside">三项必填</text></view>
  <view class="stack gap-12"><view class="field" bindtap="chooseDestination"><text class="field-label">目的地</text><text class="field-value">{{destination}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view><picker mode="date" start="{{minDate}}" value="{{dateValue}}" bindchange="chooseDate"><view class="field"><text class="field-label">出发时间</text><text class="field-value">{{date || '选择日期'}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view></picker><view class="field" bindtap="chooseActivity"><text class="field-label">活动类型</text><text class="field-value">{{activity}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view></view>
  <view class="section-title"><text>补充环境</text><text class="aside">选填，结果会更具体</text></view><view class="card card-pad row" bindtap="editEnvironment"><view class="circle circle-green" style="width:72rpx;height:72rpx"><image class="figma-icon md" src="/assets/figma/all/s08-imgIconGeneratedIllustrated.svg"/></view><view class="grow" style="margin-left:22rpx"><view>林地、近水、过夜、同行与宠物</view><view class="tiny">已选择：{{environmentText}}</view></view><text class="muted">编辑</text></view>
  <view class="card card-pad row" style="margin-top:44rpx" bindtap="route"><view class="circle circle-green" style="width:80rpx;height:80rpx"><image class="figma-icon lg" src="/assets/figma/all/s08-img1.svg"/></view><view class="grow" style="margin-left:22rpx"><view class="h3">{{route?'已添加徒步路线':'添加徒步路线'}}</view><view class="tiny">{{route?route.summary:'选填 · 使用 openrouteservice 规划'}}</view></view><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view>
  <button class="secondary-btn" style="margin-top:58rpx" bindtap="generate">生成行前清单</button><view class="safe-note" style="margin-top:24rpx">不规划路线也可以生成并保存计划<text class="block-break"></text>当前仅覆盖浙江省</view>
</view>
