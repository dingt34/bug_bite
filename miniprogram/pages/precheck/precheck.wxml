<view class="page precheck-page">
  <view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s08-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">行前准备</view><view class="top-title-sub">建立一份新的户外计划</view></view><view class="top-action" bindtap="save">保存草稿</view></view>
  <view class="card precheck-hero"><view class="hero-copy"><view class="h3">{{destination || '下一次出发，从准备开始'}}</view><view class="muted">{{activity || '填写目的地、日期和活动'}} · 浙江地区参考</view></view><view class="route-art"></view></view>
  <view class="section-title"><text>基本信息</text><text class="aside">三项必填</text></view>
  <view class="stack gap-12">
    <view class="card destination-card"><view class="field"><text class="field-label">目的地</text><input class="field-value" value="{{destination}}" bindinput="inputDestination" maxlength="80" placeholder="如：丽水古堰画乡" /></view><button class="text-button map-button" bindtap="chooseDestination">也可从地图选择</button><view wx:if="{{coverageMessage}}" class="coverage-warning">{{coverageMessage}}</view><view wx:elif="{{destination}}" class="coverage-ready">已匹配浙江省内目的地</view></view>
    <picker mode="date" start="{{minDate}}" value="{{dateValue || minDate}}" bindchange="chooseDate"><view class="field"><text class="field-label">出发日期</text><text class="field-value">{{date || '请选择日期'}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view></picker>
    <picker mode="selector" range="{{activityOptions}}" value="{{activityIndex}}" bindchange="chooseActivity"><view class="field"><text class="field-label">活动类型</text><text class="field-value">{{activity || '请选择活动'}}</text><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view></picker>
  </view>
  <view class="supplement-head {{expanded?'open':''}}" bindtap="editEnvironment"><view class="grow"><view class="h3">补充信息，让建议更贴合</view><view class="tiny">环境、住宿、同行人与用品均为选填</view></view><view class="supplement-status">{{optionalDone}}/4 项已完成<image class="supplement-arrow {{expanded?'open':''}}" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/></view></view>
  <view wx:if="{{expanded}}" class="card card-pad supplement-card">
    <view class="optional-groups">
      <view class="branch-question"><view class="question-label">可能经过的环境</view><view class="chip-row"><view wx:for="{{habitatOptions}}" wx:key="value" class="chip {{item.selected?'active':''}}" data-value="{{item.value}}" bindtap="toggleHabitat">{{item.value}}</view></view></view>
      <view class="branch-question"><view class="question-label">住宿方式</view><view class="chip-row"><view wx:for="{{overnightOptions}}" wx:key="value" class="chip {{item.selected?'active':''}}" data-value="{{item.value}}" bindtap="chooseOvernight">{{item.value}}</view></view></view>
      <view class="branch-question"><view class="question-label">同行情况</view><view class="chip-row"><view wx:for="{{companionOptions}}" wx:key="value" class="chip {{item.selected?'active':''}}" data-value="{{item.value}}" bindtap="toggleCompanion">{{item.value}}</view></view></view>
      <view class="branch-question"><view class="question-label">已有防护用品</view><view class="chip-row"><view wx:for="{{gearOptions}}" wx:key="value" class="chip {{item.selected?'active':''}}" data-value="{{item.value}}" bindtap="toggleGear">{{item.value}}</view></view></view>
    </view>
  </view>
  <view class="card card-pad route-card"><view class="row" bindtap="route"><image class="figma-icon lg" src="/assets/figma/all/s08-img1.svg"/><view class="grow environment-copy"><view class="h3">路线规划（选填）</view><view class="tiny">{{route?route.summary:'可添加真实路线，辅助完善行前计划'}}</view></view><image class="figma-icon sm" src="/assets/figma/all/s08-imgFrame2.svg"/></view><view class="tiny route-warning" wx:if="{{route}}">已保存 {{route.distance}} · {{route.duration}}</view><button wx:if="{{route}}" class="text-button" bindtap="removeRoute">移除路线</button></view>
  <view class="form-footer"><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="generate">生成行前清单</button><view class="safe-note">{{saveStatus}}<text class="block-break"></text>地区化内容以浙江为范围；清单不代表目的地风险预测。</view></view>
</view>
