.page {
  padding-bottom: 60rpx;
}

.required {
  color: #E53935;
}
.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.picker {
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}
.picker.placeholder {
  color: #B7C0C7;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.selection-help {
  margin-top: 8rpx;
  color: #8A9299;
  font-size: 22rpx;
  line-height: 1.5;
}

.route-card { border: 2rpx solid #DCEDE5; }
.route-help { margin: 8rpx 0 20rpx; color: #718078; font-size: 24rpx; line-height: 1.55; }
.route-pickers { display: flex; align-items: flex-end; gap: 14rpx; }
.route-picker-wrap { flex: 1; min-width: 0; }
.route-label { margin-bottom: 10rpx; color: #52615A; font-size: 24rpx; }
.route-input { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 16rpx; background: #F7F8F9; border-radius: 12rpx; color: #26342D; font-size: 26rpx; }
.route-arrow { padding-bottom: 17rpx; color: #2E7D5B; font-size: 36rpx; font-weight: 600; }
.route-plan-button { margin: 20rpx 0 0; background: #2E7D5B; color: #FFFFFF; font-size: 27rpx; }
.route-plan-button[disabled] { background: #B7C8BE; color: #FFFFFF; }
.route-message { margin-top: 16rpx; color: #438060; font-size: 24rpx; line-height: 1.5; }
.route-map { width: 100%; height: 440rpx; margin-top: 18rpx; border-radius: 14rpx; overflow: hidden; }
.route-options { margin-top: 16rpx; }
.route-option { display: flex; align-items: center; justify-content: space-between; padding: 18rpx; margin-top: 10rpx; border: 2rpx solid #E1E9E4; border-radius: 12rpx; }
.route-option.selected { border-color: #2E7D5B; background: #F0F8F4; }
.route-option-name { margin-right: 12rpx; color: #26342D; font-size: 26rpx; font-weight: 600; }
.route-option-detail { color: #718078; font-size: 23rpx; }
.route-option-state { color: #2E7D5B; font-size: 23rpx; }
.route-summary { margin-top: 20rpx; padding: 16rpx 18rpx; background: #F0F8F4; border-radius: 12rpx; color: #276747; font-size: 25rpx; line-height: 1.5; }
.route-insects { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #E5ECE8; }
.route-insects-title { margin-bottom: 10rpx; color: #26342D; font-size: 28rpx; font-weight: 600; }
.insect-item { display: flex; align-items: baseline; padding: 12rpx 0; border-bottom: 1rpx solid #EDF1EF; }
.insect-name { flex: none; width: 138rpx; color: #2E7D5B; font-size: 26rpx; font-weight: 600; }
.insect-reason { color: #66736C; font-size: 24rpx; line-height: 1.5; }
.route-note { margin-top: 14rpx; color: #909B95; font-size: 22rpx; line-height: 1.5; }

.submit-wrap {
  padding: 20rpx 24rpx 0;
}
