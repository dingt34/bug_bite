.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 8rpx 8rpx 4rpx;
}
.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.head-title {
  color: #2B2F36;
  font-size: 34rpx;
  font-weight: 700;
}
.head-sub {
  margin-top: 6rpx;
  color: #737D85;
  font-size: 24rpx;
}
.save-draft {
  flex: none;
  padding: 8rpx 0 16rpx 16rpx;
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 600;
}

.completion-card {
  margin: 18rpx 0 22rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #DCEAE3;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #737D85;
  font-size: 22rpx;
}
.completion-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.completion-count {
  flex: none;
  color: var(--primary);
  font-weight: 600;
}
.completion-track {
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #E8EEEB;
}
.completion-value {
  height: 100%;
  border-radius: 8rpx;
  background: var(--primary);
  transition: width 0.2s ease;
}

.required {
  color: #E53935;
}
.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.picker {
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}
.picker.placeholder {
  color: #B7C0C7;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.selection-help {
  margin-top: 8rpx;
  color: #8A9299;
  font-size: 22rpx;
  line-height: 1.5;
}

.question-card,
.route-entry {
  margin: 0 0 20rpx;
}
.question-meta {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.question-index {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}
.question-index.optional-index {
  border: 2rpx solid #D7E6DE;
  background: #FFFFFF;
  line-height: 30rpx;
}
.question-group {
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 600;
}
.section-label {
  display: flex;
  align-items: baseline;
  margin: 30rpx 8rpx 16rpx;
  color: #2B2F36;
  font-size: 28rpx;
  font-weight: 700;
}
.section-label > view:first-child {
  display: flex;
  align-items: baseline;
}
.section-label text {
  margin-left: 12rpx;
  color: #8A9299;
  font-size: 21rpx;
  font-weight: 400;
}
.section-toggle {
  margin-left: auto;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
}
.route-region-suggestion { display: flex; justify-content: space-between; gap: 16rpx; margin: 2rpx 0 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: var(--primary-light); color: #47705C; font-size: 22rpx; line-height: 1.5; }
.route-region-suggestion text { flex: none; color: #2E7D5B; font-weight: 600; }

.route-entry { display: flex; align-items: center; justify-content: space-between; border: 2rpx solid #DCEDE5; }
.route-entry-main { flex: 1; min-width: 0; }
.route-entry-summary { margin-top: 8rpx; color: #276747; font-size: 27rpx; font-weight: 600; }
.route-entry-detail { margin-top: 8rpx; color: #7B8881; font-size: 23rpx; line-height: 1.5; }
.route-entry-action { flex: none; margin-left: 20rpx; color: #2E7D5B; font-size: 25rpx; font-weight: 600; }

.submit-wrap {
  padding: 20rpx 0 0;
}
.footer-tip {
  margin: 16rpx 0 0;
  text-align: center;
}
