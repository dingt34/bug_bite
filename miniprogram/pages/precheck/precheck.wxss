.page {
  padding-bottom: 60rpx;
}

.required {
  color: #E53935;
}
.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.picker {
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
}
.picker.placeholder {
  color: #B7C0C7;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.submit-wrap {
  padding: 20rpx 24rpx 0;
}
