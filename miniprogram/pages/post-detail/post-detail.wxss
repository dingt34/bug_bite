.page {
  padding: 4rpx 0 40rpx;
}

.post-head {
  display: flex;
  align-items: center;
}
.post-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  line-height: 72rpx;
  font-size:var(--font-section-title);
  margin-right: 20rpx;
}
.avatar-image {
  display: block;
  background: #EEF3F0;
}
.post-name {
  font-size:var(--font-card-title);
  font-weight: 600;
}
.post-time {
  font-size:var(--font-caption);
  color: #B7C0C7;
}
.action-button::after { border: none; }
.post-text {
  font-size:var(--font-card-title);
  color: #2B2F36;
  margin-top: 20rpx;
  line-height: 1.7;
}
.route-share-card { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #CFE4D9; border-radius: 16rpx; background: #F3FAF6; }
.route-share-badge { color: #2E7D5B; font-size:var(--font-caption); font-weight: 600; }
.route-share-path { margin-top: 10rpx; color: #26342D; font-size:var(--font-body); font-weight: 600; line-height: 1.65; }
.route-arrow { margin: 0 8rpx; color: #74A38D; }
.route-share-meta { margin-top: 8rpx; color: #75827C; font-size:var(--font-caption); line-height: 1.5; }
.post-img {
  width: 100%;
  border-radius: 16rpx;
  margin-top: 20rpx;
}
.post-tags {
  margin-top: 16rpx;
}
.post-actions {
  display: flex;
  margin-top: 24rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F2F4;
}
.action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin: 0 4rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #7A8580;
  font-size:var(--font-caption);
  line-height: 1;
}
.action-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  color: inherit;
  line-height: 1;
  text-align: center;
}
.action-glyph {
  font-size:var(--font-card-title);
  line-height: 29rpx;
}
.share-icon {
  position: relative;
  box-sizing: border-box;
  width: 28rpx;
  height: 25rpx;
  margin-top: 5rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 5rpx 5rpx;
}
.share-arrow {
  position: absolute;
  left: 11rpx;
  top: -6rpx;
  width: 2rpx;
  height: 20rpx;
  background: currentColor;
}
.share-arrow::before {
  content: '';
  position: absolute;
  left: -5rpx;
  top: 0;
  width: 9rpx;
  height: 9rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(45deg);
}
.action-label {
  margin-right: 6rpx;
  font-size:var(--font-caption);
}
.action-num {
  color: inherit;
  font-size:var(--font-caption);
}
.action-button {
  border: none;
  background: transparent;
  font-family: inherit;
}
.action-on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.action-collected {
  background: #FFF7E6;
  color: #A87416;
  font-weight: 600;
}
.owner-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  font-size:var(--font-caption);
}
.edit-own {
  margin-right: 30rpx;
  color: var(--primary);
}
.delete-own {
  color: #D34A4A;
}
.comment-card {
  margin-top: 24rpx;
}
.comment-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.comment-title {
  color: #27342E;
  font-size:var(--font-card-title);
  font-weight: 600;
}
.comment-count {
  margin-left: 8rpx;
  color: #8B9691;
  font-size:var(--font-caption);
  font-weight: 400;
}
.comment-sorts {
  display: flex;
  padding: 4rpx;
  border-radius: 24rpx;
  background: #F1F4F2;
}
.comment-sort {
  padding: 7rpx 17rpx;
  border-radius: 20rpx;
  color: #849089;
  font-size:var(--font-caption);
}
.comment-sort-on {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 7rpx rgba(35, 65, 52, 0.08);
}
.comment-composer {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.reply-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: #557166;
  font-size:var(--font-caption);
}
.reply-cancel {
  padding-left: 20rpx;
  color: var(--primary);
  font-weight: 600;
}
.comment-composer-reply {
  margin-top: 10rpx;
}
.comment-input {
  flex: 1;
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 2rpx solid #DFE7E3;
  border-radius: 34rpx;
  background: #F7F9F8;
  font-size:var(--font-body);
}
.comment-send {
  min-width: 112rpx;
  margin: 0 0 0 14rpx;
  padding: 15rpx 18rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size:var(--font-body);
  line-height: 1.5;
}
.comment-send::after {
  border: none;
}
.comment-send[disabled] {
  background: #AFC8BC;
  color: #FFFFFF;
}
.comment-item {
  display: flex;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #EDF1EF;
}
.comment-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size:var(--font-body);
  line-height: 64rpx;
  text-align: center;
}
.comment-body {
  flex: 1;
  min-width: 0;
}
.comment-meta {
  display: flex;
  align-items: center;
}
.comment-name {
  color: #66736D;
  font-size:var(--font-body);
  font-weight: 600;
}
.comment-text {
  margin-top: 12rpx;
  color: #27312C;
  font-size:var(--font-body);
  line-height: 1.65;
  word-break: break-all;
}
.comment-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 54rpx;
  margin-top: 10rpx;
}
.comment-footer-main {
  display: flex;
  align-items: center;
}
.comment-time {
  color: #9AA39F;
  font-size:var(--font-caption);
}
.comment-vote {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  min-height: 54rpx;
  margin-left: 10rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #89938E;
  font-size:var(--font-caption);
}
.comment-vote-icon {
  display: block;
  width: 25rpx;
  height: 25rpx;
  margin-right: 5rpx;
}
.comment-vote-up {
  background: var(--primary-light);
  color: var(--primary);
}
.comment-vote-down {
  background: #FFF1EC;
  color: #B36A55;
}
.comment-vote-busy {
  opacity: 0.5;
}
.comment-reply-action {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  margin-left: 10rpx;
  width: 54rpx;
  padding: 0;
  border-radius: 12rpx;
  color: #7A8580;
  font-size:var(--font-caption);
  line-height: 54rpx;
}
.comment-delete {
  min-width: 54rpx;
  color: #c57969;
  font-size:var(--font-caption);
  line-height: 54rpx;
  text-align: right;
}
.comment-reply-icon {
  width: 25rpx;
  margin-right: 4rpx;
  font-size:var(--font-body);
  line-height: 1;
  text-align: center;
}
.comment-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: -10rpx;
  color: #8F9994;
  font-size:var(--font-section-title);
  line-height: 1;
}
.reply-toggle {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding-right: 18rpx;
  color: var(--primary);
  font-size:var(--font-caption);
  font-weight: 600;
}
.reply-list {
  margin-top: 4rpx;
  padding-left: 16rpx;
  border-left: 3rpx solid #E4EEE9;
}
.comment-reply {
  margin-top: 12rpx;
  padding-top: 16rpx;
}
.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  font-size:var(--font-caption);
  line-height: 48rpx;
}
.reply-to {
  margin-left: 12rpx;
  color: #8D9892;
  font-size:var(--font-caption);
}
.comment-empty {
  padding: 48rpx 10rpx 20rpx;
  color: #9BA5A0;
  font-size:var(--font-caption);
  text-align: center;
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  color: #7A5C00;
  font-size:var(--font-caption);
}
.notice-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin: 4rpx 12rpx 0 0;
  border: 2rpx solid #B88818;
  border-radius: 50%;
  font-size:var(--font-caption);
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}

.safety-card {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 104rpx;
  margin: 20rpx 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 91, 0.18);
  text-align: left;
  line-height: 1.4;
}
.safety-card::after {
  border: none;
}
.safety-icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  font-size:var(--font-card-title);
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}
.safety-copy {
  flex: 1;
}
.safety-title {
  font-size:var(--font-card-title);
  font-weight: 700;
}
.safety-sub {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size:var(--font-caption);
}
.safety-arrow {
  margin-left: 18rpx;
  font-size:var(--font-page-title);
  font-weight: 300;
  line-height: 1;
}
.report {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  margin: 8rpx 24rpx 0;
  border: 1rpx solid #F0DEDE;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #C94B4B;
  font-size:var(--font-caption);
}
.report-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size:var(--font-micro);
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
}
.reported {
  color: #8A9299;
}
.detail-state {
  padding: 220rpx 50rpx 80rpx;
  color: #7C8983;
  font-size:var(--font-body);
  text-align: center;
}
.detail-spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 22rpx;
  border: 5rpx solid #DCE9E3;
  border-top-color: var(--primary);
  border-radius: 50%;
}
.detail-state-icon {
  font-size:var(--font-display);
}
.detail-state-title {
  margin-top: 14rpx;
  color: #48554F;
  font-size:var(--font-card-title);
  font-weight: 600;
}
.detail-state-sub {
  margin-top: 10rpx;
  color: #929D98;
  font-size:var(--font-caption);
}
.detail-retry {
  width: 220rpx;
  margin-top: 28rpx;
  border-radius: 34rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size:var(--font-body);
}
.detail-retry::after {
  border: none;
}

/* 参考图的轻量详情层级：内容融入页面底色，操作区域保持明确。 */
.page {
  padding: 8rpx 36rpx 56rpx;
  background: #f8f8fc;
}
.topbar {
  height: 106rpx;
}
.back {
  width: 88rpx;
  height: 72rpx;
  background: #fff;
  color: #547464;
  font-size:var(--font-caption);
  font-weight: 600;
  line-height: 72rpx;
}
.top-title {
  margin-left: 22rpx;
  font-size:var(--font-section-title);
}
.post-card {
  padding: 12rpx 0 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.post-head {
  margin-top: 4rpx;
}
.post-avatar {
  width: 82rpx;
  height: 82rpx;
  margin-right: 20rpx;
  background: #cfe6d2;
  color: #58745e;
  font-size:var(--font-card-title);
  line-height: 82rpx;
}
.post-name {
  color: #3b3f42;
  font-size:var(--font-card-title);
  font-weight: 700;
}
.post-time {
  margin-top: 4rpx;
  color: #a6aab0;
  font-size:var(--font-caption);
}
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}
.post-tags .tag {
  min-width: 94rpx;
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #8b9095;
  font-size:var(--font-caption);
  line-height: 1;
  text-align: center;
}
.post-title {
  margin-top: 34rpx;
  color: #272a2d;
  font-size:var(--font-section-title);
  font-weight: 700;
  line-height: 1.3;
}
.post-text {
  margin-top: 14rpx;
  color: #969ba1;
  font-size:var(--font-caption);
  line-height: 1.9;
}
.post-img {
  margin-top: 20rpx;
  border-radius: 28rpx;
}
.route-share-card {
  position: relative;
  min-height: 248rpx;
  margin-top: 28rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 0;
  border-radius: 30rpx 30rpx 0 0;
  background: linear-gradient(160deg, #ffffff 0%, #ffffff 35%, #d5e6d7 36%, #a9c9ad 100%);
}
.route-share-card::after {
  content: '';
  position: absolute;
  right: -90rpx;
  bottom: -142rpx;
  width: 600rpx;
  height: 310rpx;
  border: 7rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  transform: rotate(-12deg);
}
.route-share-badge {
  position: relative;
  z-index: 1;
  display: inline-block;
  padding: 13rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(245, 246, 248, 0.92);
  color: #a2a7ad;
  font-size:var(--font-caption);
}
.route-share-path {
  position: absolute;
  z-index: 1;
  right: 26rpx;
  bottom: 64rpx;
  max-width: 76%;
  color: #537560;
  font-size:var(--font-body);
  font-weight: 700;
  text-align: right;
}
.route-share-meta {
  position: absolute;
  z-index: 1;
  right: 26rpx;
  bottom: 26rpx;
  color: #78927c;
  font-size:var(--font-caption);
}
.safety-card {
  display: block;
  width: 100%;
  min-height: 88rpx;
  margin: 28rpx 0 0;
  padding: 0 30rpx;
  border-radius: 46rpx;
  background: #1f2224;
  box-shadow: none;
  color: #fff;
  font-size:var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}
.post-actions {
  margin-top: 18rpx;
  padding: 6rpx 0 0;
  border-top: 0;
}
.action {
  justify-content: flex-start;
  min-height: 58rpx;
  color: #b2b6bc;
  font-size:var(--font-caption);
}
.action:last-child {
  justify-content: flex-end;
}
.action-on, .action-collected {
  background: transparent;
  color: #638a70;
}
.owner-actions {
  margin-top: 0;
}
.comment-card {
  margin-top: 26rpx;
  padding: 30rpx 26rpx 26rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(35, 42, 37, 0.05);
}
.comment-title {
  color: #2f3235;
  font-size:var(--font-card-title);
}
.comment-sorts {
  background: #f3f4f6;
}
.comment-item {
  margin-top: 22rpx;
  padding: 22rpx;
  border-top: 0;
  border-radius: 28rpx;
  background: #fafafb;
}
.comment-avatar {
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  background: #f5e8c9;
  color: #92794e;
  font-size:var(--font-caption);
  line-height: 58rpx;
}
.comment-text {
  color: #81868c;
  font-size:var(--font-caption);
}
.comment-composer {
  margin-top: 24rpx;
}
.comment-input {
  min-height: 76rpx;
  border: 0;
  background: #f3f4f6;
  font-size:var(--font-caption);
}
.comment-send {
  min-width: 76rpx;
  height: 76rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 50%;
  background: #2f875f;
  font-size:var(--font-section-title);
  line-height: 76rpx;
}
.report {
  margin-top: 22rpx;
  border: 0;
  background: transparent;
  color: #abb0b5;
}
.notice {
  margin: 16rpx 0 0;
  border-radius: 26rpx;
  background: #f3f4f5;
  color: #8a8171;
}

/* 放宽正文、路线、操作和评论的垂直节奏。 */
.post-head { margin-top: 20rpx; }
.post-tags { margin-top: 38rpx; }
.post-title { margin-top: 42rpx; }
.post-text { margin-top: 18rpx; }
.post-img { margin-top: 28rpx; }
.route-share-card { margin-top: 38rpx; }
.safety-card { margin-top: 36rpx; }
.post-actions { margin-top: 28rpx; }
.comment-card { margin-top: 42rpx; padding: 36rpx 30rpx 32rpx; }
.comment-item { margin-top: 30rpx; padding: 28rpx; }
.comment-composer { margin-top: 32rpx; }
.comment-send {
  display: flex;
  align-items: center;
  justify-content: center;
}
.comment-send-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 与社群列表保持同一套互动图标与四列节奏。 */
.post-actions {
  justify-content: space-between;
}
.post-actions .action {
  flex: 0;
  min-width: 88rpx;
  margin: 0;
  padding: 0 4rpx;
  justify-content: flex-start;
}
.post-actions .action:last-child {
  justify-content: flex-end;
}
.action-image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: .66;
}
.action-on .action-image,
.action-collected .action-image {
  opacity: 1;
}

/* 左侧互动项紧凑排列，分享独立靠右且始终单行显示。 */
.post-actions .action {
  min-width: auto;
  margin-right: 30rpx;
}
.post-actions .action:last-child {
  margin-left: 0;
  margin-right: 0;
  justify-content: flex-start;
}
.post-actions .action-label {
  white-space: nowrap;
}
.post-actions .action {
  height: 52rpx;
  align-items: center;
}
.post-actions .action-image {
  display: block;
  flex: none;
  width: 26rpx;
  height: 26rpx;
}
.post-actions .action-num,
.post-actions .action-label {
  line-height: 26rpx;
}
