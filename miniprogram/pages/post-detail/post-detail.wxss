.page {
  padding: 4rpx 0 40rpx;
}

.post-head {
  display: flex;
  align-items: center;
}
.post-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  line-height: 72rpx;
  font-size: 32rpx;
  margin-right: 20rpx;
}
.avatar-image {
  display: block;
  background: #EEF3F0;
}
.post-name {
  font-size: 30rpx;
  font-weight: 600;
}
.post-time {
  font-size: 22rpx;
  color: #B7C0C7;
}
.action-button::after { border: none; }
.post-text {
  font-size: 30rpx;
  color: #2B2F36;
  margin-top: 20rpx;
  line-height: 1.7;
}
.route-share-card { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #CFE4D9; border-radius: 16rpx; background: #F3FAF6; }
.route-share-badge { color: #2E7D5B; font-size: 22rpx; font-weight: 600; }
.route-share-path { margin-top: 10rpx; color: #26342D; font-size: 27rpx; font-weight: 600; line-height: 1.65; }
.route-arrow { margin: 0 8rpx; color: #74A38D; }
.route-share-meta { margin-top: 8rpx; color: #75827C; font-size: 22rpx; line-height: 1.5; }
.post-img {
  width: 100%;
  border-radius: 16rpx;
  margin-top: 20rpx;
}
.post-tags {
  margin-top: 16rpx;
}
.post-actions {
  display: flex;
  margin-top: 24rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0F2F4;
}
.action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin: 0 4rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #7A8580;
  font-size: 22rpx;
  line-height: 1;
}
.action-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  color: inherit;
  line-height: 1;
  text-align: center;
}
.action-glyph {
  font-size: 28rpx;
  line-height: 29rpx;
}
.share-icon {
  position: relative;
  box-sizing: border-box;
  width: 28rpx;
  height: 25rpx;
  margin-top: 5rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 5rpx 5rpx;
}
.share-arrow {
  position: absolute;
  left: 11rpx;
  top: -6rpx;
  width: 2rpx;
  height: 20rpx;
  background: currentColor;
}
.share-arrow::before {
  content: '';
  position: absolute;
  left: -5rpx;
  top: 0;
  width: 9rpx;
  height: 9rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(45deg);
}
.action-label {
  margin-right: 6rpx;
  font-size: 22rpx;
}
.action-num {
  color: inherit;
  font-size: 22rpx;
}
.action-button {
  border: none;
  background: transparent;
  font-family: inherit;
}
.action-on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.action-collected {
  background: #FFF7E6;
  color: #A87416;
  font-weight: 600;
}
.owner-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  font-size: 23rpx;
}
.edit-own {
  margin-right: 30rpx;
  color: var(--primary);
}
.delete-own {
  color: #D34A4A;
}
.comment-card {
  margin-top: 24rpx;
}
.comment-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.comment-title {
  color: #27342E;
  font-size: 30rpx;
  font-weight: 600;
}
.comment-count {
  margin-left: 8rpx;
  color: #8B9691;
  font-size: 23rpx;
  font-weight: 400;
}
.comment-sorts {
  display: flex;
  padding: 4rpx;
  border-radius: 24rpx;
  background: #F1F4F2;
}
.comment-sort {
  padding: 7rpx 17rpx;
  border-radius: 20rpx;
  color: #849089;
  font-size: 21rpx;
}
.comment-sort-on {
  background: #FFFFFF;
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 7rpx rgba(35, 65, 52, 0.08);
}
.comment-composer {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.reply-context {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: var(--primary-light);
  color: #557166;
  font-size: 21rpx;
}
.reply-cancel {
  padding-left: 20rpx;
  color: var(--primary);
  font-weight: 600;
}
.comment-composer-reply {
  margin-top: 10rpx;
}
.comment-input {
  flex: 1;
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 2rpx solid #DFE7E3;
  border-radius: 34rpx;
  background: #F7F9F8;
  font-size: 25rpx;
}
.comment-send {
  min-width: 112rpx;
  margin: 0 0 0 14rpx;
  padding: 15rpx 18rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.5;
}
.comment-send::after {
  border: none;
}
.comment-send[disabled] {
  background: #AFC8BC;
  color: #FFFFFF;
}
.comment-item {
  display: flex;
  margin-top: 30rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #EDF1EF;
}
.comment-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
}
.comment-body {
  flex: 1;
  min-width: 0;
}
.comment-meta {
  display: flex;
  align-items: center;
}
.comment-name {
  color: #66736D;
  font-size: 24rpx;
  font-weight: 600;
}
.comment-text {
  margin-top: 12rpx;
  color: #27312C;
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-all;
}
.comment-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 54rpx;
  margin-top: 10rpx;
}
.comment-footer-main {
  display: flex;
  align-items: center;
}
.comment-time {
  color: #9AA39F;
  font-size: 20rpx;
}
.comment-vote {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  min-height: 54rpx;
  margin-left: 10rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: #89938E;
  font-size: 20rpx;
}
.comment-vote-icon {
  width: 26rpx;
  margin-right: 5rpx;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}
.comment-vote-up {
  background: var(--primary-light);
  color: var(--primary);
}
.comment-vote-down {
  background: #FFF1EC;
  color: #B36A55;
}
.comment-vote-busy {
  opacity: 0.5;
}
.comment-reply-action {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  margin-left: 10rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  color: #7A8580;
  font-size: 21rpx;
  line-height: 54rpx;
}
.comment-reply-icon {
  width: 25rpx;
  margin-right: 4rpx;
  font-size: 24rpx;
  line-height: 1;
  text-align: center;
}
.comment-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: -10rpx;
  color: #8F9994;
  font-size: 34rpx;
  line-height: 1;
}
.reply-toggle {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding-right: 18rpx;
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 600;
}
.reply-list {
  margin-top: 4rpx;
  padding-left: 16rpx;
  border-left: 3rpx solid #E4EEE9;
}
.comment-reply {
  margin-top: 12rpx;
  padding-top: 16rpx;
}
.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  margin-right: 14rpx;
  font-size: 21rpx;
  line-height: 48rpx;
}
.reply-to {
  margin-left: 12rpx;
  color: #8D9892;
  font-size: 20rpx;
}
.comment-empty {
  padding: 48rpx 10rpx 20rpx;
  color: #9BA5A0;
  font-size: 23rpx;
  text-align: center;
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  color: #7A5C00;
  font-size: 23rpx;
}
.notice-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  margin: 4rpx 12rpx 0 0;
  border: 2rpx solid #B88818;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
}

.safety-card {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 104rpx;
  margin: 20rpx 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(46, 125, 91, 0.18);
  text-align: left;
  line-height: 1.4;
}
.safety-card::after {
  border: none;
}
.safety-icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}
.safety-copy {
  flex: 1;
}
.safety-title {
  font-size: 28rpx;
  font-weight: 700;
}
.safety-sub {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
}
.safety-arrow {
  margin-left: 18rpx;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
}
.report {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  margin: 8rpx 24rpx 0;
  border: 1rpx solid #F0DEDE;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #C94B4B;
  font-size: 22rpx;
}
.report-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
}
.reported {
  color: #8A9299;
}
.detail-state {
  padding: 220rpx 50rpx 80rpx;
  color: #7C8983;
  font-size: 25rpx;
  text-align: center;
}
.detail-spinner {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 22rpx;
  border: 5rpx solid #DCE9E3;
  border-top-color: var(--primary);
  border-radius: 50%;
}
.detail-state-icon {
  font-size: 64rpx;
}
.detail-state-title {
  margin-top: 14rpx;
  color: #48554F;
  font-size: 28rpx;
  font-weight: 600;
}
.detail-state-sub {
  margin-top: 10rpx;
  color: #929D98;
  font-size: 22rpx;
}
.detail-retry {
  width: 220rpx;
  margin-top: 28rpx;
  border-radius: 34rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
}
.detail-retry::after {
  border: none;
}
