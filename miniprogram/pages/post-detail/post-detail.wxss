.post-map{height:300rpx;margin-top:38rpx;background:#aed0b3;position:relative;overflow:hidden}.post-map-art{position:absolute;inset:0;width:100%;height:100%}.author-route{position:absolute;left:24rpx;top:24rpx;padding:14rpx 30rpx;background:rgba(255,255,255,.82);border-radius:30rpx;color:#8c8f96;font-size:22rpx}.route-label{position:absolute;left:24rpx;bottom:30rpx;color:#7d9184}.post-meta{display:flex;justify-content:space-between;color:#8c8f96;margin-top:30rpx}.comment-bar{display:flex;gap:18rpx;margin-top:38rpx}.comment-bar input{height:84rpx;background:#f0f1f3;border-radius:42rpx;padding:0 28rpx}.send{width:84rpx;height:84rpx;border-radius:50%;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:40rpx}
