.page { padding: 24rpx 24rpx 70rpx; }
.forward-tip { margin-bottom: 22rpx; padding: 18rpx 22rpx; border-radius: 14rpx; background: var(--primary-light); color: var(--primary); font-size: 24rpx; }
.state { padding: 180rpx 40rpx; color: var(--text-sub); text-align: center; }
.state-button { width: 220rpx; margin-top: 24rpx; border-radius: 36rpx; background: var(--primary); color: #fff; font-size: 24rpx; }
.state-button::after, .mini-button::after { border: none; }
.section { margin-bottom: 30rpx; }
.section-title { margin: 0 4rpx 14rpx; color: #52605A; font-size: 27rpx; font-weight: 600; }
.count { margin-left: 8rpx; color: #98A39E; font-size: 22rpx; font-weight: 400; }
.friend-card, .request-card { display: flex; align-items: center; margin-bottom: 14rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.035); }
.avatar { width: 72rpx; height: 72rpx; margin-right: 18rpx; border-radius: 50%; background: var(--primary-light); color: var(--primary); font-size: 30rpx; line-height: 72rpx; text-align: center; }
.user-main { flex: 1; min-width: 0; }
.user-name { color: #29362F; font-size: 28rpx; font-weight: 600; }
.user-sub { margin-top: 3rpx; color: #98A19D; font-size: 22rpx; }
.arrow { color: #A7B0AC; font-size: 40rpx; }
.unread { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 18rpx; background: var(--danger); color: #fff; font-size: 19rpx; line-height: 34rpx; text-align: center; }
.request-actions { display: flex; flex-direction: column; }
.mini-button { min-width: 104rpx; margin: 0 0 8rpx 12rpx; padding: 8rpx 14rpx; border-radius: 26rpx; font-size: 21rpx; line-height: 1.5; }
.accept { background: var(--primary); color: #fff; }
.reject { margin-bottom: 0; background: #F0F2F1; color: #707B76; }
.empty { padding: 100rpx 30rpx; color: #9BA5A0; text-align: center; }
.empty-icon { font-size: 72rpx; }
.empty-title { margin-top: 14rpx; color: #67736D; font-size: 28rpx; }
.empty-sub { margin-top: 8rpx; font-size: 22rpx; }
