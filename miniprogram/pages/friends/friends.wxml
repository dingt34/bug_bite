<view class="page">
  <view class="forward-tip" wx:if="{{mode === 'forward'}}">选择一位好友，将当前帖子发送到私信会话</view>

  <view class="state" wx:if="{{loading}}">正在加载好友列表…</view>
  <view class="state" wx:elif="{{loadError}}">
    <view>{{loadError}}</view>
    <button class="state-button" bindtap="goLogin" wx:if="{{loginRequired}}">去登录</button>
    <button class="state-button" bindtap="retryLoad" wx:else>重新加载</button>
  </view>

  <block wx:else>
    <view class="section" wx:if="{{requests.length}}">
      <view class="section-title">好友申请 <text class="count">{{requests.length}}</text></view>
      <view class="request-card" wx:for="{{requests}}" wx:key="requestId">
        <view class="avatar">{{item.avatarText}}</view>
        <view class="user-main">
          <view class="user-name">{{item.displayName}}</view>
          <view class="user-sub">希望添加你为好友</view>
        </view>
        <view class="request-actions">
          <button class="mini-button accept" bindtap="acceptRequest" data-id="{{item.requestId}}">接受</button>
          <button class="mini-button reject" bindtap="rejectRequest" data-id="{{item.requestId}}">忽略</button>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">我的好友 <text class="count">{{friends.length}}</text></view>
      <view class="friend-card" wx:for="{{friends}}" wx:key="id" bindtap="selectFriend" data-id="{{item.id}}" data-name="{{item.displayName}}">
        <view class="avatar">{{item.avatarText}}</view>
        <view class="user-main">
          <view class="user-name">{{item.displayName}}</view>
          <view class="user-sub">{{mode === 'forward' ? '点击转发帖子' : (item.unreadCount ? item.unreadCount + ' 条未读私信' : '点击进入私信')}}</view>
        </view>
        <view class="unread" wx:if="{{item.unreadCount}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
        <view class="arrow" wx:else>›</view>
      </view>
      <view class="empty" wx:if="{{!friends.length}}">
        <view class="empty-icon">👥</view>
        <view class="empty-title">还没有好友</view>
        <view class="empty-sub">进入帖子详情，可以向帖子作者发送好友申请</view>
      </view>
    </view>
  </block>
</view>
