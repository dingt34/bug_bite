.detail-page{padding-bottom:72rpx}.detail-hero{position:relative;overflow:hidden;margin-top:20rpx;padding:34rpx;border:1rpx solid #e6ece8}.detail-hero::before{content:"";position:absolute;left:0;top:0;bottom:0;width:10rpx;background:#d5a245}.detail-hero.hero-emergency::before{background:#df4138}.detail-hero.hero-recovered::before{background:#2f875f}.hero-status-row{display:flex;align-items:center;justify-content:space-between}.level-badge{min-height:52rpx;padding:0 22rpx;border-radius:26rpx;display:flex;align-items:center;font-size:24rpx;font-weight:700}.level-pending{background:#fff1cf;color:#71530b}.level-emergency{background:#ffe4e1;color:#c7332b}.level-recovered{background:#e1f2e8;color:#26704f}.sync-label{color:#7b8580;font-size:23rpx}.hero-title{margin-top:24rpx;color:#1e2823;font-size:42rpx;line-height:1.25;font-weight:700}.hero-meta-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.meta-chip{min-height:48rpx;padding:8rpx 18rpx;border-radius:24rpx;background:#f1f4f2;color:#59675f;font-size:23rpx;line-height:1.35}.review-panel,.urgent-panel,.recovered-panel{margin-top:28rpx;padding:24rpx;border-radius:28rpx}.review-panel{display:flex;align-items:center;gap:20rpx;background:#f2f7f4}.urgent-panel{background:#fff0ee}.recovered-panel{background:#edf7f1}.review-label{color:#617069;font-size:22rpx}.review-time{margin-top:4rpx;color:#234f3a;font-size:32rpx;font-weight:700}.review-hint,.status-copy{margin-top:8rpx;color:#66736c;font-size:23rpx;line-height:1.55}.status-title{font-size:28rpx;font-weight:700}.urgent-panel .status-title{color:#c83730}.recovered-panel .status-title{color:#26704f}.adjust-button{flex:none;min-width:146rpx;height:72rpx;padding:0 20rpx;border-radius:24rpx;background:#fff;color:#2f7d5b;border:2rpx solid #88b59d;font-size:24rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
.action-grid{display:grid;grid-template-columns:1.55fr 1fr;gap:18rpx;margin-top:24rpx}.primary-action,.summary-action{height:94rpx;border-radius:32rpx;display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:700}.primary-action{background:#2f875f;color:#fff;box-shadow:0 10rpx 24rpx rgba(47,135,95,.18)}.primary-action.emergency-action{background:#df4138;box-shadow:0 10rpx 24rpx rgba(223,65,56,.18)}.summary-action{background:#fff;color:#315545;border:1rpx solid #dbe5df}
.summary-card{padding:4rpx 30rpx}.summary-row{display:grid;grid-template-columns:150rpx 1fr;gap:22rpx;padding:25rpx 0;border-bottom:1rpx solid #e9eeeb}.summary-row:last-child{border-bottom:0}.summary-label{color:#748078;font-size:24rpx}.summary-value{color:#26342d;font-size:27rpx;line-height:1.55;overflow-wrap:anywhere}.level-value{color:#2f7d5b;font-weight:700}
.timeline{padding:32rpx 30rpx 8rpx}.time-row{display:flex;min-height:126rpx}.timeline-axis{position:relative;width:48rpx;flex:none}.timeline-dot{position:relative;z-index:2;width:42rpx;height:42rpx;border-radius:50%;background:#2f875f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:700}.timeline-line{position:absolute;left:20rpx;top:42rpx;bottom:0;width:3rpx;background:#cddbd3}.timeline-copy{flex:1;min-width:0;padding:0 0 34rpx 22rpx}.timeline-heading{gap:16rpx}.timeline-title{color:#29372f;font-size:28rpx;font-weight:700}.timeline-level{flex:none;padding:7rpx 14rpx;border-radius:18rpx;background:#fff1cf;color:#76570d;font-size:21rpx}.timeline-time{margin-top:7rpx;color:#879089;font-size:22rpx}.timeline-detail{margin-top:13rpx;color:#56645d;font-size:24rpx;line-height:1.6}
.photo-list{width:100%;white-space:nowrap;padding-bottom:8rpx}.event-photo,.photo-add{display:inline-flex;width:224rpx;height:176rpx;margin-right:18rpx;border-radius:30rpx;vertical-align:top}.event-photo{background:#e9eeeb}.photo-add{background:#fff;align-items:center;justify-content:center;flex-direction:column;border:2rpx dashed #cddbd3}.photo-add-title{margin-top:8rpx;color:#355746;font-size:24rpx;font-weight:700}.photo-empty{min-height:116rpx;padding:24rpx 28rpx;display:flex;align-items:center;gap:22rpx}.photo-empty .photo-add-title{margin:0 0 5rpx}.photo-arrow{color:#2f875f;font-size:38rpx}
.note-card{padding:28rpx 30rpx;margin-bottom:18rpx}.note-markdown{display:block;color:#33433a;font-size:27rpx;line-height:1.75;word-break:break-word}.note-markdown h1,.note-markdown h2,.note-markdown h3{margin:18rpx 0 10rpx;color:#26342d;font-weight:700;line-height:1.4}.note-markdown h1{font-size:36rpx}.note-markdown h2{font-size:32rpx}.note-markdown h3{font-size:29rpx}.note-markdown p{margin:9rpx 0}.note-markdown ul,.note-markdown ol{margin:12rpx 0;padding-left:38rpx}.note-markdown li{margin:7rpx 0}.note-markdown blockquote{margin:14rpx 0;padding:14rpx 18rpx;border-left:6rpx solid #69a891;border-radius:0 16rpx 16rpx 0;background:#eef8f4;color:#456156}.note-markdown code{padding:3rpx 9rpx;border-radius:8rpx;background:#edf1ef;color:#2f7d5b;font-family:monospace}.note-markdown pre{margin:14rpx 0;padding:18rpx;overflow:auto;border-radius:16rpx;background:#26342d;color:#eef8f4;white-space:pre-wrap}.note-markdown pre code{padding:0;background:transparent;color:inherit}.note-markdown strong{color:#26342d;font-weight:700}.note-time{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #e8edea}.ai-entry{min-height:116rpx;margin-top:38rpx;padding:24rpx 28rpx;display:flex;align-items:center;gap:22rpx}.ai-mark{width:66rpx;height:66rpx;border-radius:22rpx;background:#e3f1e9;color:#26704f;display:flex;align-items:center;justify-content:center;font-size:22rpx;font-weight:800}.ai-title{color:#263a30;font-size:27rpx;font-weight:700}.ai-arrow{color:#2f7d5b;font-size:24rpx;font-weight:700}.detail-page .safe-note{margin:22rpx 10rpx 0;color:#707c75;font-size:22rpx}.delete-entry{width:100%;height:82rpx;margin-top:28rpx;border-radius:28rpx;background:transparent;color:#bd4039;border:2rpx solid #e7b8b4;font-size:24rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.custom-mask{position:fixed;z-index:70;left:0;right:0;top:0;bottom:0;background:rgba(20,23,31,.42)}.custom-sheet{position:fixed;z-index:71;left:24rpx;right:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));padding:38rpx;background:#f7f7fb;border-radius:42rpx}.custom-title{font-size:36rpx;font-weight:700}.custom-sub{margin-top:10rpx;color:#707a74;font-size:24rpx}.custom-fields{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:30rpx}.custom-field{min-height:108rpx;padding:18rpx 24rpx;border:2rpx solid #dfe5e1;border-radius:28rpx;background:#fff;display:flex;flex-direction:column;justify-content:center;gap:8rpx;font-size:26rpx}.custom-field text:first-child{color:#77827b;font-size:22rpx}.custom-actions{display:grid;grid-template-columns:1fr 2fr;gap:18rpx;margin-top:30rpx}.custom-cancel,.custom-confirm{height:96rpx;border-radius:30rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;font-weight:700}.custom-cancel{background:#fff;color:#5f6d65}.custom-confirm{background:#2f875f;color:#fff}
@media (max-width:360px){.review-panel{align-items:flex-start;flex-direction:column}.adjust-button{width:100%}.summary-row{grid-template-columns:130rpx 1fr}.action-grid{grid-template-columns:1fr}.hero-title{font-size:38rpx}}
