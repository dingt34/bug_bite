.page {
  padding-bottom: 60rpx;
}

.banner {
  color: #fff;
  padding: 40rpx;
}
.banner-type {
  font-size: 36rpx;
  font-weight: 700;
}
.banner-level {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.meta-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.meta-label {
  width: 160rpx;
  color: #8A9299;
  flex-shrink: 0;
}
.meta-val {
  flex: 1;
  color: #2B2F36;
}

.timeline {
  padding-left: 12rpx;
}
.tl-item {
  display: flex;
  padding-bottom: 28rpx;
  position: relative;
}
.tl-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #E1E6EA;
}
.tl-item:last-child::before {
  display: none;
}
.tl-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.tl-time {
  font-size: 24rpx;
  color: #8A9299;
}
.tl-text {
  font-size: 28rpx;
  color: #2B2F36;
  margin-top: 4rpx;
}

.summary-box {
  font-size: 26rpx;
  color: #3A414A;
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.7;
}
.copy-btn {
  margin-top: 20rpx;
  text-align: center;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  border-radius: 40rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.action {
  padding: 20rpx 24rpx 0;
}
