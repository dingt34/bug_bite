.page {
  padding-bottom: 60rpx;
}

.banner {
  color: #fff;
  padding: 40rpx;
}
.banner-type {
  font-size: 36rpx;
  font-weight: 700;
}
.banner-level {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.meta-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.meta-label {
  width: 160rpx;
  color: #8A9299;
  flex-shrink: 0;
}
.meta-val {
  flex: 1;
  color: #2B2F36;
}

.event-images {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.event-image {
  width: 190rpx;
  height: 190rpx;
  margin: 6rpx;
  border-radius: 14rpx;
  background: #F0F2F4;
}

.image-tip {
  margin-top: 14rpx;
  color: #8A9299;
  font-size: 22rpx;
}

.timeline {
  padding-left: 12rpx;
}
.tl-item {
  display: flex;
  padding-bottom: 28rpx;
  position: relative;
}
.tl-item::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #E1E6EA;
}
.tl-item:last-child::before {
  display: none;
}
.tl-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 20rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.tl-time {
  font-size: 24rpx;
  color: #8A9299;
}
.tl-text {
  font-size: 28rpx;
  color: #2B2F36;
  margin-top: 4rpx;
}

.review-level {
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.review-summary {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #F7F8F9;
  color: #3A414A;
  font-size: 25rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.review-warning {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 23rpx;
}
.review-version {
  margin-top: 12rpx;
  color: #8A9299;
  font-size: 22rpx;
}

.summary-box {
  font-size: 26rpx;
  color: #3A414A;
  background: #F7F8F9;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
.copy-btn {
  margin-top: 20rpx;
  text-align: center;
  border: 2rpx solid var(--primary);
  color: var(--primary);
  border-radius: 40rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.action {
  padding: 20rpx 24rpx 0;
}
.image-group + .image-group {
  margin-top: 22rpx;
}
.image-group-label {
  margin-bottom: 12rpx;
  color: #596269;
  font-size: 24rpx;
  font-weight: 600;
}
