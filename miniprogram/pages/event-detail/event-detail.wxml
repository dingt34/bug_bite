<view class="page"><view class="safe-top"></view><view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s14-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">事件详情</view><view class="top-title-sub">{{event.createdAt}}</view></view><view class="figma-menu"><image src="/assets/figma/all/s14-imgEllipse.svg"/><image src="/assets/figma/all/s14-imgEllipse.svg"/><image src="/assets/figma/all/s14-imgEllipse.svg"/></view></view>
<view class="card card-pad row"><view class="circle circle-amber" style="width:106rpx;height:106rpx">2h</view><view class="grow" style="margin-left:28rpx"><view class="h2">{{event.level}}</view><view class="muted">{{event.type}} · {{event.body}}</view><view class="chip" style="margin-top:20rpx">{{event.reviewAt}} 需要复查</view></view><text class="muted">调整</text></view>
<view class="section-title">事件摘要</view><view class="card card-pad summary-grid"><text class="tiny">发生地点</text><text>{{event.place}}</text><text class="tiny">局部表现</text><text>{{event.symptomsText}}</text><text class="tiny">变化趋势</text><text>{{event.trend}}</text></view>
<view class="section-title">恢复时间线</view><view class="card card-pad timeline"><view class="time-row"><image class="figma-icon md" src="/assets/figma/all/s14-imgEllipse2.svg"/><view><view class="danger-text">首次安全判断</view><view class="tiny">14:30 · {{event.level}}</view></view></view><view class="time-row"><image class="figma-icon md" src="/assets/figma/all/s14-imgEllipse3.svg"/><view><view class="danger-text">等待复查</view><view class="tiny">{{event.reviewAt}} · 约 2 小时后</view></view></view></view>
<view class="section-title">图片记录</view><view class="row gap-12"><image class="photo-placeholder" src="/assets/figma/all/s14-imgFrame1.svg" mode="aspectFill"/><view class="photo-add"><image class="figma-icon md" src="/assets/figma/all/s14-imgFrame1.svg"/><view class="tiny">添加复查照片</view></view><text class="tiny">1 张</text></view>
<view class="action-grid"><button class="green-btn secondary-btn" bindtap="review">进行复查</button><button class="secondary-btn" bindtap="summary">就医摘要</button></view><view class="safe-note" style="margin-top:22rpx">可选择将本事件文字摘要发送给 AI</view></view>
