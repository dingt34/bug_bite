<view class="page" wx:if="{{event}}">
  <!-- 概要 -->
  <view class="banner" style="background: {{eventColor}};">
    <view class="banner-type">{{event.contactTypeName}}</view>
    <view class="banner-level">{{event.levelName}}</view>
  </view>

  <view class="card">
    <view class="meta-row"><text class="meta-label">发生时间</text><text class="meta-val">{{event.occurredAt}}</text></view>
    <view class="meta-row"><text class="meta-label">复查时间</text><text class="meta-val">{{event.nextReviewAt}}</text></view>
    <view class="meta-row" wx:if="{{event.summary}}"><text class="meta-label">情况摘要</text><text class="meta-val">{{event.summary}}</text></view>
  </view>

  <!-- 恢复时间线 -->
  <view class="card">
    <view class="card-title">恢复时间线</view>
    <view class="timeline">
      <view class="tl-item" wx:for="{{timeline}}" wx:key="time">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-time">{{item.time}}</view>
          <view class="tl-text">{{item.text}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 就医摘要 -->
  <view class="card">
    <view class="card-title">就医沟通摘要</view>
    <view class="summary-box">{{event.summary || '暂无摘要'}}</view>
    <view class="copy-btn" bindtap="copySummary">复制摘要</view>
  </view>

  <!-- 更新症状 -->
  <view class="action">
    <button class="btn-primary" bindtap="updateSymptom">更新症状与复查</button>
  </view>
</view>
