.page {
  padding: 24rpx 0 60rpx;
}
.notice {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  border: 2rpx solid #CFE3D9;
  border-radius: 18rpx;
  background: var(--primary-light);
}
.notice-title {
  color: var(--primary);
  font-size: 29rpx;
  font-weight: 600;
}
.notice-text {
  margin-top: 8rpx;
  color: #58655F;
  font-size: 24rpx;
  line-height: 1.65;
}
.data-row {
  display: flex;
  justify-content: space-between;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #ECEEF0;
  color: #4B5359;
  font-size: 24rpx;
}
.data-row:last-child {
  border-bottom: none;
}
.boundary-item + .boundary-item {
  margin-top: 22rpx;
}
.boundary-title {
  color: #30363B;
  font-size: 26rpx;
  font-weight: 600;
}
.boundary-text {
  margin-top: 5rpx;
  color: #778087;
  font-size: 23rpx;
  line-height: 1.6;
}
.danger-zone {
  border: 2rpx solid #F1D1CF;
}
.danger-text {
  color: #777F85;
  font-size: 24rpx;
}
.clear-button {
  margin-top: 22rpx;
  border: 2rpx solid var(--danger);
  border-radius: 44rpx;
  background: #FFFFFF;
  color: var(--danger);
  font-size: 28rpx;
}
.clear-button::after {
  border: none;
}
.cleared-tip {
  margin-top: 16rpx;
  color: var(--primary);
  font-size: 23rpx;
}
.cloud-message {
  margin-top: 14rpx;
  color: #6D767D;
  font-size: 23rpx;
}
