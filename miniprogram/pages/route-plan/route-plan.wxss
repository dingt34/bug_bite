.page { padding-bottom: 50rpx; }
.form-card { position: relative; }
.form-tip { margin: 8rpx 0 24rpx; color: #7D8983; font-size: 24rpx; line-height: 1.55; }
.place-row { display: flex; align-items: center; }
.place-dot { flex: none; width: 16rpx; height: 16rpx; margin-right: 18rpx; border-radius: 50%; }
.start-dot { background: #2E7D5B; }
.end-dot { background: #E86F51; }
.place-field { flex: 1; padding: 14rpx 18rpx; background: #F7F8F9; border-radius: 12rpx; }
.field-label { color: #728078; font-size: 22rpx; }
.place-input { height: 48rpx; color: #26342D; font-size: 28rpx; }
.place-line { width: 2rpx; height: 22rpx; margin: 2rpx 0 2rpx 7rpx; background: #B8C8BF; }
.swap-button { margin: 18rpx 0 0; padding: 0; background: transparent; color: #2E7D5B; font-size: 24rpx; line-height: 1.8; text-align: right; }
.swap-button::after { border: 0; }
.mode-title { margin-top: 24rpx; color: #26342D; font-size: 27rpx; font-weight: 600; }
.mode-list { display: flex; margin-top: 14rpx; gap: 14rpx; }
.mode-item { flex: 1; padding: 16rpx 0; background: #F1F4F2; border: 2rpx solid transparent; border-radius: 10rpx; color: #657269; font-size: 25rpx; text-align: center; }
.mode-item.active { background: #EAF5EF; border-color: #2E7D5B; color: #2E7D5B; font-weight: 600; }
.plan-button, .confirm-button { margin-top: 24rpx; background: #2E7D5B; color: #FFFFFF; font-size: 28rpx; }
.plan-button[disabled] { background: #B7C7BE; color: #FFFFFF; }
.message { margin-top: 16rpx; color: #C44B35; font-size: 24rpx; line-height: 1.55; }
.message.success { color: #2E7D5B; }
.route-map { width: 100%; height: 500rpx; border-radius: 14rpx; overflow: hidden; }
.map-legend { margin: 14rpx 0; color: #718078; font-size: 22rpx; text-align: right; }
.legend-selected, .legend-other { display: inline-block; width: 30rpx; height: 6rpx; margin: 0 8rpx 4rpx 18rpx; border-radius: 3rpx; background: #2E7D5B; }
.legend-other { background: #9BCDB5; }
.route-option { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; padding: 18rpx; border: 2rpx solid #E2EAE5; border-radius: 12rpx; }
.route-option.selected { background: #F0F8F4; border-color: #2E7D5B; }
.route-name { color: #26342D; font-size: 27rpx; font-weight: 600; }
.route-meta { margin-top: 6rpx; color: #7B8881; font-size: 23rpx; }
.route-state { color: #2E7D5B; font-size: 24rpx; font-weight: 600; }
.route-notice { margin-top: 16rpx; color: #919B96; font-size: 21rpx; line-height: 1.5; }
