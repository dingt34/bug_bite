<view class="page">
  <view class="card form-card">
    <view class="card-title">规划本次出行路线</view>
    <view class="form-tip">可在出发前输入任意具体地点，路线结果用于完善行前计划。</view>

    <view class="place-block">
      <view class="place-row">
        <view class="place-dot start-dot"></view>
        <view class="place-field">
          <view class="field-label">起点</view>
          <input class="place-input" value="{{form.startName}}" placeholder="输入两个字即可选择地点" maxlength="40" bindinput="onStartInput" bindfocus="onPlaceFocus" bindblur="onPlaceBlur" data-key="startName" />
        </view>
      </view>
      <view class="suggest-panel" wx:if="{{activeSuggestKey === 'startName'}}">
        <view class="suggest-status" wx:if="{{suggestLoading}}">正在查找地点…</view>
        <view class="suggest-status" wx:elif="{{suggestMessage}}">{{suggestMessage}}</view>
        <view class="suggest-item" wx:for="{{suggestions}}" wx:key="id" catchtap="selectSuggestion" data-key="startName" data-index="{{index}}">
          <view class="suggest-title">{{item.title}}</view>
          <view class="suggest-address">{{item.city}}{{item.district}} · {{item.address}}</view>
        </view>
      </view>
    </view>
    <view class="place-line"></view>
    <view class="add-waypoint-row" wx:if="{{waypoints.length < 5}}" bindtap="addWaypoint">
      <view class="add-waypoint-icon">＋</view>
      <view>添加途经点（{{waypoints.length}} / 5）</view>
    </view>
    <block wx:for="{{waypoints}}" wx:key="id" wx:for-item="waypoint" wx:for-index="waypointIndex">
    <view class="place-block">
      <view class="place-row">
        <view class="place-dot waypoint-dot"></view>
        <view class="place-field">
          <view class="field-label">途经点 {{waypointIndex + 1}}</view>
          <view class="input-with-action">
            <input class="place-input waypoint-input" value="{{waypoint.name}}" placeholder="如：黄龙体育中心" maxlength="40" bindinput="onWaypointInput" bindfocus="onPlaceFocus" bindblur="onPlaceBlur" data-key="waypoint" data-index="{{waypointIndex}}" />
            <view class="clear-waypoint" catchtap="clearWaypoint" data-index="{{waypointIndex}}">移除</view>
          </view>
        </view>
      </view>
      <view class="suggest-panel" wx:if="{{activeSuggestKey === 'waypoint_' + waypointIndex}}">
        <view class="suggest-status" wx:if="{{suggestLoading}}">正在查找地点…</view>
        <view class="suggest-status" wx:elif="{{suggestMessage}}">{{suggestMessage}}</view>
        <view class="suggest-item" wx:for="{{suggestions}}" wx:for-item="suggestion" wx:for-index="suggestionIndex" wx:key="id" catchtap="selectSuggestion" data-key="waypoint_{{waypointIndex}}" data-index="{{suggestionIndex}}">
          <view class="suggest-title">{{suggestion.title}}</view>
          <view class="suggest-address">{{suggestion.city}}{{suggestion.district}} · {{suggestion.address}}</view>
        </view>
      </view>
    </view>
    <view class="place-line"></view>
    </block>
    <view class="place-block">
      <view class="place-row">
        <view class="place-dot end-dot"></view>
        <view class="place-field">
          <view class="field-label">终点</view>
          <input class="place-input" value="{{form.endName}}" placeholder="输入两个字即可选择地点" maxlength="40" bindinput="onEndInput" bindfocus="onPlaceFocus" bindblur="onPlaceBlur" data-key="endName" />
        </view>
      </view>
      <view class="suggest-panel" wx:if="{{activeSuggestKey === 'endName'}}">
        <view class="suggest-status" wx:if="{{suggestLoading}}">正在查找地点…</view>
        <view class="suggest-status" wx:elif="{{suggestMessage}}">{{suggestMessage}}</view>
        <view class="suggest-item" wx:for="{{suggestions}}" wx:key="id" catchtap="selectSuggestion" data-key="endName" data-index="{{index}}">
          <view class="suggest-title">{{item.title}}</view>
          <view class="suggest-address">{{item.city}}{{item.district}} · {{item.address}}</view>
        </view>
      </view>
    </view>
    <button class="swap-button" bindtap="swapPlaces">⇅ 交换起终点</button>

    <view class="mode-title">出行方式</view>
    <view class="mode-list">
      <view class="mode-item {{form.mode === item.key ? 'active' : ''}}" wx:for="{{modes}}" wx:key="key" bindtap="selectMode" data-mode="{{item.key}}">{{item.name}}</view>
    </view>
    <button class="plan-button" loading="{{loading}}" disabled="{{!form.startName || !form.endName || loading}}" bindtap="planRoute">{{loading ? '正在规划…' : '查看备选路线'}}</button>
    <view class="message {{routes.length ? 'success' : ''}}" wx:if="{{message}}">{{message}}</view>
  </view>

  <view class="card" wx:if="{{routes.length}}">
    <map id="routeMap" class="route-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="{{mapScale}}" polyline="{{polylines}}"></map>
    <view class="map-legend"><text class="legend-selected"></text>当前路线 <text class="legend-other"></text>其他路线</view>

    <view class="route-option {{selectedIndex === index ? 'selected' : ''}}" wx:for="{{routes}}" wx:key="id" bindtap="selectRoute" data-index="{{index}}">
      <view>
        <view class="route-name">{{item.name}}</view>
        <view class="route-meta">{{item.distanceText}} · {{item.durationText}}</view>
      </view>
      <view class="route-state">{{selectedIndex === index ? '已选择' : '选择'}}</view>
    </view>
    <button class="confirm-button" bindtap="confirmRoute">确认路线并返回行前准备</button>
    <button class="share-route-button" bindtap="shareRoute">保存并添加到经历分享</button>
    <view class="route-notice">最多可设置 5 个途经点；填写途经点后会优先展示完整途经路线，并保留直接路线用于比较。路线仅供行前规划参考。</view>
  </view>
</view>
