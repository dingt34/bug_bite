.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 16rpx 8rpx 24rpx;
}
.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.head-title {
  font-size: 34rpx;
  font-weight: 700;
}
.head-sub {
  margin-top: 6rpx;
  color: #737D85;
  font-size: 24rpx;
}
.safe-state {
  margin: 0 0 22rpx;
  padding: 15rpx 20rpx;
  border-radius: 14rpx;
  background: #EAF7F0;
  color: #2E7D5B;
  font-size: 23rpx;
  font-weight: 600;
}
.recommend-tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--primary-light);
  color: #456D5B;
  font-size: 22rpx;
  line-height: 1.5;
}

.type-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}
.type-card:active {
  border-color: var(--primary);
  background: var(--primary-light);
}
.type-recommended {
  border-color: var(--primary);
  background: #F4FAF7;
}
.type-selected {
  border-color: var(--primary);
  background: #F4FAF7;
  box-shadow: 0 8rpx 22rpx rgba(46, 125, 91, 0.10);
}
.recommend-badge {
  margin-right: 14rpx;
  padding: 5rpx 12rpx;
  border-radius: 16rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}
.type-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
}
.type-body {
  flex: 1;
}
.type-name {
  font-size: 32rpx;
  font-weight: 600;
}
.type-desc {
  font-size: 24rpx;
  color: #737D85;
  margin-top: 4rpx;
}
.type-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}
.submit-wrap {
  padding: 24rpx 0 0;
}
.draft-hint {
  margin-top: 14rpx;
  color: #8A9299;
  text-align: center;
  font-size: 22rpx;
}
