.contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:24rpx; }
.contact-card { min-height:220rpx; padding:28rpx; }
.contact-card.wide { grid-column:1/3; min-height:150rpx; }
.selected-card { outline:3rpx solid #2f7d5b; }
.contact-card .tiny { color:#69736e; line-height:1.65; }
.contact-card { min-width:0; }
.page .bottom-actions { background:#f7f7fb; padding-top:16rpx; }
.page .spacer { height:240rpx; }
.page .safe-note { color:#69736e; }
.page .safe-top { min-height:104rpx; }
.page button[disabled] { background:#e5e9e6; color:#747e78; }
