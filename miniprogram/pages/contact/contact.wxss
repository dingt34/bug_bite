.contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:24rpx; }
.contact-card { min-height:220rpx; padding:28rpx; }
.contact-card.wide { grid-column:1/3; min-height:200rpx; }
.selected-card { box-shadow:inset 0 0 0 3rpx #2f7d5b, 0 14rpx 40rpx rgba(31, 42, 37, .07); }
.contact-card .tiny { color:#69736e; line-height:1.65; }
.contact-card { min-width:0; }
.contact-question { font-size:52rpx; line-height:1.22; }
.unknown-card { position:relative; display:flex; align-items:center; padding-top:36rpx; padding-bottom:36rpx; }
.unknown-card-main { display:flex; align-items:center; min-width:0; padding-right:44rpx; }
.unknown-copy { flex:1; min-width:0; margin-left:22rpx; }
.unknown-copy .tiny { margin-top:6rpx; }
.unknown-selected { position:absolute; top:28rpx; right:28rpx; }
.contact-footer { margin-top:60rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); }
.contact-footer .primary-btn { border:0; outline:0; box-shadow:none; -webkit-tap-highlight-color:transparent; }
.page .safe-note { color:#69736e; }
.contact-page .safe-top { min-height:16rpx; }
.contact-page .progress { margin-top:30rpx; }
.page button[disabled] { background:#e5e9e6; color:#747e78; }
