.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 16rpx 8rpx 24rpx;
}
.head-title {
  font-size: 34rpx;
  font-weight: 700;
}
.head-sub {
  margin-top: 6rpx;
  color: #737D85;
  font-size: 24rpx;
}

.type-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}
.type-card:active {
  border-color: var(--primary);
  background: var(--primary-light);
}
.type-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
}
.type-body {
  flex: 1;
}
.type-name {
  font-size: 32rpx;
  font-weight: 600;
}
.type-desc {
  font-size: 24rpx;
  color: #737D85;
  margin-top: 4rpx;
}
.type-arrow {
  font-size: 36rpx;
  color: #B7C0C7;
}
