.chat-page { height: 100vh; background: #F3F6F4; }
.message-list { height: calc(100vh - 112rpx); box-sizing: border-box; padding: 20rpx 24rpx; }
.privacy-tip { margin-bottom: 28rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #FFF8E1; color: #806719; font-size: 21rpx; text-align: center; }
.chat-state { padding: 220rpx 40rpx; color: var(--text-sub); text-align: center; }
.retry { width: 210rpx; margin-top: 24rpx; border-radius: 34rpx; background: var(--primary); color: #fff; font-size: 23rpx; }
.retry::after, .send-button::after { border: none; }
.empty { padding: 160rpx 30rpx; color: #9DA7A2; font-size: 24rpx; text-align: center; }
.message-row { display: flex; margin-bottom: 24rpx; }
.mine { justify-content: flex-end; }
.theirs { justify-content: flex-start; }
.bubble { max-width: 78%; padding: 18rpx 20rpx 12rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.035); }
.mine .bubble { background: #DFF1E8; }
.message-text { color: #2F3A35; font-size: 27rpx; line-height: 1.6; word-break: break-all; }
.message-time { margin-top: 8rpx; color: #9AA49F; font-size: 18rpx; text-align: right; }
.post-preview { display: flex; width: 500rpx; max-width: 100%; }
.post-thumb { width: 116rpx; height: 116rpx; margin-right: 16rpx; border-radius: 10rpx; background: #E8ECEA; }
.post-copy { flex: 1; min-width: 0; }
.post-label { color: var(--primary); font-size: 20rpx; font-weight: 600; }
.post-text { display: -webkit-box; margin-top: 4rpx; overflow: hidden; color: #38443E; font-size: 23rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.post-author { margin-top: 4rpx; color: #909A95; font-size: 18rpx; }
.bottom-space { height: 34rpx; }
.composer { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; min-height: 88rpx; padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.05); }
.composer-input { flex: 1; min-height: 64rpx; padding: 0 22rpx; border-radius: 34rpx; background: #F1F4F2; font-size: 25rpx; }
.send-button { min-width: 112rpx; margin-left: 12rpx; padding: 13rpx 18rpx; border-radius: 32rpx; background: var(--primary); color: #fff; font-size: 23rpx; line-height: 1.5; }
.send-button[disabled] { background: #B8CAC1; color: #fff; }
