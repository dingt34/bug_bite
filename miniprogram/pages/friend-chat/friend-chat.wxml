<view class="chat-page">
  <view class="chat-state" wx:if="{{loading && !messages.length}}">正在加载私信…</view>
  <view class="chat-state" wx:elif="{{loadError && !messages.length}}">
    <view>{{loadError}}</view>
    <button class="retry" bindtap="retryLoad">重新加载</button>
  </view>

  <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollIntoView}}" wx:else>
    <view class="privacy-tip">私信仅对你和好友可见，请勿发送身份证号、联系方式等敏感信息。</view>
    <view class="empty" wx:if="{{!messages.length}}">还没有私信，发送一句友善的问候吧</view>
    <view class="message-row {{item.mine ? 'mine' : 'theirs'}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <view class="bubble">
        <view class="message-text" wx:if="{{item.kind === 'text'}}">{{item.text}}</view>
        <view class="post-preview" wx:else bindtap="viewPost" data-id="{{item.postId}}">
          <image class="post-thumb" wx:if="{{item.postPreview.imageRef}}" src="{{item.postPreview.imageRef}}" mode="aspectFill" />
          <view class="post-copy">
            <view class="post-label">转发的社群帖子</view>
            <view class="post-text">{{item.postPreview.text}}</view>
            <view class="post-author">来自 {{item.postPreview.displayName}}</view>
          </view>
        </view>
        <view class="message-time">{{item.time}}</view>
      </view>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="composer">
    <input class="composer-input" maxlength="500" value="{{inputText}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" placeholder="发送私信" />
    <button class="send-button" disabled="{{sending || !inputText}}" bindtap="sendMessage">{{sending ? '发送中' : '发送'}}</button>
  </view>
</view>
