<view class="page guide-page">
  <view class="safe-top"></view>
  <view class="topbar"><view class="back" bindtap="back"><image class="figma-back" src="/assets/figma/all/s06-imgFrame.svg"/></view><view class="top-title"><view class="top-title-main">描述症状</view><view class="top-title-sub">第 3 步，共 4 步 · {{typeName}}</view></view><view class="top-action" bindtap="save">保存草稿</view></view>
  <view class="progress"><view class="progress-fill" style="width:75%"></view></view>
  <view class="danger-reminder" bindtap="emergency"><view class="danger-reminder-icon">!</view><view class="grow"><view class="danger-reminder-title">先确认危险信号</view><view class="danger-reminder-copy">如有呼吸困难、晕厥等情况，请立即求助。</view></view></view>
  <view class="h2 section-heading">现在主要有哪些表现？</view><view class="muted">可多选；没有症状也可以如实选择</view>
  <view class="symptom-grid"><view wx:for="{{options}}" wx:key="label" class="symptom-card {{item.selected?'active':''}} {{item.label==='暂无明显表现'?'plain-symptom':''}}" data-value="{{item.label}}" bindtap="toggle"><text>{{item.label}}</text></view></view>
  <view class="section-title occurrence-title"><text>大约什么时候发生？</text><text class="aside">单选</text></view>
  <picker class="time-picker" mode="selector" range="{{occurredAtOptions}}" value="{{occurredAtIndex}}" bindchange="setOccurredAt"><view class="time-picker-inner"><view><view class="time-picker-value">{{occurredAt || '不确定'}}</view><view class="tiny">点击滚动选择更接近的时间</view></view><text class="picker-arrow">⌄</text></view></picker>
  <view class="section-title"><text>当前受影响的部位</text><text class="aside">可多选</text></view>
  <view class="choice-grid body-part-grid"><view wx:for="{{bodyPartOptions}}" wx:key="label" class="choice {{item.selected?'active':''}}" data-value="{{item.label}}" bindtap="toggleBodyPart">{{item.label}}</view></view>
  <view class="section-title"><text>影响范围</text><text class="aside">单选</text></view>
  <view class="choice-grid range-grid"><view wx:for="{{ranges}}" wx:key="*this" class="choice {{range===item?'active':''}}" data-value="{{item}}" bindtap="setRange">{{item}}</view></view>
  <view class="section-title"><text>症状变化</text><text class="aside">与刚发生时相比</text></view>
  <view class="choice-grid trend-grid"><view wx:for="{{trends}}" wx:key="*this" class="choice {{trend===item?'active':''}} {{item==='逐渐加重'&&trend===item?'danger':''}}" data-value="{{item}}" bindtap="setTrend">{{item}}</view></view>
  <view class="section-title"><text>是否存在需要额外关注的情况？</text><text class="aside">可多选</text></view>
  <view class="attention-grid"><view wx:for="{{systemicOptions}}" wx:key="label" class="attention-choice {{item.selected?'active':''}}" data-value="{{item.label}}" bindtap="toggleSystemic">{{item.label}}</view></view>
  <view class="section-title"><text>对日常活动的影响</text><text class="aside">单选</text></view>
  <view class="choice-grid impact-grid"><view wx:for="{{dailyImpactOptions}}" wx:key="label" class="choice {{item.selected?'active':''}}" data-value="{{item.label}}" bindtap="setDailyImpact">{{item.label}}</view></view>
  <view wx:if="{{questions.length}}" class="required-contact-section">
    <view class="section-title"><text>{{typeName}}的接触情况</text><text class="aside required-aside">必填</text></view>
    <view wx:for="{{questions}}" wx:for-item="question" wx:key="key" class="required-question-card">
      <view class="required-question-title">{{question.title}}</view>
      <view class="choice-grid required-choice-grid"><view wx:for="{{question.options}}" wx:for-item="option" wx:key="value" class="choice {{option.selected?'active':''}}" data-key="{{question.key}}" data-value="{{option.value}}" bindtap="answer">{{option.value}}</view></view>
    </view>
  </view>
  <view class="supplement-head {{supplementOpen?'open':''}}" bindtap="toggleSupplement"><view class="grow"><view class="h3">补充观察线索与处理记录</view><view class="tiny">环境、虫体观察、处理措施和照片均为选填</view></view><view class="supplement-status">{{supplementDone}}/{{supplementTotal}} 项已完成<image class="supplement-arrow {{supplementOpen?'open':''}}" src="/assets/figma/all/s08-imgFrame2.svg" mode="aspectFit"/></view></view>
  <view wx:if="{{supplementOpen}}" class="card card-pad branch-card supplement-card">
    <view wx:for="{{extraQuestions}}" wx:for-item="question" wx:key="key" class="branch-question">
      <view class="question-label">{{question.title}}<text class="optional-label">选填</text></view>
      <view class="chip-row"><view wx:for="{{question.options}}" wx:for-item="option" wx:key="value" class="chip {{option.selected?'active':''}}" data-key="{{question.key}}" data-value="{{option.value}}" bindtap="answerExtra">{{option.value}}</view></view>
    </view>
  <view class="photo-card">
    <view class="row" bindtap="addPhoto"><image wx:if="{{photo}}" class="photo-thumb" src="{{photo}}" mode="aspectFill"/><image wx:else class="figma-icon md" src="/assets/figma/all/s06-imgFrame1.svg"/>
      <view class="grow photo-copy"><view>现场或皮肤照片</view><view class="tiny">选填，仅保存本机；不用于疾病诊断</view></view><text class="green-text">{{photoSaving?'保存中':photo?'更换':'添加'}}</text></view>
    <button wx:if="{{photo}}" class="text-button" bindtap="removePhoto">移除本次照片</button>
  </view></view>
  <view class="form-footer"><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="next">查看行动建议</button><view class="safe-note">{{saveStatus}}<text class="block-break"></text>照片未添加或保存失败，不影响继续</view></view>
</view>
