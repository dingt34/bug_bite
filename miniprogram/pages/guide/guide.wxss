.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 8rpx 8rpx 4rpx;
}
.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.head-title {
  color: #2B2F36;
  font-size: 34rpx;
  font-weight: 700;
}
.head-sub {
  margin-top: 6rpx;
  color: #737D85;
  font-size: 24rpx;
}
.save-draft {
  flex: none;
  padding: 8rpx 0 16rpx 16rpx;
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 600;
}
.danger-shortcut {
  margin: 16rpx 0 20rpx;
  padding: 16rpx 20rpx;
  border-left: 6rpx solid #E53935;
  border-radius: 12rpx;
  background: #FDECEA;
  color: #B83B36;
  font-size: 23rpx;
  line-height: 1.55;
}

.completion-card {
  margin: 18rpx 0 22rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #DCEAE3;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #737D85;
  font-size: 22rpx;
}
.completion-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.completion-count {
  color: var(--primary);
  font-weight: 600;
}
.completion-track {
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #E8EEEB;
}
.completion-value {
  height: 100%;
  border-radius: 8rpx;
  background: var(--primary);
  transition: width 0.2s ease;
}

.required {
  color: var(--danger);
}

.validation-banner {
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #F4B7B4;
  border-radius: 12rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
}

.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.upload-grid {
  display: flex;
  justify-content: space-between;
}

.question-card {
  margin-left: 0;
  margin-right: 0;
}
.question-meta {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.question-index {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}
.question-group {
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 600;
}
.question-help {
  margin: -8rpx 0 18rpx;
  color: #737D85;
  font-size: 23rpx;
  line-height: 1.5;
}
.action-help {
  margin: -4rpx 0 16rpx;
  color: #737D85;
  font-size: 23rpx;
  line-height: 1.55;
}
.upload-item {
  width: 48%;
}
.upload-label {
  min-height: 76rpx;
  color: #3C4349;
  font-size: 25rpx;
  font-weight: 600;
}
.upload {
  width: 100%;
  height: 230rpx;
  border: 2rpx dashed #C8D8D0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-placeholder {
  font-size: 23rpx;
  color: #8A9299;
  text-align: center;
  padding: 0 20rpx;
}
.upload-plus {
  color: var(--primary);
  font-size: 48rpx;
  line-height: 1.1;
}
.upload-help {
  margin-top: 10rpx;
  color: #8A9299;
  font-size: 21rpx;
  line-height: 1.45;
}
.preview {
  width: 100%;
  height: 100%;
}

.submit-wrap {
  padding: 20rpx 0 0;
}
.autosave-state {
  margin-top: 14rpx;
  color: #7E8B84;
  text-align: center;
  font-size: 22rpx;
}
