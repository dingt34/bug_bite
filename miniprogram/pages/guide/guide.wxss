.page {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  font-size: 28rpx;
  color: #5A616A;
  padding: 8rpx 8rpx 4rpx;
}

.required-note {
  padding: 0 8rpx 16rpx;
  font-size: 22rpx;
  color: #8A9299;
}

.required {
  color: var(--danger);
}

.validation-banner {
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #F4B7B4;
  border-radius: 12rpx;
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
}

.optional {
  font-size: 22rpx;
  color: #B7C0C7;
  margin-left: 8rpx;
  font-weight: 400;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.upload-grid {
  display: flex;
  justify-content: space-between;
}
.action-help {
  margin: -4rpx 0 16rpx;
  color: #737D85;
  font-size: 23rpx;
  line-height: 1.55;
}
.upload-item {
  width: 48%;
}
.upload-label {
  min-height: 76rpx;
  color: #3C4349;
  font-size: 25rpx;
  font-weight: 600;
}
.upload {
  width: 100%;
  height: 230rpx;
  border: 2rpx dashed #C8D8D0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.upload-placeholder {
  font-size: 23rpx;
  color: #8A9299;
  text-align: center;
  padding: 0 20rpx;
}
.upload-plus {
  color: var(--primary);
  font-size: 48rpx;
  line-height: 1.1;
}
.upload-help {
  margin-top: 10rpx;
  color: #8A9299;
  font-size: 21rpx;
  line-height: 1.45;
}
.preview {
  width: 100%;
  height: 100%;
}

.submit-wrap {
  padding: 20rpx 0 0;
}
