.tab-shell { position:fixed; z-index:999; left:0; right:0; bottom:0; height:112rpx; padding:20rpx 22rpx 0; display:flex; align-items:flex-start; justify-content:space-between; background:rgba(255,255,255,.97); border-radius:44rpx 44rpx 0 0; box-shadow:0 -8rpx 28rpx rgba(31,42,37,.06); }
.tab-item { width:120rpx; display:flex; flex-direction:column; align-items:center; color:#8c8f96; font-size:20rpx; }
.icon-wrap { width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; }
.tab-icon { width:40rpx; height:40rpx; opacity:.72; }
.tab-label { margin-top:5rpx; }
.selected { color:#1e2021; font-weight:700; }
.selected .tab-icon { opacity:1; }
.tab-center { margin-top:-30rpx; }
.center-disc { width:108rpx; height:108rpx; border-radius:50%; background:#2f875f; border:10rpx solid #f7f7fb; box-shadow:0 6rpx 16rpx rgba(47,135,95,.14); }
.tab-center .tab-icon { width:48rpx; height:48rpx; filter:none; }
.tab-center .tab-label { margin-top:2rpx; }
.safe-bottom { position:absolute; left:0; right:0; top:100%; height:env(safe-area-inset-bottom); background:#fff; }
.figma-community-tabs .center-disc { width:44rpx; height:44rpx; border:0; background:transparent; box-shadow:none; }
.figma-community-tabs .tab-center { margin-top:0; }
.figma-tab-marker { width:24rpx; height:24rpx; border:2rpx solid #1e2021; border-radius:50%; }
.figma-tab-active { background:#1e2021; }
