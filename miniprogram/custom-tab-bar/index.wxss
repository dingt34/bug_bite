.custom-tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  height: 104rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E7E9EC;
  box-shadow: 0 -4rpx 18rpx rgba(31, 63, 48, 0.06);
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tab-item-selected .tab-text {
  font-weight: 600;
}
