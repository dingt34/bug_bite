page {
  min-height: 100%;
  background: #f7f7fb;
  color: #1e2021;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, input, textarea, scroll-view, camera { box-sizing: border-box; }
.icon-svg { width: 40rpx; height: 40rpx; display: block; }
.icon-svg.small { width: 36rpx; height: 36rpx; }
.icon-svg.large { width: 48rpx; height: 48rpx; }
.figma-icon { width: 40rpx; height: 40rpx; display:block; flex:none; }
.figma-icon.sm { width: 28rpx; height: 28rpx; }
.figma-icon.md { width: 48rpx; height: 48rpx; }
.figma-icon.lg { width: 72rpx; height: 72rpx; }
.figma-icon.xl { width: 96rpx; height: 96rpx; }
.figma-back { width:40rpx; height:40rpx; display:block; }
.figma-menu { margin-left:auto; width:106rpx; height:56rpx; border-radius:28rpx; background:#fff; display:flex; align-items:center; justify-content:center; gap:14rpx; }
.figma-menu image { width:12rpx; height:12rpx; display:block; }
.figma-inline { display:inline-block; vertical-align:middle; margin-right:10rpx; }
.block-break { display: block; height: 0; }
button { padding: 0; margin: 0; line-height: normal; background: transparent; }
button::after { border: 0; }

.page { min-height: 100vh; padding: 40rpx 36rpx 52rpx; background: #f7f7fb; }
.page.with-tab { padding-bottom: 176rpx; }
.safe-top { height: env(safe-area-inset-top); min-height: 16rpx; }
.topbar { height: 96rpx; display: flex; align-items: center; position: relative; }
.back { width: 80rpx; height: 80rpx; border-radius: 50%; background: #fff; display:flex; align-items:center; justify-content:center; color:#174b38; font-size:48rpx; font-weight:300; }
.top-title { margin-left: 32rpx; }
.top-title-main { font-size: 44rpx; line-height: 1.1; font-weight: 700; letter-spacing: -1rpx; }
.top-title-sub { margin-top: 4rpx; color: #8c8f96; font-size: 22rpx; }
.top-action { margin-left:auto; color:#8c8f96; font-size:22rpx; }
.menu-pill { margin-left:auto; width:106rpx; height:56rpx; border-radius:28rpx; background:#fff; display:flex; align-items:center; justify-content:center; letter-spacing:8rpx; color:#174b38; font-weight:700; padding-left:8rpx; }

.h1 { font-size: 56rpx; line-height: 1.18; font-weight: 700; letter-spacing: -2rpx; }
.h2 { font-size: 40rpx; line-height: 1.25; font-weight: 700; }
.h3 { font-size: 34rpx; line-height: 1.3; font-weight: 700; }
.muted { color: #8c8f96; }
.tiny { color:#a4a7ad; font-size:22rpx; }
.danger-text { color:#ea4038; }
.green-text { color:#2f7d5b; }
.section-title { margin: 44rpx 0 20rpx; display:flex; align-items:center; justify-content:space-between; font-size:34rpx; font-weight:700; }
.section-title .aside { font-size:22rpx; font-weight:400; color:#a0a3a9; }

.card { background:#fff; border-radius:46rpx; box-shadow: 0 14rpx 40rpx rgba(31, 42, 37, .07); }
.card-pad { padding:32rpx; }
.row { display:flex; align-items:center; }
.between { display:flex; align-items:center; justify-content:space-between; }
.stack { display:flex; flex-direction:column; }
.gap-12 { gap:24rpx; }
.gap-8 { gap:16rpx; }
.grow { flex:1; min-width:0; }
.circle { flex:none; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.circle-green { background:#dceee4; color:#2f7d5b; }
.circle-amber { background:#fae7bc; color:#9e6d14; }
.circle-red { background:#f9d7d3; color:#ea4038; }

.primary-btn, .secondary-btn, .danger-btn {
  width:100%; height:100rpx; border-radius:50rpx; display:flex; align-items:center; justify-content:center;
  font-size:30rpx; font-weight:700;
}
.primary-btn { background:#1e2021; color:#fff; }
.green-btn { background:#2f875f; color:#fff; }
.secondary-btn { background:#fff; color:#1e2021; border:1rpx solid #e6e7e9; }
.danger-btn { background:#ea4038; color:#fff; }
.disabled-btn { background:#eceef1; color:#b6b8bd; }
.bottom-actions { position:fixed; left:36rpx; right:36rpx; bottom:calc(36rpx + env(safe-area-inset-bottom)); z-index:20; }

.field { height:104rpx; padding:0 30rpx; background:#fff; border-radius:34rpx; display:flex; align-items:center; box-shadow:0 10rpx 30rpx rgba(31,42,37,.06); }
.field-label { width:170rpx; color:#8c8f96; font-size:22rpx; }
.field-value { flex:1; font-size:30rpx; font-weight:600; }
.chevron { color:#6f7672; font-size:38rpx; }
.chip-row { display:flex; flex-wrap:wrap; gap:16rpx; }
.chip { min-height:68rpx; padding:0 30rpx; border-radius:34rpx; background:#f0f1f3; color:#8c8f96; display:flex; align-items:center; justify-content:center; font-size:24rpx; }
.chip.active { background:#e2eee6; color:#2f7d5b; border:2rpx solid #2f7d5b; }
.chip.danger-active { background:#fff0ee; color:#ea4038; border:2rpx solid #ea4038; }

.progress { height:10rpx; border-radius:5rpx; background:#e3e5df; overflow:hidden; }
.progress-fill { height:100%; border-radius:5rpx; background:#2f7d5b; }
.notice { padding:24rpx 28rpx; border-radius:28rpx; background:#fff; display:flex; align-items:center; gap:20rpx; box-shadow:0 10rpx 30rpx rgba(31,42,37,.05); }
.notice-red { color:#ea4038; }
.divider { height:1rpx; background:#eceef0; }
.spacer { height:160rpx; }
.ellipsis-1 { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.safe-note { text-align:center; color:#a4a7ad; font-size:20rpx; line-height:1.7; }
.figma-menu {
  display: none !important;
}