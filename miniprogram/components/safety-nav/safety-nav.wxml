<view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-row">
    <view class="home-action" bindtap="goHome" role="button" aria-label="返回{{returnLabel}}">
      <text class="home-arrow">‹</text>
      <text class="home-label">{{returnLabel}}</text>
    </view>
    <view class="nav-title">接触后安全判断</view>
    <view class="nav-placeholder"></view>
  </view>
</view>

<view class="safety-progress" aria-label="当前为第{{current}}步，共4步">
  <view
    wx:for="{{steps}}"
    wx:key="step"
    class="safety-step {{item.step < current ? 'step-done' : (item.step === current ? 'step-current' : 'step-future')}}"
    bindtap="onStepTap"
    data-step="{{item.step}}"
  >
    <view class="step-dot">{{item.step < current ? '✓' : item.step}}</view>
    <view class="step-name">{{item.name}}</view>
  </view>
</view>
